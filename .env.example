# Copier ce fichier en .env pour le développement local (jamais commité).
# En production (Vercel), ajouter les mêmes variables dans
# Project Settings → Environment Variables.

# Clé API Resend (obligatoire) : https://resend.com/api-keys
RESEND_API_KEY=

# Adresse d'expédition des emails du formulaire Booking. Nécessite un
# domaine vérifié dans Resend (https://resend.com/domains) pour pouvoir
# envoyer à de vrais clients — l'adresse par défaut onboarding@resend.dev
# ne peut envoyer qu'à l'adresse du compte Resend lui-même.
RESEND_FROM="Alexandre Berger <booking@alexandreberger.com>"

# Adresse qui reçoit la notification de chaque nouvelle demande de tournage.
# Optionnel : par défaut alexandrebrgr@gmail.com si absent.
BOOKING_NOTIFY_EMAIL=alexandrebrgr@gmail.com
