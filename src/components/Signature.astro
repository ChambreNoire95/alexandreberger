---
import { t, type Lang } from "../i18n";

interface Props {
  lang?: Lang;
}
const { lang = "fr" } = Astro.props;
const signatures = [1, 2, 3, 4].map((n) => t(lang, `signature.${n}`));
---

<div class="signature" id="sig" aria-label={signatures[0]}>
  {signatures.map((s, i) => (
    <span class="phrase" style={`position:absolute;left:0;right:0;top:50%;transform:translateY(-50%);opacity:${i === 0 ? 1 : 0};transition:opacity 800ms ease`}>{s}<span class="point" aria-hidden="true">.</span></span>
  ))}
</div>

<style>
  .signature { position:relative; width:100%; min-height:3rem; margin:0 0 5.5rem; }
  .phrase {
    font-weight:700; font-size:clamp(1.32rem, 3.12vw, 2.57rem);
    color:var(--blanc);
  }
  /* Point final rouge (rouge du logo), très gras, comme une ponctuation. */
  .point { color:var(--rouge); font-weight:900; }
  @media (max-width: 800px) {
    .phrase { font-size:1.9rem; }
  }
  /* Grand écran : le header (logo animé) est plus haut, on remonte le bloc de phrases. */
  @media (min-width: 801px) {
    .signature { margin-top:-3rem; }
  }
</style>

<script>
  let timer: ReturnType<typeof setTimeout> | undefined;
  let surLogo: ((e: Event) => void) | undefined;
  let surFigeLogo: ((e: Event) => void) | undefined;

  function setupSignature() {
    const phrases = document.querySelectorAll<HTMLElement>('#sig .phrase');
    if (timer) clearTimeout(timer);
    if (surLogo) window.removeEventListener('logo-formats:change', surLogo);
    if (surFigeLogo) window.removeEventListener('logo-formats:figer', surFigeLogo);
    surLogo = undefined;
    surFigeLogo = undefined;
    if (!phrases.length) return;

    const reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (phrases.length > 1 && !reduce) {
      let i = 0;
      // Prochaine phrase tirée au sort, jamais la même deux fois de suite
      // (évite le cycle 1-2-3-4 trop prévisible).
      const changer = () => {
        phrases[i].style.opacity = '0';
        let suivant = i;
        while (suivant === i) {
          suivant = Math.floor(Math.random() * phrases.length);
        }
        i = suivant;
        phrases[i].style.opacity = '1';
      };

      // Ancien rythme : délai variable de 3,5 à 6,5 s.
      const planifierSuivante = () => {
        timer = setTimeout(() => {
          changer();
          planifierSuivante();
        }, 3500 + Math.random() * 3000);
      };

      const logoQuiTourne = document.querySelector('[data-logo-formats]') && !document.documentElement.classList.contains('logo-fige');
      if (logoQuiTourne) {
        // Le logo animé du header est présent : la phrase change en même temps que son format…
        surLogo = changer;
        window.addEventListener('logo-formats:change', surLogo);
        // …sauf s'il est figé (écran d'accueil mobile) : la phrase reprend alors son rythme propre.
        surFigeLogo = () => {
          if (surLogo) window.removeEventListener('logo-formats:change', surLogo);
          surLogo = undefined;
          planifierSuivante();
        };
        window.addEventListener('logo-formats:figer', surFigeLogo);
      } else {
        planifierSuivante();
      }
    }
  }

  document.addEventListener('astro:page-load', setupSignature);
</script>
