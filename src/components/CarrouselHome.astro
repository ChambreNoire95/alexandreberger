---
import OptimizedImage from "./OptimizedImage.astro";

interface Item {
  href: string;
  src: string;
  alt: string;
  titre: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

{items.length > 0 && (
  <div class="carrousel-wrap">
    <ul class="carrousel" id="carrousel-home">
      {items.map((item, index) => (
        <li>
          <a href={item.href}>
            <OptimizedImage
              src={item.src}
              alt={item.alt}
              loading="eager"
              fetchpriority={index < 2 ? "high" : "auto"}
              sizes="(min-width: 801px) 265px, 62vw"
            />
            <div class="carrousel-degrade"></div>
            <div class="carrousel-texte">
              <span class="carrousel-titre">{item.titre}</span>
            </div>
          </a>
        </li>
      ))}
    </ul>
    <button type="button" class="carrousel-fleche carrousel-prev" aria-label="Précédent">←</button>
    <button type="button" class="carrousel-fleche carrousel-next" aria-label="Suivant">→</button>
  </div>
)}

<style>
  .carrousel-wrap {
    position:relative; width:100%; margin:0 0 3.5rem;
  }
  .carrousel {
    list-style:none; margin:0; padding:0;
    display:flex; gap:.6rem; overflow-x:auto;
    scroll-snap-type:x mandatory; scroll-behavior:smooth;
    -webkit-overflow-scrolling:touch;
    scrollbar-width:none;
  }
  .carrousel::-webkit-scrollbar { display:none; }
  .carrousel li {
    flex:0 0 auto; scroll-snap-align:start;
    width:62vw; max-width:260px;
  }
  .carrousel a {
    display:block; position:relative; text-decoration:none;
    aspect-ratio:3/4; border-radius:2px; overflow:hidden;
  }
  .carrousel :global(img) {
    position:absolute; inset:0; width:100%; height:100%; object-fit:cover; display:block;
  }
  .carrousel-degrade {
    position:absolute; inset:0;
    background:linear-gradient(to top, rgba(0,0,0,.9) 0%, rgba(0,0,0,.55) 32%, transparent 65%);
  }
  .carrousel-texte {
    position:absolute; left:0; right:0; bottom:30px;
    padding:0 1rem 1.1rem 10px;
    display:flex; flex-direction:column;
    text-align:left;
  }
  .carrousel-titre {
    font-weight:800; font-size:1.15rem; line-height:1.08;
    letter-spacing:-.01em; text-transform:uppercase; color:#fff;
    display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden;
  }
  .carrousel-fleche {
    display:none;
    position:absolute; top:50%; translate:0 -50%;
    width:2.5rem; height:2.5rem; align-items:center; justify-content:center;
    font-size:1rem; color:#fff; background:rgba(11,11,11,.6); cursor:pointer;
    border:1px solid rgba(255,255,255,.4); border-radius:50%;
    transition: background 140ms ease, color 140ms ease, border-color 140ms ease;
  }
  .carrousel-fleche:hover { background:#fff; color:#0b0b0b; border-color:#fff; }
  .carrousel-prev { left:.75rem; }
  .carrousel-next { right:.75rem; }

  @media (min-width: 801px) {
    .carrousel-wrap { margin-top:20px; margin-bottom:4.5rem; }
    .carrousel li { width:265px; max-width:265px; }
    .carrousel-titre { font-size:1.3rem; }
    .carrousel-fleche { display:flex; }
  }
</style>

<script>
  function setupCarrousel() {
    const wrap = document.querySelector<HTMLElement>('.carrousel-wrap');
    const track = document.getElementById('carrousel-home');
    if (!wrap || !track) return;

    const original = Array.from(track.children) as HTMLLIElement[];
    if (original.length === 0) return;

    // Défilement infini : on clone le jeu de visuels avant et après le
    // segment réel ([clones][réel][clones]), on démarre au milieu, puis on
    // repositionne le scroll sans transition dès qu'on entre dans une zone
    // clonée (indiscernable, puisque c'est une copie identique) — donne
    // l'illusion d'une boucle sans fin, au clic comme au glissement tactile.
    if (!track.dataset.boucleInfinie) {
      track.dataset.boucleInfinie = 'true';

      const cloner = (li: HTMLLIElement) => {
        const clone = li.cloneNode(true) as HTMLLIElement;
        clone.setAttribute('aria-hidden', 'true');
        clone.querySelectorAll('a').forEach((a) => a.setAttribute('tabindex', '-1'));
        return clone;
      };

      [...original].reverse().forEach((li) => track.prepend(cloner(li)));
      original.forEach((li) => track.append(cloner(li)));

      const largeurSegment = track.scrollWidth / 3;

      // scroll-behavior:smooth (CSS) s'applique à toute écriture de
      // scrollLeft, pas seulement aux scrollBy/scrollTo volontaires : sans
      // le désactiver le temps du saut, le repositionnement devient une
      // grande animation visible au lieu d'un saut instantané imperceptible.
      function sauter(delta: number) {
        track!.dataset.repositionnement = 'true';
        track!.style.scrollBehavior = 'auto';
        track!.scrollLeft += delta;
        requestAnimationFrame(() => {
          track!.style.scrollBehavior = '';
          delete track!.dataset.repositionnement;
        });
      }

      track.style.scrollBehavior = 'auto';
      track.scrollLeft = largeurSegment;
      requestAnimationFrame(() => { track.style.scrollBehavior = ''; });

      track.addEventListener('scroll', () => {
        if (track.dataset.repositionnement) return;
        if (track.scrollLeft <= 1) {
          sauter(largeurSegment);
        } else if (track.scrollLeft >= largeurSegment * 2 - 1) {
          sauter(-largeurSegment);
        }
      });
    }

    const item = track.querySelector('li');
    const pas = item ? item.getBoundingClientRect().width + 10 : 300;

    wrap.querySelector('.carrousel-prev')?.addEventListener('click', () => {
      track.scrollBy({ left: -pas, behavior: 'smooth' });
    });
    wrap.querySelector('.carrousel-next')?.addEventListener('click', () => {
      track.scrollBy({ left: pas, behavior: 'smooth' });
    });
  }

  document.addEventListener('astro:page-load', setupCarrousel);
</script>
