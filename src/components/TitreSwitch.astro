---
import { t, url, type Lang } from "../i18n";

interface Props {
  actif: "commandes" | "creations";
  lang?: Lang;
}
const { actif, lang = "fr" } = Astro.props;
---

<div class="titre-switch">
  {actif === "commandes" ? (
    <h1 class="titre-page">{t(lang, "commandes")}</h1>
  ) : (
    <a href={url(lang, "/")} class="titre-inactif">{t(lang, "commandes")}</a>
  )}
  <span class="separateur" aria-hidden="true"></span>
  {actif === "creations" ? (
    <h1 class="titre-page">{t(lang, "creations")}</h1>
  ) : (
    <a href={url(lang, "/creations")} class="titre-inactif">{t(lang, "creations")}</a>
  )}
</div>

<style>
  .titre-switch { display:flex; align-items:center; justify-content:center; gap:1rem; margin:0 0 3.5rem; }
  .titre-switch :global(.titre-page) { margin:0; }

  /* Desktop uniquement : sur mobile, seul le titre de la page active reste
     affiché, comme avant (cf. le mémo sur le périmètre desktop). */
  .separateur, .titre-inactif { display:none; }

  @media (min-width: 801px) {
    .separateur { display:block; width:1px; height:1.1em; background:rgba(var(--blanc-rgb),.3); }
    .titre-inactif {
      display:inline-block;
      font-family:'Archivo', 'Inter', sans-serif;
      font-size:1.3rem; letter-spacing:.22em; text-transform:uppercase;
      color:rgba(var(--blanc-rgb),.5); text-decoration:none; font-weight:400;
      transition:color 140ms ease;
    }
    .titre-inactif:hover { color:rgba(var(--blanc-rgb),.7); }
  }
</style>
