---
import { t, url, type Lang } from "../i18n";

interface Props {
  actif: "commandes" | "creations";
  lang?: Lang;
  /** Largeur maximale du contenu de la page (filtres, liste) : les deux titres s'alignent sur ses bords (desktop). */
  largeur?: string;
}
const { actif, lang = "fr", largeur = "1240px" } = Astro.props;
---

<div class="titre-switch" style={`--largeur-contenu:${largeur}`}>
  {actif === "commandes" ? (
    <h1 class="titre-page">{t(lang, "commandes")}</h1>
  ) : (
    <a href={url(lang, "/")} class="titre-inactif"><span class="fleche" aria-hidden="true">←</span> {t(lang, "commandes")}</a>
  )}
  {actif === "creations" ? (
    <h1 class="titre-page">{t(lang, "creations")}</h1>
  ) : (
    <a href={url(lang, "/creations")} class="titre-inactif">{t(lang, "creations")} <span class="fleche" aria-hidden="true">→</span></a>
  )}
</div>

<style>
  .titre-switch { display:flex; align-items:center; justify-content:center; gap:1rem; margin:0 0 3.5rem; }
  .titre-switch :global(.titre-page) { margin:0; }

  /* Desktop uniquement : sur mobile, seul le titre de la page active reste
     affiché, comme avant (cf. le mémo sur le périmètre desktop). */
  .titre-inactif { display:none; }

  /* Desktop : « Films de commande » calé à gauche, « Créations » calé à droite, dans la police des phrases du
     header (Signature.astro : Archivo gras, sans capitales forcées), à 35 % de leur taille, alignés sur les bords
     du contenu qui suit (--largeur-contenu). Le titre de la page est
     blanc ; l'autre est un lien grisé, blanc au survol, avec une flèche rouge qui pointe vers son côté. */
  @media (min-width: 801px) {
    .titre-switch { width:100%; max-width:var(--largeur-contenu); justify-content:space-between; align-items:baseline; gap:2rem; }
    .titre-switch :global(.titre-page), .titre-inactif {
      font-family:'Archivo', 'Inter', sans-serif; font-weight:700;
      font-size:clamp(.925rem, 2.185vw, 1.8rem); line-height:1.1;
      letter-spacing:normal; text-transform:none; white-space:nowrap;
    }
    .titre-switch :global(.titre-page) { color:var(--blanc); }
    .titre-inactif {
      display:inline-block; color:rgba(var(--blanc-rgb),.4); text-decoration:none;
      transition:color 140ms ease;
    }
    .titre-inactif:hover { color:var(--blanc); }
    .titre-inactif .fleche { font-family:'Inter', sans-serif; font-weight:400; }
  }
</style>
