---
import { t, type Lang } from "../i18n";

interface Props {
  lang?: Lang;
}
const { lang = "fr" } = Astro.props;
---

<!-- Texte de présentation : toute la largeur, entre le carrousel et la bascule Films de commande / Créations. -->
<section class="presentation" aria-label={t(lang, "presentation.aria")}>
  <p>{t(lang, "bandeau.presentation")}</p>
</section>

<style>
  .presentation {
    width:100%; margin:0 0 3.5rem; padding:2.75rem clamp(1.5rem, 4vw, 3rem);
    border-top:1px solid rgba(var(--blanc-rgb),.14); border-bottom:1px solid rgba(var(--blanc-rgb),.14);
  }
  .presentation p {
    margin:0 auto; max-width:60rem; text-align:center;
    font-family:var(--police-texte); font-weight:400; font-size:1.15rem; line-height:1.75; color:rgba(var(--blanc-rgb),.8);
  }
  @media (max-width: 800px) {
    .presentation { margin-bottom:2.5rem; padding:2rem 0; }
    .presentation p { font-size:1.05rem; }
  }
</style>
