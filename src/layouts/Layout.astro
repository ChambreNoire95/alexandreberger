---
import { ClientRouter } from "astro:transitions";
import { getCollection } from "astro:content";

interface Props {
  title: string;
  description: string;
  currentPath: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Chemin public de l'image de partage (og:image). Défaut : /og-default.jpg */
  image?: string;
}

const { title, description, currentPath, jsonLd, image } = Astro.props;
const imagePartage = new URL(image || "/og-default.jpg", Astro.site).toString();

// Fiche d'identité affichée sur toutes les pages (données structurées
// schema.org), en plus du JSON-LD spécifique à chaque contenu passé via
// la prop jsonLd.
const personneJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Alexandre Berger",
  jobTitle: "Réalisateur",
  description: "Réalisateur freelance basé en Île-de-France : documentaire, fiction et film de marque.",
  url: Astro.site?.toString(),
};
const blocsJsonLd = [personneJsonLd, ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];

const clients = [
  "Bon Marché Rive Gauche", "Petit Bateau", "Univers Sel", "Synology", "Université Paris Nanterre",
  "Pompiers 95", "SDIS Guadeloupe", "Ruush", "Agence Trafic", "Disney+", "Fiap Paris", "Burger King",
  "Cine Nominé", "Dessine l'Espoir", "The Ivory Fondation", "Polytech Montpellier", "Madame Arthur/Divan du monde",
  "AG2R La Mondiale", "SloSlo", "Concord Label Group", "Universal Music France", "Hachette", "Tonies",
  "La Semaine De La Critique", "Voilà Chef", "JoyVox", "UnisCité",
  "Sapari Productions", "Supermerci", "Webfleet",
  "PlayStation", "Team Vitality", "La Métropole du Grand Paris", "BeIn Sports",
  "Jule et Lily", "Cosmopolitan", "L'Equipe Explore", "Les Cahiers Pour Décider Et Agir",
  "Palinal", "Epikure Studio", "Progress Associés", "Adopt Parfums", "Pan Distribution", "Agropolis Fondation",
  "Le Syndicat du Cru Minervois", "TUI", "Mediaposte",
].sort((a, b) => a.localeCompare(b, "fr"));

const presentation = "Réalisateur freelance basé en Île-de-France, je fabrique principalement des films basés sur le réel. Seul, caméra à la main, ou avec une équipe de professionnels à mes côtés, je m'adapte à vos besoins pour mener à bien l'ensemble de vos projets de communication audiovisuelle et servir votre stratégie globale.";

const entreesCarnet = await getCollection("carnet", ({ data }) => !data.brouillon);
const derniereEntree = entreesCarnet.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())[0];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:image" content={imagePartage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imagePartage} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />
    <link rel="preload" href="/fonts/Archivo-wdth.woff2" as="font" type="font/woff2" crossorigin />
    {/* set:html évite le pipeline CSS d'Astro/Vite, qui supprime le préfixe
       -webkit- de text-size-adjust — or c'est le seul qui fonctionne
       réellement sur Safari iOS (sans lui, Safari grossit certains textes
       au passage en paysage). Inlinée ici (au lieu d'un fichier séparé)
       pour retirer un maillon de la chaîne de requêtes critique. */}
    <style set:html="html{-webkit-text-size-adjust:100%;text-size-adjust:100%}" />
    {blocsJsonLd.map((bloc) => (
      <script type="application/ld+json" set:html={JSON.stringify(bloc)} />
    ))}
    <ClientRouter />
  </head>
  <body>
    <header class="topbar" transition:persist>
      <a class="logo" href="/" aria-label="Retour à l'accueil">
        <span class="nom">Alexandre Berger</span>
        <span class="role">Réalisateur</span>
      </a>
      <div class="menu-wrap">
        <nav class="onglets-header" aria-label="Sections">
          <a href="/" data-nav aria-current={currentPath === "/" ? "page" : undefined}>Films</a>
        </nav>
        <a class="booking-btn" href="/booking" data-nav aria-current={currentPath === "/booking" ? "page" : undefined}>Booking</a>
        <button
          type="button"
          class="menu-toggle"
          id="menu-toggle"
          aria-expanded="false"
          aria-controls="menu-secondaire"
          aria-label="Ouvrir le menu"
        >
          <span aria-hidden="true"></span>
          <span aria-hidden="true"></span>
          <span aria-hidden="true"></span>
        </button>
        <nav id="menu-secondaire" class="menu-secondaire" aria-label="Menu secondaire" hidden>
          <a class="onglet-mobile" href="/" data-nav aria-current={currentPath === "/" ? "page" : undefined}>Films de commande</a>
          <a class="onglet-mobile" href="/creations" data-nav aria-current={currentPath === "/creations" ? "page" : undefined}>Créations</a>
          <a href="/carnet" data-nav data-nav-prefix aria-current={currentPath.startsWith("/carnet") ? "page" : undefined}>Carnet</a>
          <a href="/autour-du-monde" data-nav aria-current={currentPath === "/autour-du-monde" ? "page" : undefined}>Autour du monde</a>
          <a href="/a-propos" data-nav aria-current={currentPath === "/a-propos" ? "page" : undefined}>À propos</a>
        </nav>
      </div>
    </header>
    <script>
      import { scrollerVersTitre } from "../lib/positionTitre";

      // Clic sur « Films de commande » / « Créations » : la page suivante doit
      // s'afficher directement calée sur le titre (comme après un filtre), sans
      // repasser par le haut de page ni fondu. astro:after-swap a lieu après le
      // remplacement du DOM et la remise à zéro du scroll par Astro, mais avant
      // le premier affichage : le visiteur ne voit aucun saut.
      let versTitre = false;
      document.addEventListener("click", (event) => {
        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        versTitre = !!(event.target as HTMLElement).closest(".titre-switch a");
      });
      // La classe doit rester posée pendant toute l'animation de transition
      // (créée après le swap) : on ne la retire qu'au début de la navigation suivante.
      document.addEventListener("astro:before-preparation", () => {
        document.documentElement.classList.remove("sans-fondu");
      });
      document.addEventListener("astro:before-swap", (event) => {
        if (versTitre) event.newDocument.documentElement.classList.add("sans-fondu");
      });
      document.addEventListener("astro:after-swap", () => {
        if (versTitre) scrollerVersTitre();
      });
      document.addEventListener("astro:page-load", () => {
        versTitre = false;
      });

      const toggle = document.getElementById("menu-toggle");
      const menu = document.getElementById("menu-secondaire");

      if (toggle && menu) {
        toggle.addEventListener("click", () => {
          const isOpen = !menu.hidden;
          menu.hidden = isOpen;
          toggle.setAttribute("aria-expanded", String(!isOpen));
        });

        document.addEventListener("click", (event) => {
          if (menu.hidden) return;
          if (menu.contains(event.target) || toggle.contains(event.target)) return;
          menu.hidden = true;
          toggle.setAttribute("aria-expanded", "false");
        });

        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape" && !menu.hidden) {
            menu.hidden = true;
            toggle.setAttribute("aria-expanded", "false");
            toggle.focus();
          }
        });

        document.addEventListener("astro:after-swap", () => {
          menu.hidden = true;
          toggle.setAttribute("aria-expanded", "false");
        });
      }

      // Le header est transition:persist (son DOM n'est pas remplacé lors d'une
      // navigation côté client) : sans ça, les aria-current des liens du header
      // resteraient figés sur ceux calculés au premier chargement de la session.
      function majNavActive() {
        const chemin = location.pathname;
        document.querySelectorAll<HTMLAnchorElement>("a[data-nav]").forEach((a) => {
          const cible = new URL(a.href).pathname;
          const actif = a.hasAttribute("data-nav-prefix") ? chemin.startsWith(cible) : chemin === cible;
          if (actif) a.setAttribute("aria-current", "page");
          else a.removeAttribute("aria-current");
        });
      }
      document.addEventListener("astro:page-load", majNavActive);

      // Le bouton n'est pas transition:persist (il n'existe que sur "/" et
      // "/creations") : on le recherche à chaque page-load plutôt que de
      // garder une référence, pour survivre à son absence/réapparition au
      // fil de la navigation. Le listener de scroll, lui, ne s'attache
      // qu'une fois (ce script ne s'exécute qu'au premier chargement).
      function majVisibiliteRetourHaut() {
        const bouton = document.getElementById("retour-haut");
        if (bouton) bouton.classList.toggle("visible", window.scrollY > window.innerHeight * 0.6);
      }
      function setupRetourHaut() {
        document.getElementById("retour-haut")?.addEventListener("click", () => {
          window.scrollTo({ top: 0, behavior: "smooth" });
        });
        majVisibiliteRetourHaut();
      }
      document.addEventListener("astro:page-load", setupRetourHaut);
      document.addEventListener("scroll", majVisibiliteRetourHaut, { passive: true });
    </script>
    <main>
      <slot />
    </main>

    {(() => {
      // En génération statique, Astro produit l'URL avec un slash final pour
      // les pages en mode "directory" (ex. "/creations/"), contrairement au
      // serveur de dev qui sert "/creations" sans slash — on normalise avant
      // de comparer pour que le bouton s'affiche dans les deux cas.
      const chemin = Astro.url.pathname.replace(/\/$/, "") || "/";
      return chemin === "/" || chemin === "/creations";
    })() && (
      <button type="button" id="retour-haut" class="retour-haut" aria-label="Remonter en haut de page">
        <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
          <path fill="currentColor" d="M12 5l-7 7h4v7h6v-7h4z" />
        </svg>
      </button>
    )}

    {currentPath !== "/creations" && (
      <footer transition:persist>
        <p class="refs-titre">Ils m'ont fait confiance pour fabriquer leurs films</p>
        <ul class="refs refs-desktop">
          {clients.map((client) => (
            <li class="refs-item">{client}</li>
          ))}
        </ul>
        <p class="refs refs-mobile">{clients.join(" · ")}</p>
      </footer>
    )}

    <section class="bandeau" transition:persist>
      <div class="bandeau-texte">
        <p>{presentation}</p>
      </div>
      <div class="bandeau-carnet">
        {derniereEntree ? (
          <a class="carnet-apercu" href="/carnet">
            <span class="carnet-label">Dernière entrée du carnet</span>
            <span class="carnet-titre">{derniereEntree.data.titre}</span>
            <span class="carnet-date">{derniereEntree.data.date.toLocaleDateString("fr-FR", { year: "numeric", month: "long", day: "numeric" })}</span>
            {derniereEntree.data.extrait && <span class="carnet-extrait">{derniereEntree.data.extrait}</span>}
          </a>
        ) : (
          <p class="carnet-vide">De nouvelles entrées du carnet arrivent bientôt.</p>
        )}
      </div>
    </section>

    <div class="cloture" transition:persist>
      <p class="copyright">
        © Alexandre Berger, Réalisateur Freelance / {new Date().getFullYear()} - <a href="/mentions-legales">Mentions Légales</a>
      </p>
    </div>
  </body>
</html>

<style is:global>
  html.sans-fondu::view-transition-group(root),
  html.sans-fondu::view-transition-old(root),
  html.sans-fondu::view-transition-new(root) { animation: none; }

  /* Archivo auto-hébergée (public/fonts/) : un seul fichier de police variable couvre toutes les
     graisses (100 à 900) et les largeurs (62 à 125 %). Pas d'italique fourni : le navigateur
     incline la romaine si besoin (.prix-film). Inter n'est gardée que pour les flèches « → »,
     absentes d'Archivo (sinon le navigateur piocherait une flèche de police système). */
  @font-face {
    font-family: 'Archivo';
    font-style: normal;
    font-weight: 100 900;
    font-stretch: 62% 125%;
    font-display: swap;
    src: url('/fonts/Archivo-wdth.woff2') format('woff2');
  }
  @font-face {
    font-family: 'Inter';
    font-style: normal;
    font-weight: 300 800;
    font-display: swap;
    src: url('/fonts/Inter-normal.woff2') format('woff2');
    unicode-range: U+2190-21FF;
  }

  /* Fond noir pur (l'ancien dégradé était #050912 → #0b0b0b : il suffit de redonner deux valeurs différentes pour le retrouver). */
  :root { --fond-debut:#000; --fond-fin:#000; }
  /* Largeur d'Archivo (axe wdth, de 62 % à 125 % ; 100 % = largeur normale du fichier). Un seul réglage pour tout le site. */
  :root { --largeur-police:85%; }
  body, button, input, select, textarea { font-stretch: var(--largeur-police); }
  * { box-sizing:border-box; }
  html, body { margin:0; padding:0; }
  body {
    /* Dégradé limité au premier écran (header + carrousel) : au-delà,
       fond uni pour ne pas l'étirer sur toute la hauteur de la page. */
    background-color: var(--fond-fin);
    background-image: linear-gradient(180deg, var(--fond-debut) 0%, var(--fond-fin) 100%);
    background-repeat: no-repeat;
    background-size: 100% 50vh;
    color:#fff;
    font-family: 'Archivo', 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    -webkit-font-smoothing: antialiased;
    display:flex; flex-direction:column; min-height:100vh;
    padding: 2.5rem clamp(1.5rem, 4vw, 3rem) 0;
    text-align:center;
    overflow-x:hidden;
  }
  /* Présent pour le SEO/l'accessibilité (structure de titres) sans rien changer
     visuellement sur les pages dont le H1 ferait doublon avec un élément déjà stylé
     (signature animée, intro de liste...). */
  .sr-only {
    position:absolute; width:1px; height:1px; padding:0; margin:-1px;
    overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0;
  }
  .topbar { position:relative; text-align:left; }
  .logo { display:inline-block; text-decoration:none; transition:opacity 140ms ease; }
  .logo:hover { opacity:.7; }
  .topbar .nom { font-size:1.0rem; font-weight:400; letter-spacing:.22em; text-transform:uppercase; color:rgba(255,255,255,.85); }
  .topbar .role { display:block; margin-top:.4rem; font-size:.65rem; font-weight:400; letter-spacing:.2em; text-transform:uppercase; color:rgba(255,255,255,.5); }
  .menu-wrap { position:absolute; top:0; right:0; display:flex; flex-wrap:wrap; align-items:center; justify-content:flex-end; gap:1rem 1.5rem; text-align:left; }
  .booking-btn {
    display:flex; align-items:center; justify-content:center;
    height:2.25rem; padding:0 .9rem;
    font-family:'Archivo', 'Inter', sans-serif; font-weight:200;
    font-size:.7rem; letter-spacing:.15em; text-transform:uppercase;
    color:#fff; text-decoration:none; white-space:nowrap;
    border:1px solid rgba(255,255,255,.5); border-radius:2px;
    transition: background 140ms ease, color 140ms ease, border-color 140ms ease;
  }
  .booking-btn:hover { background:#fff; color:#0b0b0b; border-color:#fff; }
  .menu-toggle {
    display:flex; flex-direction:column; align-items:center; justify-content:center; gap:4px;
    width:2.25rem; height:2.25rem; padding:0;
    background:transparent; border:1px solid rgba(255,255,255,.5); border-radius:2px;
    cursor:pointer; transition: background 140ms ease, border-color 140ms ease;
  }
  .menu-toggle span { display:block; width:14px; height:1px; background:#fff; transition: background 140ms ease; }
  .menu-toggle:hover { background:#fff; border-color:#fff; }
  .menu-toggle:hover span { background:#0b0b0b; }
  .youtube-link {
    display:flex; align-items:center; justify-content:center;
    width:2.25rem; height:2.25rem; color:#fff;
    background:transparent; border:1px solid rgba(255,255,255,.5); border-radius:2px;
    transition: background 140ms ease, border-color 140ms ease, color 140ms ease;
  }
  .youtube-link:hover { background:#fff; border-color:#fff; color:#0b0b0b; }
  .menu-secondaire {
    position:absolute; top:calc(100% + .6rem); right:0; z-index:10;
    display:flex; flex-direction:column; align-items:flex-end; gap:.9rem;
    min-width:160px; background:#0b0b0b; border:1px solid rgba(255,255,255,.14); padding:1.25rem 1.5rem;
  }
  .menu-secondaire[hidden] { display:none; }
  .menu-secondaire a {
    font-family:'Archivo', 'Inter', sans-serif; font-weight:200;
    font-size:.75rem; letter-spacing:.18em; text-transform:uppercase;
    color:rgba(255,255,255,.9); text-decoration:none; transition:color 140ms ease;
  }
  .menu-secondaire a:hover { color:#fff; }
  .menu-secondaire a[aria-current="page"] { color:#fff; text-decoration:underline; text-underline-offset:6px; text-decoration-thickness:1px; }
  .onglets-header { display:flex; flex-wrap:wrap; align-items:center; gap:1.25rem; }
  .onglets-header a {
    font-family:'Archivo', 'Inter', sans-serif; font-weight:200;
    font-size:.8rem; letter-spacing:.16em; text-transform:uppercase;
    color:rgba(255,255,255,.9); text-decoration:none; transition:color 140ms ease;
    white-space:nowrap;
  }
  .onglets-header a:hover { color:#fff; }
  .onglets-header a[aria-current="page"] { color:#fff; text-decoration:underline; text-underline-offset:6px; text-decoration-thickness:1px; }
  .onglet-mobile { display:none; }
  main { flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center; padding:7rem 0 2rem; }
  .titre-page {
    font-family:'Archivo', 'Inter', sans-serif;
    font-size:1.3rem; letter-spacing:.22em; text-transform:uppercase;
    color:#fff; font-weight:400; margin:0 0 3.5rem; text-align:center;
  }
  .retour-haut {
    position:fixed; right:1.25rem; bottom:1.25rem; z-index:20;
    width:2.5rem; height:2.5rem; display:flex; align-items:center; justify-content:center;
    background:rgba(11,11,11,.7); color:#fff; border:1px solid rgba(255,255,255,.4); border-radius:50%;
    cursor:pointer; opacity:0; translate:0 .5rem; pointer-events:none;
    transition: opacity 200ms ease, translate 200ms ease, background 140ms ease, color 140ms ease, border-color 140ms ease;
  }
  .retour-haut.visible { opacity:1; translate:0 0; pointer-events:auto; }
  .retour-haut:hover { background:#fff; color:#0b0b0b; border-color:#fff; }
  footer { border-top:1px solid rgba(255,255,255,.14); padding-top:3rem; margin-top:3rem; }
  .refs-titre { font-size:.7rem; font-weight:400; letter-spacing:.2em; text-transform:uppercase; color:rgba(255,255,255,.5); margin:0 0 1.25rem; }
  .refs { font-size:.9rem; font-weight:300; line-height:1.8; color:rgba(255,255,255,.65); margin:0; }
  .refs-desktop {
    display:flex; flex-wrap:wrap; justify-content:center;
    list-style:none; padding:0; max-width:900px; margin:0 auto;
  }
  .refs-item::after { content:"·"; margin:0 .55em; color:rgba(255,255,255,.3); }
  .refs-item:last-child::after { content:none; }
  .refs-mobile { display:none; }

  .bandeau {
    margin-top:3rem;
    display:flex; min-height:22rem;
    border-top:1px solid rgba(255,255,255,.14);
  }
  .bandeau-texte, .bandeau-carnet {
    flex:1 1 50%; display:flex; flex-direction:column; justify-content:center;
    padding:3rem clamp(1.5rem, 4vw, 3rem);
    text-align:left;
  }
  .bandeau-texte { border-right:1px solid rgba(255,255,255,.14); align-items:center; }
  .bandeau-texte p { font-weight:300; font-size:1.05rem; line-height:1.7; color:rgba(255,255,255,.8); margin:0; max-width:30rem; text-align:center; }
  .bandeau-carnet { align-items:center; text-align:center; }
  .carnet-apercu { display:flex; flex-direction:column; align-items:center; gap:.6rem; max-width:30rem; text-decoration:none; transition:opacity 140ms ease; }
  .carnet-apercu:hover { opacity:.7; }
  .carnet-label { font-family:'Archivo', 'Inter', sans-serif; font-weight:200; font-size:.65rem; letter-spacing:.18em; text-transform:uppercase; color:rgba(255,255,255,.45); }
  .carnet-titre { font-weight:300; font-size:clamp(1.3rem, 2.2vw, 1.7rem); color:#fff; }
  .carnet-date { font-family:'Archivo', 'Inter', sans-serif; font-weight:200; font-size:.7rem; letter-spacing:.12em; text-transform:uppercase; color:rgba(255,255,255,.45); }
  .carnet-extrait { font-weight:300; font-size:.95rem; color:rgba(255,255,255,.65); }
  .carnet-vide { font-weight:300; font-size:.95rem; color:rgba(255,255,255,.5); margin:0; max-width:30rem; }

  .cloture { border-top:1px solid rgba(255,255,255,.14); padding-top:3rem; margin-top:0; }
  .copyright { font-size:.825rem; font-weight:300; color:rgba(255,255,255,.4); padding:0 clamp(1.5rem, 4vw, 3rem) 3rem; margin:0; text-align:center; }
  .copyright a { color:rgba(255,255,255,.55); text-decoration:underline; text-underline-offset:3px; transition:color 140ms ease; }
  .copyright a:hover { color:#fff; }

  @media (max-width: 720px) {
    .bandeau { flex-direction:column; min-height:0; }
    .bandeau-texte { border-right:none; }
    /* Le bloc "dernière entrée du carnet" passe avant le texte de présentation
       en mobile (ordre visuel seulement, le DOM ne change pas) : le trait qui
       séparait les deux blocs le suit. */
    .bandeau-carnet { order:-1; border-bottom:1px solid rgba(255,255,255,.14); }
  }

  @media (min-width: 801px) {
    .copyright { color:#fff; font-size:.9075rem; }
  }

  @media (max-width: 800px) {
    /* Seuil à 800px et non 600px : le groupe booking+menu+onglets est déjà
       trop large pour tenir à côté du nom sans le chevaucher dès qu'on
       repasse sous ~750px (ex. un iPhone en paysage, ~660-810px selon le
       modèle). Il passe donc sur sa propre ligne. Le header s'étire jusqu'aux
       phrases qui tournent, et des marges auto centrent verticalement le
       groupe booking+menu dans cet espace, entre le logo et les phrases. */
    .topbar { display:flex; flex-direction:column; align-items:center; text-align:center; min-height:11rem; }
    /* position:relative (et non static) : le menu déroulant s'ancre à ce
       bloc plutôt qu'au topbar (devenu haut pour le centrage ci-dessus),
       sinon il s'affiche beaucoup trop bas. */
