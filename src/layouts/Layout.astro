---
import { ClientRouter } from "astro:transitions";
import { getCollection } from "astro:content";

interface Props {
  title: string;
  description: string;
  currentPath: string;
}

const { title, description, currentPath } = Astro.props;

const clients = [
  "Bon Marché Rive Gauche", "Petit Bateau", "Univers Sel", "Synology", "Université Paris Nanterre",
  "Pompiers 95", "SDIS Guadeloupe", "Ruush", "Agence Trafic", "Disney+", "Fiap Paris", "Burger King",
  "Cine Nominé", "Dessine l'Espoir", "The Ivory Fondation", "Polytech Montpellier", "Madame Arthur/Divan du monde",
  "AG2R La Mondiale", "SloSlo", "Concord Label Group", "Universal Music France", "Hachette", "Tonies",
  "La Semaine De La Critique", "Voilà Chef", "JoyVox", "UnisCité",
  "Sapari Productions", "Supermerci", "Webfleet",
  "PlayStation", "Team Vitality", "La Métropole du Grand Paris", "BeIn Sports",
  "Jule et Lily", "Cosmopolitan", "L'Equipe Explore", "Les Cahiers Pour Décider Et Agir",
  "Palinal", "Epikure Studio", "Progress Associés", "Adopt", "Pan Distribution", "Agropolis Fondation",
].sort((a, b) => a.localeCompare(b, "fr"));

// Vise ~10 clients par ligne, mais répartit le total à l'exact plutôt que de
// couper en blocs fixes de 10 : évite une ligne clairsemée en bout de bloc
// et donne un ensemble de lignes visuellement plus équilibré.
const CIBLE_PAR_LIGNE = 10;
function repartirEnLignes(items: string[]): string[][] {
  const nbLignes = Math.max(1, Math.round(items.length / CIBLE_PAR_LIGNE));
  const tailleBase = Math.floor(items.length / nbLignes);
  const enPlus = items.length % nbLignes;
  const lignes: string[][] = [];
  let curseur = 0;
  for (let i = 0; i < nbLignes; i++) {
    const taille = tailleBase + (i < enPlus ? 1 : 0);
    lignes.push(items.slice(curseur, curseur + taille));
    curseur += taille;
  }
  return lignes;
}

// Noms qui doivent toujours commencer une nouvelle ligne. On découpe la liste
// en segments à ces points-là, puis on rééquilibre chaque segment séparément
// (plutôt que de forcer le saut et laisser le déséquilibre se répercuter
// jusqu'à la fin de la liste).
const SAUTS_DE_LIGNE_FORCES = new Set(["Palinal"]);
const segments: string[][] = [[]];
for (const client of clients) {
  if (SAUTS_DE_LIGNE_FORCES.has(client) && segments[segments.length - 1].length > 0) {
    segments.push([]);
  }
  segments[segments.length - 1].push(client);
}
const lignesClients = segments.flatMap(repartirEnLignes);

const presentation = "Réalisateur freelance basé en Île-de-France, je raconte des histoires en documentaire, fiction et film de marque — de la commande institutionnelle aux projets tournés aux quatre coins du monde.";

const entreesCarnet = await getCollection("carnet", ({ data }) => !data.brouillon);
const derniereEntree = entreesCarnet.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())[0];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,300;0,400;0,500;0,700;1,300&display=swap" rel="stylesheet" />
    <ClientRouter />
  </head>
  <body>
    <header class="topbar" transition:persist>
      <a class="logo" href="/" aria-label="Retour à l'accueil">
        <span class="nom">Alexandre Berger</span>
        <span class="role">Réalisateur</span>
      </a>
      <div class="menu-wrap">
        <a class="booking-btn" href="/booking" aria-current={currentPath === "/booking" ? "page" : undefined}>Booking</a>
        <button
          type="button"
          class="menu-toggle"
          id="menu-toggle"
          aria-expanded="false"
          aria-controls="menu-secondaire"
          aria-label="Ouvrir le menu"
        >
          <span aria-hidden="true"></span>
          <span aria-hidden="true"></span>
          <span aria-hidden="true"></span>
        </button>
        <nav id="menu-secondaire" class="menu-secondaire" aria-label="Menu secondaire" hidden>
          <a href="/carnet" aria-current={currentPath.startsWith("/carnet") ? "page" : undefined}>Carnet</a>
          <a href="/a-propos" aria-current={currentPath === "/a-propos" ? "page" : undefined}>À propos</a>
        </nav>
      </div>
    </header>
    <script>
      const toggle = document.getElementById("menu-toggle");
      const menu = document.getElementById("menu-secondaire");

      if (toggle && menu) {
        toggle.addEventListener("click", () => {
          const isOpen = !menu.hidden;
          menu.hidden = isOpen;
          toggle.setAttribute("aria-expanded", String(!isOpen));
        });

        document.addEventListener("click", (event) => {
          if (menu.hidden) return;
          if (menu.contains(event.target) || toggle.contains(event.target)) return;
          menu.hidden = true;
          toggle.setAttribute("aria-expanded", "false");
        });

        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape" && !menu.hidden) {
            menu.hidden = true;
            toggle.setAttribute("aria-expanded", "false");
            toggle.focus();
          }
        });

        document.addEventListener("astro:after-swap", () => {
          menu.hidden = true;
          toggle.setAttribute("aria-expanded", "false");
        });
      }
    </script>
    <main>
      <slot name="above-nav" />
      <nav class="onglets" aria-label="Sections">
        <a href="/" aria-current={currentPath === "/" ? "page" : undefined}>Commandes</a>
        <a href="/creations" aria-current={currentPath === "/creations" ? "page" : undefined}>Créations</a>
        <a href="/autour-du-monde" aria-current={currentPath === "/autour-du-monde" ? "page" : undefined}>Autour du monde</a>
      </nav>
      <slot />
    </main>

    {currentPath !== "/creations" && (
      <footer transition:persist>
        <p class="refs-titre">Ils m'ont fait confiance pour fabriquer leurs films</p>
        {lignesClients.map((ligne) => (
          <p class="refs">{ligne.join(" · ")}</p>
        ))}
      </footer>
    )}

    <section class="bandeau" transition:persist>
      <div class="bandeau-texte">
        <p>{presentation}</p>
      </div>
      <div class="bandeau-carnet">
        {derniereEntree ? (
          <a class="carnet-apercu" href="/carnet">
            <span class="carnet-label">Dernière entrée du carnet</span>
            <span class="carnet-titre">{derniereEntree.data.titre}</span>
            <span class="carnet-date">{derniereEntree.data.date.toLocaleDateString("fr-FR", { year: "numeric", month: "long", day: "numeric" })}</span>
            {derniereEntree.data.extrait && <span class="carnet-extrait">{derniereEntree.data.extrait}</span>}
          </a>
        ) : (
          <p class="carnet-vide">De nouvelles entrées du carnet arrivent bientôt.</p>
        )}
      </div>
    </section>

    <div class="cloture" transition:persist>
      <p class="copyright">
        © Alexandre Berger, Réalisateur Freelance / {new Date().getFullYear()} - <a href="/mentions-legales">Mentions Légales</a>
      </p>
    </div>
  </body>
</html>

<style is:global>
  :root { --fond:#0b0b0b; }
  * { box-sizing:border-box; }
  html, body { margin:0; padding:0; }
  body {
    background: var(--fond); color:#fff;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    -webkit-font-smoothing: antialiased;
    display:flex; flex-direction:column; min-height:100vh;
    padding: 2.5rem clamp(1.5rem, 4vw, 3rem) 0;
    text-align:center;
    overflow-x:hidden;
  }
  /* Présent pour le SEO/l'accessibilité (structure de titres) sans rien changer
     visuellement sur les pages dont le H1 ferait doublon avec un élément déjà stylé
     (signature animée, intro de liste...). */
  .sr-only {
    position:absolute; width:1px; height:1px; padding:0; margin:-1px;
    overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0;
  }
  .topbar { position:relative; text-align:left; }
  .logo { display:inline-block; text-decoration:none; transition:opacity 140ms ease; }
  .logo:hover { opacity:.7; }
  .topbar .nom { font-size:1.0rem; font-weight:400; letter-spacing:.22em; text-transform:uppercase; color:rgba(255,255,255,.85); }
  .topbar .role { display:block; margin-top:.4rem; font-size:.65rem; font-weight:400; letter-spacing:.2em; text-transform:uppercase; color:rgba(255,255,255,.5); }
  .menu-wrap { position:absolute; top:0; right:0; display:flex; align-items:center; gap:.5rem; text-align:left; }
  .booking-btn {
    display:flex; align-items:center; justify-content:center;
    height:2.25rem; padding:0 .9rem;
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size:.7rem; letter-spacing:.15em; text-transform:uppercase;
    color:#fff; text-decoration:none; white-space:nowrap;
    border:1px solid rgba(255,255,255,.5); border-radius:2px;
    transition: background 140ms ease, color 140ms ease, border-color 140ms ease;
  }
  .booking-btn:hover { background:#fff; color:#0b0b0b; border-color:#fff; }
  .menu-toggle {
    display:flex; flex-direction:column; align-items:center; justify-content:center; gap:4px;
    width:2.25rem; height:2.25rem; padding:0;
    background:transparent; border:1px solid rgba(255,255,255,.5); border-radius:2px;
    cursor:pointer; transition: background 140ms ease, border-color 140ms ease;
  }
  .menu-toggle span { display:block; width:14px; height:1px; background:#fff; transition: background 140ms ease; }
  .menu-toggle:hover { background:#fff; border-color:#fff; }
  .menu-toggle:hover span { background:#0b0b0b; }
  .menu-secondaire {
    position:absolute; top:calc(100% + .6rem); right:0; z-index:10;
    display:flex; flex-direction:column; align-items:flex-end; gap:.9rem;
    min-width:160px; background:#0b0b0b; border:1px solid rgba(255,255,255,.14); padding:1.25rem 1.5rem;
  }
  .menu-secondaire[hidden] { display:none; }
  .menu-secondaire a {
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size:.75rem; letter-spacing:.18em; text-transform:uppercase;
    color:rgba(255,255,255,.9); text-decoration:none; transition:color 140ms ease;
  }
  .menu-secondaire a:hover { color:#fff; }
  .menu-secondaire a[aria-current="page"] { color:#fff; text-decoration:underline; text-underline-offset:6px; text-decoration-thickness:1px; }
  main { flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center; padding:4rem 0; }
  .onglets { display:flex; flex-wrap:wrap; justify-content:center; gap:clamp(2rem, 6vw, 4.5rem); }
  .onglets a {
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size:.75rem; letter-spacing:.18em; text-transform:uppercase;
    color:rgba(255,255,255,.9); text-decoration:none; transition:color 140ms ease;
  }
  .onglets a:hover { color:#fff; }
  .onglets a[aria-current="page"] { color:#fff; text-decoration:underline; text-underline-offset:6px; text-decoration-thickness:1px; }
  footer { border-top:1px solid rgba(255,255,255,.14); padding-top:3rem; margin-top:3rem; }
  .refs-titre { font-size:.7rem; font-weight:400; letter-spacing:.2em; text-transform:uppercase; color:rgba(255,255,255,.5); margin:0 0 1.25rem; }
  .refs { font-size:.9rem; font-weight:300; line-height:1.8; color:rgba(255,255,255,.65); margin:0; }
  .refs + .refs { margin-top:.4rem; }

  .bandeau {
    margin-top:3rem;
    display:flex; min-height:22rem;
    border-top:1px solid rgba(255,255,255,.14);
  }
  .bandeau-texte, .bandeau-carnet {
    flex:1 1 50%; display:flex; flex-direction:column; justify-content:center;
    padding:3rem clamp(1.5rem, 4vw, 3rem);
    text-align:left;
  }
  .bandeau-texte { border-right:1px solid rgba(255,255,255,.14); align-items:center; }
  .bandeau-texte p { font-weight:300; font-size:1.05rem; line-height:1.7; color:rgba(255,255,255,.8); margin:0; max-width:30rem; text-align:center; }
  .bandeau-carnet { align-items:center; text-align:center; }
  .carnet-apercu { display:flex; flex-direction:column; align-items:center; gap:.6rem; max-width:30rem; text-decoration:none; transition:opacity 140ms ease; }
  .carnet-apercu:hover { opacity:.7; }
  .carnet-label { font-family: ui-monospace, "SF Mono", Menlo, monospace; font-size:.65rem; letter-spacing:.18em; text-transform:uppercase; color:rgba(255,255,255,.45); }
  .carnet-titre { font-weight:300; font-size:clamp(1.3rem, 2.2vw, 1.7rem); color:#fff; }
  .carnet-date { font-family: ui-monospace, "SF Mono", Menlo, monospace; font-size:.7rem; letter-spacing:.12em; text-transform:uppercase; color:rgba(255,255,255,.45); }
  .carnet-extrait { font-weight:300; font-size:.95rem; color:rgba(255,255,255,.65); }
  .carnet-vide { font-weight:300; font-size:.95rem; color:rgba(255,255,255,.5); margin:0; max-width:30rem; }

  .cloture { border-top:1px solid rgba(255,255,255,.14); padding-top:3rem; margin-top:0; }
  .copyright { font-size:.75rem; font-weight:300; color:rgba(255,255,255,.4); padding:0 clamp(1.5rem, 4vw, 3rem) 3rem; margin:0; text-align:center; }
  .copyright a { color:rgba(255,255,255,.55); text-decoration:underline; text-underline-offset:3px; transition:color 140ms ease; }
  .copyright a:hover { color:#fff; }

  @media (max-width: 720px) {
    .bandeau { flex-direction:column; min-height:0; }
    .bandeau-texte { border-right:none; border-bottom:1px solid rgba(255,255,255,.14); }
  }

  @media (max-width: 600px) {
    /* Le bouton Booking rend le groupe booking+menu trop large pour tenir
       à côté du nom sur mobile sans les superposer : il passe sur sa
       propre ligne, centrée, sous "Réalisateur". */
    .menu-wrap { position:static; width:100%; justify-content:center; margin-top:1rem; }
  }
</style>
