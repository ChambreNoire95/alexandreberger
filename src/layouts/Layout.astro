---
import { ClientRouter } from "astro:transitions";
import { getCollection } from "astro:content";
import LogoFormats from "../components/LogoFormats.astro";
import { url, sansLangue, autreLangue, t, dateFormatee, type Lang } from "../i18n";
import { getCarnet } from "../lib/contenu";
import logosClients from "../data/logos-clients.json";

interface Props {
  title: string;
  description: string;
  /** Chemin de la page SANS préfixe de langue (ex. "/creations") : sert à la navigation active. */
  currentPath: string;
  /** Langue de la page (français par défaut). */
  lang?: Lang;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Chemin public de l'image de partage (og:image). Défaut : /og-default.jpg */
  image?: string;
  /** Page non publiée / non référencée : ajoute <meta name="robots" content="noindex, nofollow">. */
  noindex?: boolean;
}

const { title, description, currentPath, jsonLd, image, noindex = false, lang = "fr" } = Astro.props;
const imagePartage = new URL(image || "/og-default.jpg", Astro.site).toString();

// Fiche d'identité affichée sur toutes les pages (données structurées
// schema.org), en plus du JSON-LD spécifique à chaque contenu passé via
// la prop jsonLd.
const personneJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Alexandre Berger",
  jobTitle: t(lang, "json.metier"),
  description: t(lang, "json.description"),
  url: Astro.site?.toString(),
};
const blocsJsonLd = [personneJsonLd, ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];

// Références (pied de page) : logos blancs générés par scripts/generer-logos.mjs (liste : scripts/logos/clients.json).
// L'ordre d'affichage est celui de clients.json : par notoriété décroissante (les marques les plus connues d'abord),
// pour servir de preuve lors du démarchage. Les références sans logo restent en texte, à la fin.
const clientsLogo = logosClients.filter((c) => c.logo);
const clientsTexte = logosClients.filter((c) => !c.logo);

// Grand écran : les logos sont répartis sur 5 lignes, dans l'ordre de notoriété (coupures choisies pour que la ligne la
// plus large soit la plus étroite possible, donc des lignes de largeur voisine). Les tailles des logos ne changent pas ;
// la plus large dépasse un peu du contenu, sur les côtés. En dessous de 1200 px, les lignes se fondent dans un seul
// bloc qui revient à la ligne naturellement (voir .refs-ligne en CSS).
const NB_LIGNES = 5;
const ECART_X = 2.9 * 16; // écart horizontal de référence entre deux logos (px)
const largeurLigne = (de: number, a: number) =>
  clientsLogo.slice(de, a).reduce((somme, c) => somme + c.largeur, 0) + Math.max(0, a - de - 1) * ECART_X;
const n = clientsLogo.length;
const meilleur: number[][] = Array.from({ length: NB_LIGNES + 1 }, () => Array(n + 1).fill(Infinity));
const coupure: number[][] = Array.from({ length: NB_LIGNES + 1 }, () => Array(n + 1).fill(0));
meilleur[0][0] = 0;
for (let r = 1; r <= NB_LIGNES; r++)
  for (let j = 1; j <= n; j++)
    for (let i = r - 1; i < j; i++) {
      const v = Math.max(meilleur[r - 1][i], largeurLigne(i, j));
      if (v < meilleur[r][j]) { meilleur[r][j] = v; coupure[r][j] = i; }
    }
const rangees: (typeof clientsLogo)[] = [];
for (let r = NB_LIGNES, j = n; r >= 1 && j > 0; r--) {
  const i = coupure[r][j];
  rangees.unshift(clientsLogo.slice(i, j));
  j = i;
}

// Même page dans l'autre langue (pour <link rel="alternate" hreflang> et le sélecteur FR | EN).
const cheminNormalise = sansLangue(Astro.url.pathname).replace(/\/$/, "") || "/";
const alternates = {
  fr: new URL(url("fr", cheminNormalise), Astro.site).toString(),
  en: new URL(url("en", cheminNormalise), Astro.site).toString(),
};
const urlCanonique = alternates[lang];

// Formulaire de contact du pied de page : textes lus par le script d'envoi.
const textesContact = {
  lang,
  envoyer: t(lang, "contact.envoyer"),
  envoi: t(lang, "booking.envoi"),
  ok: t(lang, "contact.ok"),
  erreur: t(lang, "booking.erreur"),
  erreurReseau: t(lang, "booking.erreur.reseau"),
};

const entreesCarnet = await getCarnet(lang, ({ data }) => !data.brouillon);
const derniereEntree = entreesCarnet.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())[0];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={urlCanonique} />
    <link rel="alternate" hreflang="fr" href={alternates.fr} />
    <link rel="alternate" hreflang="en" href={alternates.en} />
    <link rel="alternate" hreflang="x-default" href={alternates.fr} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === "en" ? "en_GB" : "fr_FR"} />
    <meta property="og:locale:alternate" content={lang === "en" ? "fr_FR" : "en_GB"} />
    <meta property="og:url" content={urlCanonique} />
    <meta property="og:image" content={imagePartage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imagePartage} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />
    <link rel="preload" href="/fonts/Archivo-wdth.woff2" as="font" type="font/woff2" crossorigin />
    {/* set:html évite le pipeline CSS d'Astro/Vite, qui supprime le préfixe
       -webkit- de text-size-adjust — or c'est le seul qui fonctionne
       réellement sur Safari iOS (sans lui, Safari grossit certains textes
       au passage en paysage). Inlinée ici (au lieu d'un fichier séparé)
       pour retirer un maillon de la chaîne de requêtes critique. */}
    <style set:html="html{-webkit-text-size-adjust:100%;text-size-adjust:100%}" />
    {blocsJsonLd.map((bloc) => (
      <script type="application/ld+json" set:html={JSON.stringify(bloc)} />
    ))}
    {/* Mobile : pas d'écran d'accueil, on arrive directement sur la page. Le logo de l'en-tête y est toujours figé sur
       « 2.39 SCOPE » (index 3 : voir LogoFormats.astro), sans cadre ni compteur. Posé ici, avant le premier affichage,
       pour éviter tout flash. */}
    <script is:inline>
      (function () {
        try {
          if (!matchMedia("(max-width: 800px)").matches) return;
          if (sessionStorage.getItem("logo-fige-index") === null) sessionStorage.setItem("logo-fige-index", "3");
          document.documentElement.classList.add("logo-fige");
        } catch (e) {}
      })();
    </script>
    <ClientRouter />
  </head>
  <body>
    <header class="topbar" transition:persist>
      <LogoFormats echelle={0.268125} intervalle={3420} href={url(lang, "/")} lang={lang} />
      <div class="menu-wrap">
        <div class="barre">
          <nav class="onglets-header" aria-label={t(lang, "menu.sections")}>
            <a href={url(lang, "/")} data-nav aria-current={currentPath === "/" ? "page" : undefined}>{t(lang, "nav.films")}</a>
          </nav>
          {/* Changement de langue = rechargement complet (data-astro-reload) : l'en-tête est persistant
              (transition:persist) et garderait sinon les textes de l'ancienne langue. Le bouton affiche la langue
              vers laquelle on bascule. */}
          <a class="langue-btn" href={url(autreLangue(lang), cheminNormalise)} lang={autreLangue(lang)} hreflang={autreLangue(lang)} data-astro-reload data-langue={autreLangue(lang)} aria-label={t(lang, autreLangue(lang) === "en" ? "langue.en" : "langue.fr")}>{autreLangue(lang).toUpperCase()}</a>
          <button
            type="button"
            class="menu-toggle"
            id="menu-toggle"
            aria-expanded="false"
            aria-controls="menu-secondaire"
            aria-label={t(lang, "menu.ouvrir")}
          >
            <span aria-hidden="true"></span>
            <span aria-hidden="true"></span>
            <span aria-hidden="true"></span>
          </button>
          <nav id="menu-secondaire" class="menu-secondaire" aria-label={t(lang, "menu.secondaire")} hidden>
            <a class="onglet-mobile" href={url(lang, "/")} data-nav aria-current={currentPath === "/" ? "page" : undefined}>{t(lang, "menu.commandes")}</a>
            <a class="onglet-mobile" href={url(lang, "/creations")} data-nav aria-current={currentPath === "/creations" ? "page" : undefined}>{t(lang, "menu.creations")}</a>
            <a href={url(lang, "/carnet")} data-nav data-nav-prefix aria-current={currentPath.startsWith("/carnet") ? "page" : undefined}>{t(lang, "menu.carnet")}</a>
            <a href={url(lang, "/autour-du-monde")} data-nav aria-current={currentPath === "/autour-du-monde" ? "page" : undefined}>{t(lang, "menu.autour")}</a>
            <a href={url(lang, "/a-propos")} data-nav aria-current={currentPath === "/a-propos" ? "page" : undefined}>{t(lang, "menu.apropos")}</a>
          </nav>
        </div>
        <a class="booking-btn" href={url(lang, "/booking")} data-nav aria-current={currentPath === "/booking" ? "page" : undefined}>{t(lang, "nav.booking")}</a>
      </div>
    </header>
    <script>
      import { scrollerVersCarrousel } from "../lib/positionTitre";

      // Clic sur « Films de commande » / « Créations » : la page suivante doit
      // s'afficher directement au-dessus du carrousel (100 px de marge au-dessus de lui), sans
      // repasser par le haut de page ni fondu. astro:after-swap a lieu après le
      // remplacement du DOM et la remise à zéro du scroll par Astro, mais avant
      // le premier affichage : le visiteur ne voit aucun saut.
      let versTitre = false;
      document.addEventListener("click", (event) => {
        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        versTitre = !!(event.target as HTMLElement).closest(".titre-switch a");
      });
      // La classe doit rester posée pendant toute l'animation de transition
      // (créée après le swap) : on ne la retire qu'au début de la navigation suivante.
      document.addEventListener("astro:before-preparation", () => {
        document.documentElement.classList.remove("sans-fondu");
      });
      document.addEventListener("astro:before-swap", (event) => {
        if (versTitre) event.newDocument.documentElement.classList.add("sans-fondu");
      });
      document.addEventListener("astro:after-swap", () => {
        if (versTitre) scrollerVersCarrousel();
      });
      document.addEventListener("astro:page-load", () => {
        versTitre = false;
      });

      const toggle = document.getElementById("menu-toggle");
      const menu = document.getElementById("menu-secondaire");

      if (toggle && menu) {
        toggle.addEventListener("click", () => {
          const isOpen = !menu.hidden;
          menu.hidden = isOpen;
          toggle.setAttribute("aria-expanded", String(!isOpen));
        });

        document.addEventListener("click", (event) => {
          if (menu.hidden) return;
          if (menu.contains(event.target) || toggle.contains(event.target)) return;
          menu.hidden = true;
          toggle.setAttribute("aria-expanded", "false");
        });

        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape" && !menu.hidden) {
            menu.hidden = true;
            toggle.setAttribute("aria-expanded", "false");
            toggle.focus();
          }
        });

        document.addEventListener("astro:after-swap", () => {
          menu.hidden = true;
          toggle.setAttribute("aria-expanded", "false");
        });
      }

      // Le header est transition:persist (son DOM n'est pas remplacé lors d'une
      // navigation côté client) : sans ça, les aria-current des liens du header
      // resteraient figés sur ceux calculés au premier chargement de la session.
      function majNavActive() {
        const chemin = location.pathname;
        document.querySelectorAll<HTMLAnchorElement>("a[data-nav]").forEach((a) => {
          const cible = new URL(a.href).pathname;
          const actif = a.hasAttribute("data-nav-prefix") ? chemin.startsWith(cible) : chemin === cible;
          if (actif) a.setAttribute("aria-current", "page");
          else a.removeAttribute("aria-current");
        });
      }
      document.addEventListener("astro:page-load", majNavActive);

      // Le sélecteur FR | EN pointe vers la MÊME page dans l'autre langue : l'en-tête étant persistant,
      // on recalcule ses liens à chaque navigation.
      function majLangues() {
        const sans = location.pathname.replace(/^\/en(\/|$)/, "/").replace(/\/$/, "") || "/";
        const lien = document.querySelector<HTMLAnchorElement>("a.langue-btn");
        if (!lien) return;
        lien.href = lien.dataset.langue === "en" ? (sans === "/" ? "/en/" : `/en${sans}`) : sans;
      }
      document.addEventListener("astro:page-load", majLangues);

      // Le bouton n'est pas transition:persist (il n'existe que sur "/" et
      // "/creations") : on le recherche à chaque page-load plutôt que de
      // garder une référence, pour survivre à son absence/réapparition au
      // fil de la navigation. Le listener de scroll, lui, ne s'attache
      // qu'une fois (ce script ne s'exécute qu'au premier chargement).
      function majVisibiliteRetourHaut() {
        const bouton = document.getElementById("retour-haut");
        if (bouton) bouton.classList.toggle("visible", window.scrollY > window.innerHeight * 0.6);
      }
      function setupRetourHaut() {
        document.getElementById("retour-haut")?.addEventListener("click", () => {
          window.scrollTo({ top: 0, behavior: "smooth" });
        });
        majVisibiliteRetourHaut();
      }
      document.addEventListener("astro:page-load", setupRetourHaut);
      document.addEventListener("scroll", majVisibiliteRetourHaut, { passive: true });
    </script>
    <script>
      // ClientRouter remplace les attributs de <html> à chaque navigation : on remet l'état « logo figé ».
      document.addEventListener("astro:after-swap", () => {
        try {
          if (matchMedia("(max-width: 800px)").matches && sessionStorage.getItem("logo-fige-index") !== null) {
            document.documentElement.classList.add("logo-fige");
          }
        } catch {
          /* stockage indisponible */
        }
      });
    </script>
    <main>
      <slot />
    </main>

    {(() => {
      // En génération statique, Astro produit l'URL avec un slash final pour
      // les pages en mode "directory" (ex. "/creations/"), contrairement au
      // serveur de dev qui sert "/creations" sans slash — on normalise avant
      // de comparer pour que le bouton s'affiche dans les deux cas.
      const chemin = sansLangue(Astro.url.pathname).replace(/\/$/, "") || "/";
      return chemin === "/" || chemin === "/creations";
    })() && (
      <button type="button" id="retour-haut" class="retour-haut" aria-label={t(lang, "retour.haut")}>
        <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
          <path fill="currentColor" d="M12 5l-7 7h4v7h6v-7h4z" />
        </svg>
      </button>
    )}

    {currentPath !== "/creations" && (
      <footer transition:persist>
        <p class="refs-titre">{t(lang, "footer.titre")}</p>
        <div class="refs-logos">
          {rangees.map((rangee) => (
            <ul class="refs-ligne">
              {rangee.map((c) => (
                <li style={`--l:${c.largeur}px;--h:${c.hauteur}px`}>
                  {/* Lien externe sur toutes les pages : nofollow, pour ne pas diluer le référencement du site. */}
                  <a href={c.url} target="_blank" rel="noopener nofollow">
                    <img src={c.logo} width={c.largeur} height={c.hauteur} alt={t(lang, "footer.logo.alt").replace("{nom}", c.nom)} loading="lazy" decoding="async" />
                  </a>
                </li>
              ))}
            </ul>
          ))}
          {clientsTexte.length > 0 && (
            <ul class="refs-ligne">
              {clientsTexte.map((c) => (
                <li class="refs-texte">{c.url ? <a href={c.url} target="_blank" rel="noopener nofollow">{c.nom}</a> : c.nom}</li>
              ))}
            </ul>
          )}
        </div>
      </footer>
    )}

    {/* Carnet et contact : deux blocs sur une seule ligne sur grand écran (voir .niveaux), l'un sous l'autre
       en dessous. (Le texte de présentation vit sur l'accueil et Créations : components/Presentation.astro.) */}
    <div class="niveaux" transition:persist>
    <section class="bandeau">
      <div class="bandeau-carnet">
        {derniereEntree ? (
          <a class="carnet-apercu" href={url(lang, "/carnet")}>
            <span class="carnet-label">{t(lang, "carnet.derniere")}</span>
            <span class="carnet-titre">{derniereEntree.data.titre}</span>
            <span class="carnet-date">{dateFormatee(lang, derniereEntree.data.date, { year: "numeric", month: "long", day: "numeric" })}</span>
            {derniereEntree.data.extrait && <span class="carnet-extrait">{derniereEntree.data.extrait}</span>}
          </a>
        ) : (
          <p class="carnet-vide">{t(lang, "carnet.vide")}</p>
        )}
      </div>
    </section>

    {/* Formulaire de contact, présent sur toutes les pages, mis en avant (cadre, titre fléché, bouton rouge). */}
    <section class="pied">
      <div class="pied-contact">
        <div class="pied-cadre">
        <h2 class="pied-accroche"><span class="fleche" aria-hidden="true">→</span> {t(lang, "contact.titre")}</h2>
        <p class="pied-intro">{t(lang, "contact.intro")}</p>
        <form id="form-contact" data-textes={JSON.stringify(textesContact)}>
          <input type="text" name="site" class="pied-piege" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <label class="pied-champ"><span>{t(lang, "contact.prenom")}</span><input type="text" name="prenom" autocomplete="given-name" required /></label>
          <label class="pied-champ"><span>{t(lang, "contact.nom")}</span><input type="text" name="nom" autocomplete="family-name" required /></label>
          <label class="pied-champ"><span>{t(lang, "contact.structure")}</span><input type="text" name="structure" autocomplete="organization" required /></label>
          <label class="pied-champ"><span>{t(lang, "contact.fonction")}</span><input type="text" name="fonction" autocomplete="organization-title" required /></label>
          <label class="pied-champ"><span>{t(lang, "contact.email")}</span><input type="email" name="email" autocomplete="email" required /></label>
          <label class="pied-champ"><span>{t(lang, "contact.telephone")}</span><input type="tel" name="telephone" autocomplete="tel" required /></label>
          <button type="submit">{t(lang, "contact.envoyer")}</button>
          <p class="pied-statut" role="status" hidden></p>
        </form>
        </div>
      </div>
    </section>
    </div>
    <script>
      // Formulaire de contact du pied de page (/api/contact). Le bloc est transition:persist : on écoute au niveau
      // du document, une seule fois, plutôt que de rattacher l'écouteur à chaque navigation. En phase de capture :
      // preventDefault() doit passer AVANT l'écouteur du ClientRouter, qui sinon soumet le formulaire en GET
      // (rechargement de la page avec les coordonnées dans l'adresse).
      document.addEventListener("submit", async (event) => {
        const form = event.target as HTMLFormElement;
        if (form?.id !== "form-contact") return;
        event.preventDefault();
        const T = JSON.parse(form.dataset.textes ?? "{}") as Record<string, string>;
        const bouton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
        const statut = form.querySelector<HTMLElement>(".pied-statut");
        const afficherStatut = (message: string, succes: boolean) => {
          if (!statut) return;
          statut.hidden = false;
          statut.textContent = message;
          statut.classList.toggle("pied-statut-erreur", !succes);
        };
        if (bouton) {
          bouton.disabled = true;
          bouton.textContent = T.envoi ?? "Envoi en cours…";
        }
        const donnees: Record<string, FormDataEntryValue> = Object.fromEntries(new FormData(form).entries());
        donnees.lang = T.lang ?? "fr";
        try {
          const reponse = await fetch("/api/contact", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(donnees),
          });
          const resultat = await reponse.json();
          if (reponse.ok && resultat.ok) {
            afficherStatut(T.ok ?? "Vos coordonnées ont bien été envoyées.", true);
            form.reset();
          } else {
            afficherStatut(resultat.erreur || T.erreur || "Une erreur est survenue. Merci de réessayer.", false);
          }
        } catch {
          afficherStatut(T.erreurReseau ?? "Une erreur est survenue. Vérifiez votre connexion et réessayez.", false);
        } finally {
          if (bouton) {
            bouton.disabled = false;
            bouton.textContent = T.envoyer ?? "Envoyer";
          }
        }
      }, true);
    </script>

    <div class="cloture" transition:persist>
      <p class="copyright">
        {t(lang, "copyright")} / {new Date().getFullYear()} - <a href={url(lang, "/mentions-legales")}>{t(lang, "mentions")}</a>
      </p>
    </div>
  </body>
</html>

<style is:global>
  html.sans-fondu::view-transition-group(root),
  html.sans-fondu::view-transition-old(root),
  html.sans-fondu::view-transition-new(root) { animation: none; }

  /* Archivo auto-hébergée (public/fonts/) : un seul fichier de police variable couvre toutes les
     graisses (100 à 900) et les largeurs (62 à 125 %). Pas d'italique fourni : le navigateur
     incline la romaine si besoin (.prix-film). Inter sert aux textes courants (--police-texte) et aux
     flèches « → », absentes d'Archivo. */
  @font-face {
    font-family: 'Archivo';
    font-style: normal;
    font-weight: 100 900;
    font-stretch: 62% 125%;
    font-display: swap;
    src: url('/fonts/Archivo-wdth.woff2') format('woff2');
  }
  @font-face {
    font-family: 'Inter';
    font-style: normal;
    font-weight: 300 800;
    font-display: swap;
    src: url('/fonts/Inter-normal.woff2') format('woff2');
  }

  /* Fond noir pur (l'ancien dégradé était #050912 → #0b0b0b : il suffit de redonner deux valeurs différentes pour le retrouver). */
  :root { --fond-debut:#000; --fond-fin:#000; }
  /* « Blanc » du site : un seul réglage (--blanc-rgb sert aux blancs transparents : rgba(var(--blanc-rgb), .5)). */
  :root { --blanc:#F1EEE8; --blanc-rgb:241,238,232; --rouge:#AD1100; /* rouge du logo (test ; avant : #FF3B1F) */ }
  /* Police des textes courants (paragraphes) : Inter regular (400), plus lisible qu'Archivo en petit. */
  :root { --police-texte: 'Inter', -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Arial, sans-serif; }
  /* Flèches « → » « ← » insérées dans du texte : rouge du logo. */
  .fleche { color:var(--rouge); }
  /* Largeur d'Archivo (axe wdth, de 62 % à 125 % ; 100 % = largeur normale du fichier). Un seul réglage pour tout le site. */
  :root { --largeur-police:85%; }
  body, button, input, select, textarea { font-stretch: var(--largeur-police); }
