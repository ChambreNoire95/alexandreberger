---
import Layout from "../layouts/Layout.astro";

const titre = "Booking — Alexandre Berger, réalisateur freelance";
const description = "Réserver Alexandre Berger, réalisateur freelance en Île-de-France, pour un projet en documentaire, fiction ou film de marque.";
---

<Layout title={titre} description={description} currentPath="/booking">
  <div class="contenu">
    <p>À rédiger.</p>
  </div>
</Layout>

<style>
  .contenu { margin-top:3.5rem; font-weight:300; font-size:1.1rem; color:rgba(255,255,255,.72); }
</style>
