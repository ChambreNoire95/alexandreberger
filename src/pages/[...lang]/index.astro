---
export const prerender = true;
import Layout from "../../layouts/Layout.astro";
import Signature from "../../components/Signature.astro";
import TitreSwitch from "../../components/TitreSwitch.astro";
import Presentation from "../../components/Presentation.astro";
import CarrouselHome from "../../components/CarrouselHome.astro";
import OptimizedImage from "../../components/OptimizedImage.astro";
import { getProjets } from "../../lib/contenu";
import { getItemsCarrousel } from "../../lib/carrousel";
import { descriptionDepuisTexte } from "../../lib/meta";
import { urlEmbed } from "../../lib/video";
import { cheminManifest, nomFichier } from "../../lib/image-config.mjs";
import { existsSync, readFileSync } from "node:fs";
import bandeDemo from "../../content/settings/bande-demo.json";
import { cheminsLangues, langDe, t, url, libelle, roleAffiche, dateFormatee } from "../../i18n";

export function getStaticPaths() {
  return cheminsLangues();
}
const lang = langDe(Astro.params);

const projets = (await getProjets(lang, ({ data }) => data.categorie === "commandes" && !data.brouillon)).sort(
  // Plus récente en premier, plus ancienne en bas (comme sur Créations).
  (a, b) => (b.data.date?.valueOf() ?? -Infinity) - (a.data.date?.valueOf() ?? -Infinity)
);

// Durée : les unités (min, h, s…) sont enveloppées pour être affichées plus petites.
const echapper = (t: string) => t.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const dureeHtml = (d?: string) =>
  d ? echapper(d).replace(/[a-zA-ZÀ-ÿ]+/g, '<span class="duree-unite">$&</span>') : undefined;

const demoUrl = bandeDemo.video?.trim() ? urlEmbed(bandeDemo.video.trim()) : null;
// Demoreel : le bloc prend la proportion réelle de l'image de couverture (ex. 2,355 pour un 2.35:1), lue dans le manifest
// des images ; 16/9 par défaut (sans image, ou dimensions inconnues). L'image est servie en version d'origine : la plus
// grande variante optimisée (960 px) serait étirée sur toute la largeur du contenu.
const dimensionsDemo = bandeDemo.image && existsSync(`public${cheminManifest(bandeDemo.image)}`)
  ? JSON.parse(readFileSync(`public${cheminManifest(bandeDemo.image)}`, "utf-8"))[nomFichier(bandeDemo.image)]
  : undefined;
const ratioDemo = dimensionsDemo ? `${dimensionsDemo.width} / ${dimensionsDemo.height}` : "16 / 9";

// Liste des films : visuel à gauche (couverture, à défaut première image), titre, « Rôle pour Client », courte description
// (accroche du CMS, à défaut le début du texte) et durée.
const lignes = projets.map((p) => {
  const aCouverture = !!p.data.couverture;
  const image = p.data.couverture || p.data.image1;
  return {
    p,
    image,
    alt: (aCouverture ? p.data.couvertureAlt : p.data.image1Alt) || p.data.titre,
    description: p.data.accroche?.trim() || descriptionDepuisTexte(p.body, 140),
    duree: dureeHtml(p.data.duree?.trim() || undefined),
  };
});
// Univers (rails) et Critères (filtre), champs CMS à choix : seules les valeurs portées par au moins un film sont proposées.
const SECTEURS = ["Mode", "Musique", "Série/Cinéma", "Art", "Culture", "Terroir / Gastronomie", "Éducation", "Sciences", "Société", "Sport", "Solidarité", "Environnement"];
const BESOINS = ["Interviews", "Mise en scène / Direction artistique", "Tournage à l'étranger", "Projet au long cours", "Images d'archives"];
const criteresPresents = BESOINS.filter((x) => projets.some((p) => p.data.besoins?.includes(x)));

// Rails : les 12 univers du CMS sont regroupés en 4 rangées, à l'affichage seulement (les fiches ne changent pas). Chaque
// film figure dans UNE seule rangée : celle de son PREMIER univers. L'ordre des rangées est celui de GROUPES ci-dessous (choisi par Alexandre). Un film
// sans univers (ou d'un univers ajouté au CMS sans être rangé ici) tombe dans « Autres films », pour ne jamais disparaître.
const GROUPES = [
  { cle: "cinema", univers: ["Série/Cinéma", "Musique"] },
  { cle: "societe", univers: ["Société", "Éducation", "Environnement", "Sciences", "Solidarité", "Terroir / Gastronomie"] },
  { cle: "art", univers: ["Art", "Mode", "Culture"] },
  { cle: "sport", univers: ["Sport"] },
];
const groupeDe = (l: (typeof lignes)[number]) =>
  GROUPES.find((g) => g.univers.includes(l.p.data.secteurs?.[0] ?? ""))?.cle ?? "autres";
const rails = [...GROUPES.map((g) => g.cle), "autres"]
  .map((cle) => ({ cle, titre: t(lang, `rails.${cle}`), films: lignes.filter((l) => groupeDe(l) === cle) }))
  .filter((r) => r.films.length > 0);
const compte = (n: number) => `${n} ${t(lang, n > 1 ? "rails.films" : "rails.film")}`;

const itemsCarrousel = await getItemsCarrousel(lang);

const titre = t(lang, "accueil.titre");
const description = t(lang, "accueil.description");

// N'affiche dans le filtre que les types réellement utilisés par au moins un projet.
const ORDRE_TYPES = ["Making-of", "Documentaire", "Activation / Aftermovie", "Institutionnel", "Brand Content", "RSE", "Fiction"];
const typesPresents = ORDRE_TYPES.filter((t) => projets.some((p) => p.data.type === t));
// Filtre « Type de film » : désactivé pour l'instant (rangée masquée, le reste du code est conservé). Passer à true pour le réactiver.
const FILTRE_TYPE_ACTIF = false;
---

<Layout title={titre} description={description} currentPath="/" lang={lang}>
  <p class="sr-only">{t(lang, "accueil.sr")}</p>

  <Signature lang={lang} />

  <CarrouselHome items={itemsCarrousel} lang={lang} />

  <Presentation lang={lang} />

  <TitreSwitch actif="commandes" lang={lang} />

  {/* Zone de filtres : trois rangées (type de film, univers, critères) qui se croisent. Les valeurs séparées par « | »
     sur chaque <li> sont lues par setupFiltres(). */}
  <div class="filtres-zone" id="filtres">
    {FILTRE_TYPE_ACTIF && typesPresents.length > 0 && (
      <div class="filtres-rang">
        <p class="filtres-label">{t(lang, "filtre.type")}</p>
        <div class="filtres" role="group" data-groupe="type" aria-label={t(lang, "filtre.aria.type")}>
          <button type="button" data-valeur="" aria-pressed="true">{t(lang, "filtre.tous")}</button>
          {typesPresents.map((ty) => (
            <button type="button" data-valeur={ty} aria-pressed="false">{libelle(lang, "type", ty)}</button>
          ))}
        </div>
      </div>
    )}
    {criteresPresents.length > 0 && (
      <div class="filtres-rang">
        <p class="filtres-label">{t(lang, "filtre.criteres")}</p>
        <div class="filtres" role="group" data-groupe="criteres" aria-label={t(lang, "filtre.criteres")}>
          <button type="button" data-valeur="" aria-pressed="true">{t(lang, "filtre.tous")}</button>
          {criteresPresents.map((c) => (
            <button type="button" data-valeur={c} aria-pressed="false">{libelle(lang, "critere", c)}</button>
          ))}
        </div>
      </div>
    )}
  </div>

  {/* Rails (desktop) : une rangée par groupe d'univers, qui défile à l'horizontale (trackpad, flèches). Sur mobile, ils sont
     remplacés par la liste complète des films (titre + rôle), centrée comme avant : première section ci-dessous. */}
  <div class="rails" id="rails" data-film={t(lang, "rails.film")} data-films={t(lang, "rails.films")}>
    <section class="rail rail-tous">
      <ul class="rail-piste">
        {lignes.map(({ p }) => (
          <li data-type={p.data.type || ""} data-univers={(p.data.secteurs ?? []).join("|")} data-criteres={(p.data.besoins ?? []).join("|")}>
            <a href={url(lang, `/projets/${p.id}`)}>
              <span class="projet-texte">
                <span class="accroche-titre">{p.data.titre}</span>
                {p.data.role && p.data.client ? (
                  <span class="accroche-meta">{roleAffiche(lang, p.data.role)} <br class="saut-mobile" />{t(lang, "pour")} {p.data.client}</span>
                ) : (
                  (p.data.role || p.data.client) && <span class="accroche-meta">{p.data.role ? roleAffiche(lang, p.data.role) : p.data.client}</span>
                )}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
    {rails.map((rail) => (
      <section class="rail">
        <div class="rail-tete">
          <h2 class="rail-titre">{rail.titre}</h2>
          <span class="rail-compte">{compte(rail.films.length)}</span>
          <span class="rail-fleches">
            <button type="button" class="rail-btn" data-dir="-1" aria-label={`${t(lang, "carrousel.precedent")} — ${rail.titre}`}>←</button>
            <button type="button" class="rail-btn" data-dir="1" aria-label={`${t(lang, "carrousel.suivant")} — ${rail.titre}`}>→</button>
          </span>
        </div>
        <ul class="rail-piste">
          {rail.films.map(({ p, image, alt, description, duree }) => (
            <li data-type={p.data.type || ""} data-univers={(p.data.secteurs ?? []).join("|")} data-criteres={(p.data.besoins ?? []).join("|")}>
              <a href={url(lang, `/projets/${p.id}`)}>
                {image && (
                  <span class="projet-visuel">
                    <OptimizedImage src={image} alt={alt} sizes="(min-width: 1100px) 290px, 30vw" nePasChargerSi="(max-width: 800px)" />
                    {duree && <span class="projet-duree" set:html={duree} />}
                  </span>
                )}
                <span class="projet-texte">
                  <span class="accroche-titre">{p.data.titre}</span>
                  {p.data.role && p.data.client ? (
                    <span class="accroche-meta">{roleAffiche(lang, p.data.role)} <br class="saut-mobile" />{t(lang, "pour")} {p.data.client}</span>
                  ) : (
                    (p.data.role || p.data.client) && <span class="accroche-meta">{p.data.role ? roleAffiche(lang, p.data.role) : p.data.client}</span>
                  )}
                  {description && <span class="accroche-description">{description}</span>}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>

  <p class="filtres-vide" id="filtres-vide" hidden>{t(lang, "filtre.rien")}</p>

  {/* Demoreel intégrée en pleine largeur (celle du contenu, alignée sur les titres des projets), juste au-dessus
     de « Ils m'ont fait confiance ». Image de couverture + bouton lecture : le lecteur n'est chargé qu'au clic
     (pas de lecteur vidéo lourd au chargement de la page), puis la lecture démarre sur place. */}
  {demoUrl && (
    <section class="demoreel" aria-labelledby="demoreel-titre">
      <h2 class="demoreel-titre" id="demoreel-titre">{t(lang, "demo.titre")}</h2>
      <div class="demoreel-lecteur" style={`--ratio:${ratioDemo}`} data-demoreel data-src={demoUrl}>
        <button type="button" class:list={["demoreel-lancer", { "avec-image": !!bandeDemo.image }]} data-demoreel-lancer aria-label={t(lang, "apercu.demo.voir")}>
          {bandeDemo.image && <img src={bandeDemo.image} width={dimensionsDemo?.width} height={dimensionsDemo?.height} alt="" loading="lazy" decoding="async" />}
          <span class="demoreel-play" aria-hidden="true"></span>
        </button>
      </div>
    </section>
  )}
</Layout>

<style>
  /* Zone de filtres, entre deux filets : une rangée par famille (libellé + boutons). */
  .filtres-zone {
    width:100%; max-width:1240px; display:flex; flex-direction:column; gap:1.5rem;
    padding:1.75rem 0; border-top:1px solid rgba(var(--blanc-rgb),.14); border-bottom:1px solid rgba(var(--blanc-rgb),.14);
  }
  .filtres-rang { display:flex; flex-direction:column; align-items:center; gap:.75rem; }
  .filtres-label {
    margin:0; font-family:'Archivo', 'Inter', sans-serif; font-weight:700; font-size:.7rem;
    letter-spacing:.14em; text-transform:uppercase; color:var(--blanc);
  }
  .filtres { display:flex; flex-wrap:wrap; justify-content:center; gap:.75rem; margin:0; }
  .filtres button:disabled { opacity:.3; cursor:not-allowed; border-style:dashed; }
  .filtres button:disabled:hover { color:rgba(var(--blanc-rgb),.5); border-color:rgba(var(--blanc-rgb),.3); }
  .filtres-vide { width:100%; max-width:1240px; margin:4.5rem 0 0; font-family:var(--police-texte); font-weight:400; font-size:1rem; color:rgba(var(--blanc-rgb),.65); }
  /* Desktop : une colonne par famille (Univers | Critères), côte à côte ; libellé au-dessus, boutons qui reviennent à la
     ligne dans leur colonne. La première colonne, qui a le plus de boutons, est un peu plus large. */
  @media (min-width: 801px) {
    .filtres-zone { flex-direction:row; align-items:flex-start; gap:0; }
    .filtres-rang { flex:1 1 0; min-width:0; align-items:flex-start; gap:1rem; padding:0 2.5rem; }
    .filtres-rang:first-child { flex-grow:1.25; padding-left:0; }
    .filtres-rang:last-child { padding-right:0; }
    .filtres-rang + .filtres-rang { border-left:1px solid rgba(var(--blanc-rgb),.14); }
    .filtres { justify-content:flex-start; }
  }
  .filtres button {
    font-family:'Archivo', 'Inter', sans-serif; font-weight:200;
    font-size:.7rem; letter-spacing:.14em; text-transform:uppercase;
    color:rgba(var(--blanc-rgb),.5); background:transparent; cursor:pointer;
    border:1px solid rgba(var(--blanc-rgb),.3); border-radius:2px; padding:.4rem .8rem;
    transition: background 140ms ease, color 140ms ease, border-color 140ms ease;
  }
  .filtres button:hover { color:var(--blanc); border-color:var(--rouge); }
  .filtres button[aria-pressed="true"] { background:var(--blanc); color:#0b0b0b; border-color:var(--blanc); font-weight:700; }
  /* Desktop : boutons de filtre en blanc à 100 % (lisibles) ; au survol et à l'état actif, rouge plein, texte blanc. */
  @media (min-width: 801px) {
    .filtres button { color:var(--blanc); border-color:var(--blanc); }
    .filtres button:not(:disabled):hover, .filtres button[aria-pressed="true"] { background:var(--rouge); border-color:var(--rouge); color:var(--blanc); }
    .filtres button:disabled:hover { background:transparent; color:var(--blanc); border-color:var(--blanc); }
  }
  /* Liste des films. Base (mobile) : seule la liste complète (.rail-tous), centrée, sans visuel ni description. */
  .rails { width:100%; overflow-anchor:none; }
  .rail:not(.rail-tous), .rail-tete { display:none; }
  .rail[hidden] { display:none; }
  .rail-piste { list-style:none; margin:4.5rem 0 0; padding:0; display:flex; flex-direction:column; align-items:center; gap:3.575rem; }
  .rail-piste li[hidden] { display:none; }
  .rail-piste a {
    display:flex; flex-direction:column; align-items:center; gap:.6rem;
    text-decoration:none;
  }
  .projet-texte { display:flex; flex-direction:column; align-items:inherit; gap:.6rem; }
  .accroche-titre {
    font-weight:700; font-size:clamp(1.076rem, 2.458vw, 1.536rem); line-height:1.2; /* +10 % puis -3 % */
    font-stretch:100%; /* largeur normale d'Archivo (le reste du site est resserré) */
    color:var(--blanc); white-space:nowrap; transition:color 140ms ease;
  }
  .rail-piste a:hover .accroche-titre { color:rgba(var(--blanc-rgb),.6); }
  @media (max-width: 700px) {
    .accroche-titre { white-space:normal; max-width:40ch; text-align:center; }
  }
  .accroche-meta {
    font-family:'Archivo', 'Inter', sans-serif; font-weight:400;
    font-size:.77rem; letter-spacing:.12em; text-transform:uppercase; color:rgba(var(--blanc-rgb),.65);
  }
  .accroche-description { font-family:var(--police-texte); font-weight:400; font-size:1rem; line-height:1.6; color:rgba(var(--blanc-rgb),.8); max-width:52rem; }
  .saut-mobile { display:none; }
  .projet-visuel, .accroche-description { display:none; }
  @media (max-width: 800px) {
    .saut-mobile { display:inline; }
  }

  /* Desktop : rails. Une rangée par univers (titre, nombre de films, flèches), dont les cartes défilent à l'horizontale ;
     le bord droit s'estompe pour signaler la suite. Carte : visuel 16/9 + durée, titre, « Rôle pour Client », description. */
  @media (min-width: 801px) {
    .rails { max-width:1240px; margin-top:3.5rem; }
    .rail:not(.rail-tous) { display:block; }
    .rail-tous { display:none; } /* liste complète : mobile uniquement */
    .rail[hidden] { display:none; }
    .rail:not(.rail-tous) + .rail:not(.rail-tous) { margin-top:3rem; padding-top:2.5rem; border-top:1px solid rgba(var(--blanc-rgb),.14); }
    .rail-tete { display:flex; align-items:baseline; gap:1rem; margin-bottom:1.1rem; }
    .rail-titre { margin:0; font-weight:800; font-size:clamp(1.35rem, 2.3vw, 1.9rem); line-height:1; color:var(--blanc); }
    .rail-compte {
      font-family:'Archivo', 'Inter', sans-serif; font-weight:200; font-size:.7rem; letter-spacing:.16em;
      text-transform:uppercase; color:rgba(var(--blanc-rgb),.5);
    }
    .rail-fleches { margin-left:auto; display:flex; gap:.4rem; }
    .rail-fleches[hidden] { display:none; }
    .rail-btn {
      width:2.25rem; height:2.25rem; padding:0; font-family:'Inter', sans-serif; font-size:1rem; line-height:1;
      color:var(--blanc); background:transparent; border:1px solid var(--blanc); border-radius:2px; cursor:pointer;
      transition:background 140ms ease, border-color 140ms ease, opacity 140ms ease;
    }
    .rail-btn:not(:disabled):hover, .rail-btn:focus-visible { background:var(--rouge); border-color:var(--rouge); outline:none; }
    .rail-btn:disabled { opacity:.3; cursor:default; }
    .rail-piste {
      margin:0; flex-direction:row; align-items:flex-start; gap:1rem;
      overflow-x:auto; scroll-snap-type:x proximity; scrollbar-width:none; overscroll-behavior-x:contain;
      padding-right:8%;
      -webkit-mask-image:linear-gradient(to right, #000 88%, transparent); mask-image:linear-gradient(to right, #000 88%, transparent);
    }
    .rail-piste::-webkit-scrollbar { display:none; }
    /* Rangée qui tient entièrement dans la largeur : pas d'estompe. */
    .rail-piste.entiere { -webkit-mask-image:none; mask-image:none; padding-right:0; }
    /* 3 cartes par écran (4 à partir de 1100 px) : une rangée de 4 films tient entière, la suivante dépasse dans l'estompe. */
    .rail-piste li { flex:none; width:max(220px, calc((100% - 2rem) / 3)); scroll-snap-align:start; }
    .rail-piste a { align-items:stretch; gap:.85rem; text-align:left; }
    .projet-visuel {
      display:block; position:relative; width:100%; aspect-ratio:16/9;
      overflow:hidden; border-radius:2px; background:#111; border-bottom:1px solid var(--blanc);
    }
    .projet-visuel :global(img) { width:100%; height:100%; object-fit:cover; display:block; transition:transform 600ms cubic-bezier(.2,.7,.2,1); }
    .rail-piste a:hover .projet-visuel :global(img), .rail-piste a:focus-visible .projet-visuel :global(img) { transform:scale(1.05); }
    /* Durée : pastille en bas à droite du visuel. Unités (min, h…) plus petites. */
    .projet-duree {
      position:absolute; right:.5rem; bottom:.5rem; padding:.15rem .45rem; border-radius:2px;
      background:rgba(0,0,0,.75); color:var(--blanc); font-weight:700; font-size:.8rem; line-height:1.3; text-transform:uppercase;
    }
    .projet-duree :global(.duree-unite) { font-size:.75em; }
    .projet-texte { align-items:flex-start; min-width:0; gap:.5rem; }
    .accroche-titre { white-space:normal; font-size:1.08rem; }
    .accroche-description { display:block; font-size:.92rem; line-height:1.5; }
  }
  @media (min-width: 1100px) {
    .rail-piste li { width:calc((100% - 3rem) / 4); }
    .rail-piste.entiere li { width:calc((92% - 3rem) / 4); } /* même largeur de carte avec ou sans estompe */
  }

  /* Demoreel intégrée : pleine largeur du contenu (même bord gauche que les titres des projets), 16/9. */
  .demoreel { width:100%; max-width:1240px; margin:7rem 0 0; }
  /* Titre au-dessus de la vidéo. Mobile : comme les titres de page (capitales espacées, centré). Desktop : comme les titres
     des rails, calé à gauche, sous un filet. */
  .demoreel-titre {
    margin:0 0 2rem; font-family:'Archivo', 'Inter', sans-serif; font-weight:400; font-size:1.3rem;
    letter-spacing:.22em; text-transform:uppercase; text-align:center; color:var(--blanc);
  }
  @media (min-width: 801px) {
    .demoreel { margin-top:3rem; padding-top:2.5rem; border-top:1px solid rgba(var(--blanc-rgb),.14); }
    .demoreel-titre {
      margin-bottom:1.1rem; font-weight:800; font-size:clamp(1.35rem, 2.3vw, 1.9rem); line-height:1;
      letter-spacing:normal; text-transform:none; text-align:left;
    }
  }
  .demoreel-lecteur {
    position:relative; width:100%; aspect-ratio:var(--ratio, 16 / 9); overflow:hidden; border-radius:2px;
    background:linear-gradient(135deg,#1c1c1c,#0b0b0b); transition:aspect-ratio 450ms ease;
  }
  /* Image fixe : proportion de l'image de couverture (--ratio, ex. 2.35:1). Pendant la lecture : 16/9, car la vidéo est un
     fichier 16:9 (bandes noires comprises) qui, dans un cadre 2.35:1, serait réduite à moins de la moitié de la largeur. */
  .demoreel-lecteur.lecture { aspect-ratio:16 / 9; }
  .demoreel-lancer { position:absolute; inset:0; display:block; width:100%; height:100%; padding:0; border:0; background:transparent; cursor:pointer; }
  .demoreel-lancer :global(img) { width:100%; height:100%; object-fit:cover; display:block; }
  /* L'iframe reste invisible (fond noir) jusqu'à son chargement : évite le flash blanc avant l'affichage du lecteur. */
  .demoreel-lecteur :global(iframe) {
    position:absolute; inset:0; width:100%; height:100%; border:0; display:block; background:#000; color-scheme:dark;
    opacity:0; transition:opacity 200ms ease;
  }
  .demoreel-lecteur :global(iframe.pret) { opacity:1; }
  .demoreel-lecteur.lecture .demoreel-lancer { display:none; }
  .demoreel-play {
    position:absolute; top:50%; left:50%; width:84px; height:84px; margin:-42px 0 0 -42px;
    border:1px solid var(--blanc); border-radius:50%; background:rgba(0,0,0,.45);
    transition:background 140ms ease, transform 140ms ease;
  }
  .demoreel-play::before {
    content:""; position:absolute; top:50%; left:50%; margin:-12px 0 0 -8px;
    border-style:solid; border-width:12px 0 12px 21px; border-color:transparent transparent transparent var(--blanc);
  }
  /* Avec une image de couverture (souvent un titre au centre) : bouton lecture en bas à gauche. */
  .demoreel-lancer.avec-image .demoreel-play { top:auto; left:1.75rem; bottom:1.75rem; width:60px; height:60px; margin:0; }
  .demoreel-lancer.avec-image .demoreel-play::before { margin:-10px 0 0 -6px; border-width:10px 0 10px 17px; }
  .demoreel-lancer:hover .demoreel-play, .demoreel-lancer:focus-visible .demoreel-play { background:var(--rouge); border-color:var(--rouge); transform:scale(1.06); }
  @media (max-width: 800px) {
    .demoreel { margin-top:4rem; }
    .demoreel-play { width:60px; height:60px; margin:-30px 0 0 -30px; }
    .demoreel-play::before { margin:-9px 0 0 -6px; border-width:9px 0 9px 15px; }
    .demoreel-lancer.avec-image .demoreel-play { left:1rem; bottom:1rem; width:44px; height:44px; margin:0; }
    .demoreel-lancer.avec-image .demoreel-play::before { margin:-7px 0 0 -4px; border-width:7px 0 7px 12px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .projet-visuel :global(img), .rail-btn, .demoreel-lecteur, .demoreel-lecteur :global(iframe), .demoreel-play { transition:none !important; }
  }
</style>

<script>
  import { scrollerVersTitre } from "../../lib/positionTitre";
  
  // Rails : flèches (grisées en bout de course, masquées si toute la rangée tient dans la largeur).
  function majRail(rail: HTMLElement) {
    const piste = rail.querySelector<HTMLElement>('.rail-piste');
    const fleches = rail.querySelector<HTMLElement>('.rail-fleches');
    if (!piste || !fleches) return;
    // Le padding droit (estompe) fausse la mesure : on compare le bord de la dernière carte visible à celui de la piste.
    const cartes = [...piste.querySelectorAll<HTMLElement>('li:not([hidden])')];
    const derniere = cartes[cartes.length - 1];
    piste.classList.remove('entiere');
    const tient = !derniere || derniere.offsetLeft + derniere.offsetWidth <= piste.clientWidth + 1;
    piste.classList.toggle('entiere', tient);
    fleches.hidden = tient;
    const [avant, apres] = [...fleches.querySelectorAll<HTMLButtonElement>('.rail-btn')];
    if (avant) avant.disabled = piste.scrollLeft <= 1;
    if (apres) apres.disabled = piste.scrollLeft + piste.clientWidth >= piste.scrollWidth - 1;
  }
  function setupRails() {
    const rails = [...document.querySelectorAll<HTMLElement>('#rails .rail')];
    rails.forEach((rail) => {
      const piste = rail.querySelector<HTMLElement>('.rail-piste');
      if (!piste) return;
      rail.querySelectorAll<HTMLButtonElement>('.rail-btn').forEach((b) =>
        b.addEventListener('click', () => piste.scrollBy({ left: Number(b.dataset.dir) * piste.clientWidth * 0.75, behavior: 'smooth' }))
      );
      piste.addEventListener('scroll', () => majRail(rail), { passive: true });
      majRail(rail);
    });
    if (rails.length) window.addEventListener('resize', () => rails.forEach(majRail));
  }

  // Filtres qui se croisent : type (un seul, désactivé pour l'instant), critères (plusieurs : le film doit tous les porter).
  // Un bouton qui ne mènerait à aucun film avec le reste de la sélection est grisé. Les univers sont devenus les rails.
  function setupFiltres() {
    const zone = document.getElementById('filtres');
    const liste = document.getElementById('rails');
    const vide = document.getElementById('filtres-vide');
    const items = [...document.querySelectorAll<HTMLLIElement>('#rails .rail-piste li')];
    if (!zone || !liste || !items.length) return;

    const fiches = items.map((li) => ({
      li,
      type: li.dataset.type ?? '',
      univers: (li.dataset.univers ?? '').split('|').filter(Boolean),
      criteres: (li.dataset.criteres ?? '').split('|').filter(Boolean),
    }));
    const boutons = [...zone.querySelectorAll<HTMLButtonElement>('button[data-valeur]')];
    const groupeDe = (b: HTMLElement) => b.closest<HTMLElement>('[data-groupe]')?.dataset.groupe ?? '';
    let type = '';
    let univers = '';
    const criteres = new Set<string>();

    type Fiche = (typeof fiches)[number];
    const convient = (f: Fiche, t: string, u: string, c: Set<string>) =>
      (!t || f.type === t) && (!u || f.univers.includes(u)) && [...c].every((x) => f.criteres.includes(x));

    const appliquer = () => {
      let visibles = 0;
      fiches.forEach((f) => {
        f.li.hidden = !convient(f, type, univers, criteres);
        if (!f.li.hidden) visibles++;
      });
      if (vide) vide.hidden = visibles > 0;
      // Une rangée sans film visible disparaît ; les autres affichent leur nouveau nombre de films et repartent du début.
      liste.querySelectorAll<HTMLElement>('.rail').forEach((rail) => {
        const n = rail.querySelectorAll('.rail-piste li:not([hidden])').length;
        rail.hidden = n === 0;
        const c = rail.querySelector('.rail-compte');
        if (c) c.textContent = `${n} ${n > 1 ? liste.dataset.films : liste.dataset.film}`;
        const piste = rail.querySelector<HTMLElement>('.rail-piste');
        if (piste) piste.scrollLeft = 0;
        majRail(rail);
      });

      boutons.forEach((b) => {
        const g = groupeDe(b);
        const v = b.dataset.valeur ?? '';
        const actif = g === 'type' ? type === v : g === 'univers' ? univers === v : v ? criteres.has(v) : criteres.size === 0;
        b.setAttribute('aria-pressed', String(actif));
        // « Tous » et les boutons déjà cochés restent toujours cliquables.
        b.disabled = !!v && !actif && !fiches.some((f) =>
          g === 'type' ? convient(f, v, univers, criteres)
            : g === 'univers' ? convient(f, type, v, criteres)
            : convient(f, type, univers, new Set([...criteres, v]))
        );
      });
    };

    zone.addEventListener('click', (event) => {
      const bouton = (event.target as HTMLElement).closest<HTMLButtonElement>('button[data-valeur]');
      if (!bouton || bouton.disabled) return;
      const g = groupeDe(bouton);
      const v = bouton.dataset.valeur ?? '';
      if (g === 'type') type = v;
      else if (g === 'univers') univers = univers === v ? '' : v;
      else if (!v) criteres.clear();
      else if (criteres.has(v)) criteres.delete(v);
      else criteres.add(v);

      appliquer();

      // Masquer/afficher des accroches change la hauteur de la page : on recale
      // aussitôt, dans la même image, sur la position de référence (titre en haut).
      scrollerVersTitre();
    });

    appliquer();
  }

  // Demoreel : au clic sur l'image de couverture, le lecteur se charge sur place et la lecture démarre.
  function setupDemoreel() {
    const lecteur = document.querySelector<HTMLElement>('[data-demoreel]');
    const lancer = lecteur?.querySelector<HTMLButtonElement>('[data-demoreel-lancer]');
    if (!lecteur || !lancer) return;
    lancer.addEventListener('click', () => {
      if (lecteur.classList.contains('lecture')) return;
      const url = new URL(lecteur.dataset.src!);
      url.searchParams.set('autoplay', '1');
      // Vidéas : le preset du lecteur peut être « muet » et sans contrôles ; on force le son.
      if (url.hostname.endsWith('videas.fr')) {
        url.searchParams.set('mute', '0');
        url.searchParams.set('controls', '1');
      }
      const iframe = document.createElement('iframe');
      iframe.src = url.toString();
      iframe.title = 'Demoreel';
      iframe.allow = 'autoplay; fullscreen; picture-in-picture; encrypted-media';
      iframe.allowFullscreen = true;
      iframe.addEventListener('load', () => iframe.classList.add('pret'), { once: true });
      lecteur.classList.add('lecture');
      lecteur.append(iframe);
      // Le cadre grandit : on s'assure qu'il reste entièrement visible.
      setTimeout(() => lecteur.scrollIntoView({ block: 'nearest', behavior: 'smooth' }), 480);
    });
  }

  document.addEventListener('astro:page-load', setupRails);
  document.addEventListener('astro:page-load', setupFiltres);
  document.addEventListener('astro:page-load', setupDemoreel);
</script>
