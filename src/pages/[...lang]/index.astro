---
export const prerender = true;
import Layout from "../../layouts/Layout.astro";
import Signature from "../../components/Signature.astro";
import TitreSwitch from "../../components/TitreSwitch.astro";
import CarrouselHome from "../../components/CarrouselHome.astro";
import OptimizedImage from "../../components/OptimizedImage.astro";
import { getProjets } from "../../lib/contenu";
import { getItemsCarrousel } from "../../lib/carrousel";
import { descriptionDepuisTexte } from "../../lib/meta";
import { urlEmbed } from "../../lib/video";
import bandeDemo from "../../content/settings/bande-demo.json";
import { cheminsLangues, langDe, t, url, libelle, roleAffiche, roleCreation, dateFormatee } from "../../i18n";

export function getStaticPaths() {
  return cheminsLangues();
}
const lang = langDe(Astro.params);

const projets = (await getProjets(lang, ({ data }) => data.categorie === "commandes" && !data.brouillon)).sort(
  // Plus récente en premier, plus ancienne en bas (comme sur Créations).
  (a, b) => (b.data.date?.valueOf() ?? -Infinity) - (a.data.date?.valueOf() ?? -Infinity)
);

// Créations : ne servent qu'à la recherche de références (pas à la liste ni aux aperçus).
const creations = (await getProjets(lang, ({ data }) => data.categorie === "creations" && !data.brouillon)).sort(
  (a, b) => (b.data.annee ?? -Infinity) - (a.data.annee ?? -Infinity)
);
// Commandes d'abord : à critères égaux, elles passent devant les Créations dans les résultats.
// Les fiches cochées « Ne pas faire remonter dans les références » (horsRecherche) en sont exclues.
const elementsRecherche = [
  ...projets.map((p) => ({ p, creation: false })),
  ...creations.map((p) => ({ p, creation: true })),
].filter(({ p }) => !p.data.horsRecherche);

// Panneau d'aperçu (écran large + souris) : un aperçu par projet ayant une image.
// Durée : les unités (min, h, s…) sont enveloppées pour être affichées plus petites.
const echapper = (t: string) => t.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const dureeHtml = (d?: string) =>
  d ? echapper(d).replace(/[a-zA-ZÀ-ÿ]+/g, '<span class="duree-unite">$&</span>') : undefined;

const demoUrl = bandeDemo.video?.trim() ? urlEmbed(bandeDemo.video.trim()) : null;
const apercus = projets
  .map((p, index) => ({ p, index }))
  .filter(({ p }) => p.data.couverture || p.data.image1)
  .map(({ p, index }) => ({
    index,
    href: url(lang, `/projets/${p.id}`),
    titre: p.data.titre,
    image: (p.data.couverture || p.data.image1) as string,
    date: p.data.date ? dateFormatee(lang, p.data.date, { month: "long", year: "numeric" }) : undefined,
    client: p.data.client,
    accroche: p.data.accroche ?? descriptionDepuisTexte(p.body, 140),
    titreFilm: p.data.titreFilm?.trim() || undefined,
    duree: p.data.duree?.trim() || undefined,
  }));
// « Trouvez les références adaptées à vos besoins » : secteurs et besoins (champs CMS à choix).
const fichesRecherche = elementsRecherche.map(({ p }) => ({
  se: p.data.secteurs ?? [],
  be: p.data.besoins ?? [],
  fo: p.data.formats ?? [],
  to: p.data.tons ?? [],
}));
const SECTEURS = ["Mode", "Musique", "Série/Cinéma", "Art", "Culture", "Terroir / Gastronomie", "Éducation", "Sciences", "Société", "Sport", "Solidarité", "Environnement"];
const BESOINS = ["Interviews", "Mise en scène / Direction artistique", "Tournage à l'étranger", "Projet au long cours", "Images d'archives"];
// Seules les valeurs réellement utilisées par au moins une fiche sont proposées.
const secteursRecherche = SECTEURS.filter((x) => fichesRecherche.some((f) => f.se.includes(x)));
const FORMATS = ["Réseaux sociaux", "Court", "Long", "Série"];
const TONS = ["Humour", "Informatif", "Décalé", "Promotionnel"];
const tonsRecherche = TONS.filter((x) => fichesRecherche.some((f) => f.to.includes(x)));
const formatsRecherche = FORMATS.filter((x) => fichesRecherche.some((f) => f.fo.includes(x)));
const besoinsRecherche = BESOINS.filter((x) => fichesRecherche.some((f) => f.be.includes(x)));
const indexAvecApercu = new Set(apercus.map((a) => a.index));

const itemsCarrousel = await getItemsCarrousel(lang);

const titre = t(lang, "accueil.titre");
const description = t(lang, "accueil.description");

// Textes et libellés pour le script de la fenêtre de recherche (la langue de la page s'applique aussi aux messages).
const toutesValeurs = {
  univers: SECTEURS,
  critere: BESOINS,
  format: FORMATS,
  ton: TONS,
};
const libelles: Record<string, string> = {};
for (const [categorie, valeurs] of Object.entries(toutesValeurs)) {
  for (const v of valeurs) libelles[v] = libelle(lang, categorie as "univers" | "critere" | "format" | "ton", v);
}
const textesRecherche = {
  rien: t(lang, "recherche.rien"),
  exacts: t(lang, "recherche.exacts"),
  proches: t(lang, "recherche.proches"),
  univers: t(lang, "recherche.univers.etat"),
  reference: t(lang, "recherche.reference"),
  references: t(lang, "recherche.references"),
  groupes: {
    univers: t(lang, "recherche.univers"),
    criteres: t(lang, "recherche.criteres"),
    format: t(lang, "recherche.format"),
    ton: t(lang, "recherche.ton"),
  },
  libelles,
};

// N'affiche dans le filtre que les types réellement utilisés par au moins un projet.
const ORDRE_TYPES = ["Making-of", "Documentaire", "Activation / Aftermovie", "Institutionnel", "Brand Content", "RSE", "Fiction"];
const typesPresents = ORDRE_TYPES.filter((t) => projets.some((p) => p.data.type === t));
---

<Layout title={titre} description={description} currentPath="/" lang={lang}>
  <p class="sr-only">{t(lang, "accueil.sr")}</p>

  <Signature lang={lang} />

  <CarrouselHome items={itemsCarrousel} lang={lang} />

  <TitreSwitch actif="commandes" lang={lang} />

  {typesPresents.length > 0 && (
    <nav class="filtres" id="filtres" aria-label={t(lang, "filtre.aria.type")}>
      <button type="button" data-type="all" aria-pressed="true">{t(lang, "filtre.tous")}</button>
      {typesPresents.map((ty) => (
        <button type="button" data-type={ty} aria-pressed="false">{libelle(lang, "type", ty)}</button>
      ))}
      <button type="button" class="filtre-recherche" data-recherche-ouvrir aria-haspopup="dialog">{t(lang, "recherche.bouton")}</button>
    </nav>
  )}

  <div class="liste-apercu">
  <ul id="accroches" class:list={["accroches", { "sans-filtres": typesPresents.length === 0 }]}>
    {projets.map((p, index) => {
      return (
        <li data-type={p.data.type || ""} data-apercu={indexAvecApercu.has(index) ? index : undefined}>
          <a href={url(lang, `/projets/${p.id}`)}>
            <span class="accroche-titre">{p.data.titre}</span>
            {p.data.role && p.data.client ? (
              <span class="accroche-meta">{roleAffiche(lang, p.data.role)} <br class="saut-mobile" />{t(lang, "pour")} {p.data.client}</span>
            ) : (
              (p.data.role || p.data.client) && <span class="accroche-meta">{p.data.role ? roleAffiche(lang, p.data.role) : p.data.client}</span>
            )}
          </a>
        </li>
      );
    })}
  </ul>

  <aside class="apercu" aria-label={t(lang, "apercu.aria")}>
    <div class="apercu-pile">
      {demoUrl && (
        <article class="apercu-item apercu-demo" data-index="-1" data-demo>
          <p class="apercu-entete"><span class="apercu-titre-film">DEMOREEL</span>{bandeDemo.duree?.trim() && <span class="apercu-duree" set:html={dureeHtml(bandeDemo.duree.trim())} />}</p>
          <button type="button" class:list={["apercu-image", "apercu-demo-ouvrir", { "avec-image": !!bandeDemo.image }]} data-demo-ouvrir aria-haspopup="dialog" aria-label={t(lang, "apercu.demo.voir")}>
            {bandeDemo.image && <OptimizedImage src={bandeDemo.image} alt="" sizes="420px" />}
            <span class="apercu-demo-play" aria-hidden="true"></span>
          </button>
          <p class="apercu-accroche">{t(lang, "apercu.demo.texte")}</p>
        </article>
      )}
      {apercus.map((a) => (
        <article class="apercu-item" data-index={a.index}>
          {(a.titreFilm || a.duree) && (
            <p class="apercu-entete">
              {a.titreFilm && <span class="apercu-titre-film">{a.titreFilm}</span>}
              {a.duree && <span class="apercu-duree" set:html={dureeHtml(a.duree)} />}
            </p>
          )}
          <div class="apercu-image">
            <OptimizedImage src={a.image} alt="" sizes="420px" />
          </div>
          {(a.date || a.client) && (
            <p class="apercu-meta">{[a.date, a.client].filter(Boolean).join(" · ")}</p>
          )}
          {a.accroche && <p class="apercu-accroche">{a.accroche}</p>}
          <a class="apercu-fleche" href={a.href} aria-label={`${t(lang, "apercu.savoir")} : ${a.titre}`}>→</a>
        </article>
      ))}
    </div>
  </aside>
  </div>

  <dialog class="rech" id="rech" aria-labelledby="rech-titre" data-textes={JSON.stringify(textesRecherche)}>
    <button type="button" class="rech-fermer" data-rech-fermer aria-label={t(lang, "fermer")}>×</button>
    <h2 class="rech-titre" id="rech-titre">{t(lang, "recherche.titre")}</h2>
    <p class="rech-intro">{t(lang, "recherche.intro")}</p>
    <p class="rech-groupe">{t(lang, "recherche.univers")}</p>
    <div class="rech-pastilles" role="group" aria-label={t(lang, "recherche.univers")}>
      {secteursRecherche.map((m) => <button type="button" data-groupe="secteur" data-pastille={m} aria-pressed="false">{libelle(lang, "univers", m)}</button>)}
    </div>
    <p class="rech-groupe">{t(lang, "recherche.criteres")}</p>
    <div class="rech-pastilles" role="group" aria-label={t(lang, "recherche.criteres")}>
      {besoinsRecherche.map((m) => <button type="button" data-groupe="besoin" data-pastille={m} aria-pressed="false">{libelle(lang, "critere", m)}</button>)}
    </div>
    <p class="rech-groupe">{t(lang, "recherche.format")}</p>
    <div class="rech-pastilles" role="group" aria-label={t(lang, "recherche.format")}>
      {formatsRecherche.map((m) => <button type="button" data-groupe="format" data-pastille={m} aria-pressed="false">{libelle(lang, "format", m)}</button>)}
    </div>
    <p class="rech-groupe">{t(lang, "recherche.ton")}</p>
    <div class="rech-pastilles" role="group" aria-label={t(lang, "recherche.ton")}>
      {tonsRecherche.map((m) => <button type="button" data-groupe="ton" data-pastille={m} aria-pressed="false">{libelle(lang, "ton", m)}</button>)}
    </div>
    <p class="rech-etat" id="rech-etat" aria-live="polite"></p>
    <ul class="rech-resultats" id="rech-resultats">
      {elementsRecherche.map(({ p, creation }, index) => (
        <li data-index={index} hidden>
          <a href={url(lang, `/projets/${p.id}`)}>
            <span class="rech-vignette">
              {(p.data.couverture || p.data.image1) && <OptimizedImage src={(p.data.couverture || p.data.image1) as string} alt="" sizes="140px" />}
            </span>
            <span class="rech-texte">
              {creation && <span class="rech-etiquette">{t(lang, "recherche.creation")}</span>}
              <span class="rech-nom">{p.data.titre}</span>
              {creation
                ? (p.data.genre || p.data.annee) && <span class="rech-client">{[p.data.genre ? libelle(lang, "genre", p.data.genre) : undefined, p.data.annee].filter(Boolean).join(" · ")}</span>
                : p.data.client && <span class="rech-client">{p.data.client}</span>}
            </span>
            <span class="rech-go" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>
    <a class="rech-contact" href={url(lang, "/booking")}>{t(lang, "recherche.contact")} <span class="fleche">→</span></a>
    <script is:inline type="application/json" id="rech-data" set:html={JSON.stringify(fichesRecherche).replace(/</g, "\\u003c")}></script>
  </dialog>

  {demoUrl && (
    <dialog class="demo-popup" id="demo-popup" aria-label={t(lang, "demo.titre")} data-src={demoUrl}>
      <button type="button" class="demo-fermer" data-demo-fermer aria-label={t(lang, "fermer")}>×</button>
      <div class="demo-cadre"></div>
    </dialog>
  )}
</Layout>

<style>
  .filtres { display:flex; flex-wrap:wrap; justify-content:center; gap:.75rem; margin:0; }
  .filtres button {
    font-family:'Archivo', 'Inter', sans-serif; font-weight:200;
    font-size:.7rem; letter-spacing:.14em; text-transform:uppercase;
    color:rgba(var(--blanc-rgb),.5); background:transparent; cursor:pointer;
    border:1px solid rgba(var(--blanc-rgb),.3); border-radius:2px; padding:.4rem .8rem;
    transition: background 140ms ease, color 140ms ease, border-color 140ms ease;
  }
  .filtres button:hover { color:var(--blanc); border-color:var(--rouge); }
  .filtres button[aria-pressed="true"] { background:var(--blanc); color:#0b0b0b; border-color:var(--blanc); font-weight:700; }
  .accroches { list-style:none; margin:4.5rem 0 0; padding:0; display:flex; flex-direction:column; align-items:center; gap:3.575rem; }
  .accroches.sans-filtres { margin-top:5.5rem; }
  .accroches { overflow-anchor:none; }
  .accroches li[hidden] { display:none; }
  .accroches a {
    display:flex; flex-direction:column; align-items:center; gap:.6rem;
    text-decoration:none;
  }
  .accroche-titre {
    font-weight:700; font-size:clamp(1.076rem, 2.458vw, 1.536rem); line-height:1.2; /* +10 % puis -3 % */
    font-stretch:100%; /* largeur normale d'Archivo (le reste du site est resserré) */
    color:var(--blanc); white-space:nowrap; transition:color 140ms ease;
  }
  .accroches a:hover .accroche-titre { color:rgba(var(--blanc-rgb),.6); }
  @media (max-width: 700px) {
    .accroche-titre { white-space:normal; max-width:40ch; text-align:center; }
  }
  .accroche-meta {
    font-family:'Archivo', 'Inter', sans-serif; font-weight:400;
    font-size:.77rem; letter-spacing:.12em; text-transform:uppercase; color:rgba(var(--blanc-rgb),.65);
  }
  .saut-mobile { display:none; }
  @media (max-width: 800px) {
    .saut-mobile { display:inline; }
  }

  /* Écran large + souris : liste ferrée à gauche, panneau d'aperçu fixe à
     droite. Ailleurs (mobile, tablette, tactile) : liste centrée inchangée. */
  .liste-apercu { display:contents; }
  .apercu { display:none; }
  @media (min-width: 1100px) and (hover:hover) and (pointer:fine) {
    .liste-apercu {
      display:grid; grid-template-columns:minmax(0, 1fr) 420px; column-gap:5rem;
      width:100%; max-width:1240px; align-items:start;
    }
    .accroches { align-items:flex-start; }
    .accroches a { align-items:flex-start; text-align:left; }
    .accroche-titre { white-space:normal; position:relative; }

    /* Flèche « → » (comme le lien « Voir toute la playlist ») : suspendue dans
       la marge gauche au survol/focus, donc sans décalage du titre. */
    .accroche-titre::before {
      content:"→"; position:absolute; left:-1.7em; top:0; color:var(--rouge);
      opacity:0; transform:translateX(-.4em);
      transition:opacity 160ms ease, transform 160ms ease;
    }
    .accroches a:hover .accroche-titre::before,
    .accroches a:focus-visible .accroche-titre::before { opacity:1; transform:none; }

    .apercu { display:block; position:sticky; top:28px; margin-top:4.5rem; }
    .apercu-pile { display:grid; }
    .apercu-item {
      grid-area:1 / 1; align-self:start; display:flex; flex-direction:column; gap:1rem;
      box-sizing:border-box; padding:10px; border:1px solid rgba(var(--blanc-rgb),.35); border-radius:2px;
      opacity:0; visibility:hidden; transition:opacity 220ms ease, visibility 0s linear 220ms;
    }
    .apercu-item.actif { opacity:1; visibility:visible; transition-delay:0s; }
    .apercu-image {
      display:block; width:100%; padding:0; border:0; border-bottom:1px solid var(--blanc);
      aspect-ratio:16/9; overflow:hidden; border-radius:2px; background:#111;
    }
    .apercu-image :global(img) { width:100%; height:100%; object-fit:cover; display:block; }
    /* Les images ne sont demandées qu'à la première activation (classe posée en JS). */
    .apercu-item:not(.charge) .apercu-image :global(picture) { display:none; }
    /* Titre du film (champ CMS) + durée, au-dessus de l'image. */
    .apercu-entete { margin:0; display:flex; align-items:baseline; justify-content:space-between; gap:1rem; }
    .apercu-titre-film { font-weight:700; font-size:1rem; line-height:1.3; color:var(--blanc); text-transform:uppercase; }
    .apercu-duree {
      flex:none; margin-left:auto; font-weight:700; font-size:1rem; line-height:1.3;
      text-transform:uppercase; color:var(--blanc);
    }
    .apercu-duree :global(.duree-unite) { font-size:.5em; }
    .apercu-meta {
      margin:0; font-family:'Archivo', 'Inter', sans-serif; font-weight:200;
      font-size:.77rem; letter-spacing:.12em; text-transform:uppercase; color:rgba(var(--blanc-rgb),.45);
    }
    .apercu-accroche { margin:0; font-family:var(--police-texte); font-weight:400; font-size:1rem; line-height:1.6; color:rgba(var(--blanc-rgb),.8); }

    /* Flèche vers la fiche, en bas à droite du cadre. */
    .apercu-fleche {
      align-self:flex-end; margin-top:-.2rem; text-decoration:none;
      font-size:1.4rem; line-height:1; color:var(--rouge); transition:transform 140ms ease;
    }
    .apercu-fleche:hover, .apercu-fleche:focus-visible { transform:translateX(.3rem); }

    /* Encart « bande démo » : même gabarit qu'une fiche projet. */
    .apercu-demo-ouvrir { position:relative; cursor:pointer; background:linear-gradient(135deg,#1c1c1c,#0b0b0b); }
    .apercu-demo-ouvrir :global(img) { width:100%; height:100%; object-fit:cover; display:block; }
    .apercu-demo-play {
      position:absolute; top:50%; left:50%; width:64px; height:64px; margin:-32px 0 0 -32px;
      border:1px solid var(--blanc); border-radius:50%; background:rgba(0,0,0,.45);
      transition:background 140ms ease, transform 140ms ease;
    }
    .apercu-demo-play::before {
      content:""; position:absolute; top:50%; left:50%; margin:-9px 0 0 -6px;
      border-style:solid; border-width:9px 0 9px 16px; border-color:transparent transparent transparent var(--blanc);
    }
    /* Avec une image (souvent un titre au centre) : bouton lecture en bas à gauche. */
    .apercu-demo-ouvrir.avec-image .apercu-demo-play {
      top:auto; left:14px; bottom:14px; width:44px; height:44px; margin:0;
    }
    .apercu-demo-ouvrir.avec-image .apercu-demo-play::before {
      margin:-7px 0 0 -4px; border-width:7px 0 7px 12px;
    }
    .apercu-demo-ouvrir:hover .apercu-demo-play { background:rgba(var(--blanc-rgb),.18); transform:scale(1.06); }
  }

  /* « Trouver une référence » : bouton dans la rangée de filtres + fenêtre de dialogue. */
  /* Bouton plein blanc, texte noir et gras, sur tous les écrans. */
  .filtres .filtre-recherche { font-weight:700; background:var(--blanc); border-color:var(--blanc); color:#0b0b0b; text-wrap:balance; line-height:1.4; }
  .filtres .filtre-recherche:hover, .filtres .filtre-recherche:focus-visible { background:var(--rouge); border-color:var(--rouge); color:var(--blanc); }
  /* Grand écran + souris : filtres calés à gauche (comme la liste), bouton de recherche
     à droite en blanc plein. */
  @media (min-width: 1100px) and (hover:hover) and (pointer:fine) {
    .filtres { width:100%; max-width:1240px; justify-content:flex-start; }
    .filtres .filtre-recherche { margin-left:auto; box-sizing:border-box; width:420px; text-align:center; }
  }

  .rech {
    box-sizing:border-box; width:min(92vw, 640px); max-height:88vh; overflow-y:auto;
    padding:1.6rem; background:#0b0b0b; color:var(--blanc); text-align:left;
    border:1px solid rgba(var(--blanc-rgb),.35); border-radius:2px;
  }
  .rech::backdrop { background:rgba(0,0,0,.85); }
  .rech-fermer {
    position:absolute; top:.6rem; right:.9rem; padding:0; font-size:1.8rem; line-height:1;
    color:var(--blanc); background:transparent; border:0; cursor:pointer;
  }
  .rech-fermer:hover { color:rgba(var(--blanc-rgb),.6); }
  .rech-titre { margin:0 2rem .5rem 0; font-size:1.15rem; font-weight:700; text-transform:uppercase; line-height:1.3; }
  .rech-intro { margin:0 0 1.2rem; font-family:var(--police-texte); font-weight:400; font-size:.95rem; line-height:1.6; color:rgba(var(--blanc-rgb),.8); }
  .rech-groupe {
    margin:0 0 .5rem; font-family:'Archivo', 'Inter', sans-serif; font-size:.68rem;
    letter-spacing:.14em; text-transform:uppercase; font-weight:700; color:var(--blanc);
  }
  .rech-pastilles { display:flex; flex-wrap:wrap; gap:.5rem; margin-bottom:1rem; }
  .rech-pastilles button {
    font-family:'Archivo', 'Inter', sans-serif; font-weight:200;
    font-size:.7rem; letter-spacing:.14em; text-transform:uppercase;
    color:rgba(var(--blanc-rgb),.7); background:transparent; cursor:pointer;
    border:1px solid rgba(var(--blanc-rgb),.3); border-radius:2px; padding:.4rem .8rem;
  }
  .rech-pastilles button:hover { color:var(--blanc); border-color:var(--blanc); }
  .rech-pastilles button:disabled { opacity:.3; cursor:not-allowed; border-style:dashed; }
  .rech-pastilles button:disabled:hover { color:rgba(var(--blanc-rgb),.7); border-color:rgba(var(--blanc-rgb),.3); }
  .rech-pastilles button[aria-pressed="true"] { background:var(--blanc); color:#0b0b0b; border-color:var(--blanc); }
  .rech-etat { min-height:1.4em; margin:.9rem 0 .6rem; font-family:'Archivo', 'Inter', sans-serif; font-weight:200; font-size:.72rem; letter-spacing:.1em; text-transform:uppercase; color:rgba(var(--blanc-rgb),.55); }
  .rech-resultats { list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:.7rem; }
  .rech-resultats li[hidden] { display:none; }
  .rech-resultats a {
    display:flex; align-items:center; gap:1rem; padding:10px; text-decoration:none; color:var(--blanc);
    border:1px solid rgba(var(--blanc-rgb),.35); border-radius:2px; transition:border-color 140ms ease;
  }
  .rech-resultats a:hover, .rech-resultats a:focus-visible { border-color:var(--blanc); }
  .rech-vignette { flex:none; width:112px; aspect-ratio:16/9; overflow:hidden; background:#111; border-bottom:1px solid var(--blanc); }
  .rech-vignette :global(img) { width:100%; height:100%; object-fit:cover; display:block; }
  .rech-texte { flex:1; min-width:0; display:flex; flex-direction:column; gap:.25rem; }
  .rech-nom { font-weight:700; font-size:.95rem; line-height:1.3; }
  .rech-client {
    font-family:'Archivo', 'Inter', sans-serif; font-weight:200; font-size:.68rem; letter-spacing:.1em;
    text-transform:uppercase; color:rgba(var(--blanc-rgb),.5);
  }
  .rech-etiquette {
    align-self:flex-start; padding:.1rem .4rem; border:1px solid rgba(var(--blanc-rgb),.6); border-radius:2px;
    font-family:'Archivo', 'Inter', sans-serif; font-weight:200; font-size:.62rem; letter-spacing:.14em;
    text-transform:uppercase; color:var(--blanc);
  }
  .rech-go { flex:none; font-size:1.3rem; line-height:1; color:var(--rouge); transition:transform 140ms ease; }
  .rech-resultats a:hover .rech-go, .rech-resultats a:focus-visible .rech-go { transform:translateX(.3rem); }
  .rech-contact {
    display:inline-block; margin-top:1.2rem; color:var(--blanc); text-decoration:none; font-weight:700; font-size:.95rem;
    border-bottom:1px solid rgba(var(--blanc-rgb),.5); padding-bottom:.15rem;
  }
  .rech-contact:hover { border-bottom-color:var(--blanc); }
  /* Grand écran : fenêtre plus large et plus aérée, pour le confort. */
  @media (min-width: 900px) {
    .rech { width:min(92vw, 880px); max-height:92vh; padding:2.2rem 2.5rem; }
    .rech-titre { font-size:1.4rem; margin-bottom:.7rem; }
    .rech-intro { font-size:1.05rem; margin-bottom:1.7rem; }
    .rech-groupe { font-size:.76rem; margin-bottom:.65rem; }
    .rech-pastilles { gap:.6rem; margin-bottom:1.3rem; }
    .rech-pastilles button { font-size:.78rem; padding:.55rem 1rem; }
    .rech-etat { font-size:.78rem; margin:1.1rem 0 .8rem; }
    .rech-resultats { gap:.8rem; }
    .rech-resultats a { gap:1.3rem; padding:12px; }
    .rech-vignette { width:168px; }
    .rech-nom { font-size:1.1rem; }
    .rech-client { font-size:.74rem; }
    .rech-contact { margin-top:1.5rem; font-size:1rem; }
  }
  @media (max-width: 520px) {
    .rech { padding:1.1rem; }
    .rech-vignette { width:84px; }
  }

  /* Pop-up vidéo (ouverte depuis l'encart « bande démo »). */
  .demo-popup {
    padding:0; border:0; background:transparent; color:var(--blanc);
    width:min(92vw, 1100px); max-width:none; max-height:none; overflow:visible;
  }
  .demo-popup::backdrop { background:rgba(0,0,0,.85); }
  .demo-cadre { aspect-ratio:16/9; width:100%; background:#000; }
  /* L'iframe reste invisible (fond noir du cadre) jusqu'à son chargement :
     évite le flash blanc du document vide avant l'affichage du lecteur. */
  .demo-cadre :global(iframe) {
    width:100%; height:100%; border:0; display:block; background:#000; color-scheme:dark;
    opacity:0; transition:opacity 200ms ease;
  }
  .demo-cadre :global(iframe.pret) { opacity:1; }
  .demo-fermer {
    position:absolute; top:-2.6rem; right:0; width:2.2rem; height:2.2rem; padding:0;
    font-size:1.8rem; line-height:1; color:var(--blanc); background:transparent; border:0; cursor:pointer;
  }
  .demo-fermer:hover { color:rgba(var(--blanc-rgb),.6); }
  @media (prefers-reduced-motion: reduce) {
    .apercu-item, .accroche-titre::before, .apercu-fleche, .demo-cadre :global(iframe), .rech-go { transition:none !important; }
  }
</style>

<script>
  import { scrollerVersTitre } from "../../lib/positionTitre";
  
  function setupFiltres() {
    const nav = document.getElementById('filtres');
    const items = document.querySelectorAll<HTMLLIElement>('#accroches li');
    if (!nav || !items.length) return;

    nav.addEventListener('click', (event) => {
      const bouton = (event.target as HTMLElement).closest<HTMLButtonElement>('button[data-type]');
      if (!bouton) return;
      const type = bouton.dataset.type;

      nav.querySelectorAll('button[data-type]').forEach((b) => b.setAttribute('aria-pressed', String(b === bouton)));
      items.forEach((li) => {
        li.hidden = type !== 'all' && li.dataset.type !== type;
      });

      document.getElementById('accroches')?.dispatchEvent(new Event('filtre'));

      // Masquer/afficher des accroches change la hauteur de la page : on recale
      // aussitôt, dans la même image, sur la position de référence (titre en haut).
      scrollerVersTitre();
    });
  }

  function setupApercu() {
    const liste = document.getElementById('accroches');
    const panneau = document.querySelector('.apercu');
    if (!liste || !panneau || !matchMedia('(min-width: 1100px) and (hover: hover) and (pointer: fine)').matches) return;

    const fiches = [...panneau.querySelectorAll<HTMLElement>('.apercu-item')];
    const conteneur = liste.closest<HTMLElement>('.liste-apercu');
    const activer = (index: number) => {
      fiches.forEach((fiche) => {
        const actif = Number(fiche.dataset.index) === index;
        fiche.classList.toggle('actif', actif);
        if (actif) fiche.classList.add('charge');
      });
    };
    const depuis = (event: Event) => {
      const li = (event.target as HTMLElement).closest<HTMLLIElement>('li[data-apercu]');
      if (li) activer(Number(li.dataset.apercu));
    };
    // Au repos et après un filtre : l'encart « bande démo » s'il existe, sinon
    // le premier projet visible (le plus récent).
    const parDefaut = () => {
      if (panneau.querySelector('[data-demo]')) return activer(-1);
      const li = liste.querySelector<HTMLLIElement>('li[data-apercu]:not([hidden])');
      activer(li ? Number(li.dataset.apercu) : -1);
    };

    liste.addEventListener('mouseover', depuis);
    liste.addEventListener('focusin', depuis);
    liste.addEventListener('filtre', parDefaut);
    // Le curseur quitte l'ensemble liste + panneau : retour à l'encart par défaut.
    conteneur?.addEventListener('mouseleave', parDefaut);
    parDefaut();
  }

  interface FicheRecherche { se: string[]; be: string[]; fo: string[]; to: string[]; }

  function setupRecherche(fiches: FicheRecherche[]) {
    const dialogue = document.getElementById('rech') as HTMLDialogElement | null;
    const liste = document.getElementById('rech-resultats');
    const etat = document.getElementById('rech-etat');
    if (!dialogue || !liste || !etat) return;
    const lis = [...liste.querySelectorAll<HTMLLIElement>('li')];
    const pastilles = [...dialogue.querySelectorAll<HTMLButtonElement>('[data-pastille]')];

    // Textes de la langue de la page (messages, libellés), posés par le serveur sur la fenêtre.
    const T = JSON.parse(dialogue.dataset.textes ?? '{}');
    const lib = (valeur: string) => (T.libelles?.[valeur] as string | undefined) ?? valeur;

    // Un seul secteur ; plusieurs besoins possibles (les films qui en couvrent le plus remontent en premier).
    let secteur = '';
    const besoins = new Set<string>();
    const formats = new Set<string>(); // plusieurs formats possibles : un film qui en a au moins un convient
    const tons = new Set<string>(); // idem pour le ton

    // Une pastille est grisée si, avec les critères déjà choisis dans les AUTRES lignes, aucun film ne la porte :
    // elle ne mènerait qu'à zéro résultat. Les pastilles déjà cochées restent toujours cliquables (pour les retirer).
    const valeursDe = (f: FicheRecherche, g: string) => (g === 'secteur' ? f.se : g === 'besoin' ? f.be : g === 'format' ? f.fo : f.to);
    const convient = (f: FicheRecherche, sauf: string) =>
      (sauf === 'secteur' || !secteur || f.se.includes(secteur)) &&
      (sauf === 'besoin' || !besoins.size || f.be.some((x) => besoins.has(x))) &&
      (sauf === 'format' || !formats.size || f.fo.some((x) => formats.has(x))) &&
      (sauf === 'ton' || !tons.size || f.to.some((x) => tons.has(x)));
    const majDisponibilites = () => {
      pastilles.forEach((b) => {
        const g = b.dataset.groupe ?? '';
        const v = b.dataset.pastille ?? '';
        const cochee = b.getAttribute('aria-pressed') === 'true';
        b.disabled = !cochee && !fiches.some((f) => convient(f, g) && valeursDe(f, g).includes(v));
      });
    };

    const lancer = () => {
      pastilles.forEach((b) => {
        const v = b.dataset.pastille ?? '';
        const actif = b.dataset.groupe === 'secteur' ? secteur === v : b.dataset.groupe === 'besoin' ? besoins.has(v) : b.dataset.groupe === 'format' ? formats.has(v) : tons.has(v);
        b.setAttribute('aria-pressed', String(actif));
      });
      majDisponibilites();
      lis.forEach((li) => { li.hidden = true; });
      if (!secteur && !besoins.size && !formats.size && !tons.size) {
        etat.textContent = '';
        return;
      }

      const candidats = fiches
        .map((f, index) => ({ index, couverts: f.be.filter((x) => besoins.has(x)).length }))
        .filter((r) => (!secteur || fiches[r.index].se.includes(secteur)) && (!besoins.size || r.couverts > 0) && (!formats.size || fiches[r.index].fo.some((x) => formats.has(x))) && (!tons.size || fiches[r.index].to.some((x) => tons.has(x))))
        .sort((a, b) => b.couverts - a.couverts || a.index - b.index); // à égalité : le plus récent d'abord

      const retenus = candidats.slice(0, 5);
      if (!retenus.length) {
        etat.textContent = T.rien ?? "Rien qui croise ces critères pour l'instant. Essayez d'autres critères, ou parlons de votre projet.";
        return;
      }
      // « 5/8 » quand il y a plus de correspondances que de résultats affichés.
      const tronque = candidats.length > retenus.length;
      const compte = tronque ? `${retenus.length}/${candidats.length}` : `${retenus.length}`;
      etat.textContent = !besoins.size
        ? `${secteur ? `${T.univers ?? 'Univers'} ${lib(secteur)} · ` : ''}${compte} ${retenus.length > 1 ? (T.references ?? 'références') : (T.reference ?? 'référence')}`
        : `${retenus[0].couverts === besoins.size ? (T.exacts ?? 'Les références qui répondent à vos critères') : (T.proches ?? 'Les références les plus proches de vos critères')}${tronque ? ` · ${compte}` : ''}`;

      retenus.forEach((r) => {
        const li = lis[r.index];
        li.hidden = false;
        liste.appendChild(li); // dans l'ordre du classement
      });
    };

    // La sélection (références affichées + critères) est mémorisée à chaque changement : le formulaire Booking
    // la reprend, que le prospect y aille par « Parlons de votre projet » ou par le menu.
    const memoriser = () => {
      try {
        const references = lis
          .filter((li) => !li.hidden)
          .map((li) => ({
            titre: li.querySelector('.rech-nom')?.textContent?.trim() ?? '',
            chemin: li.querySelector('a')?.getAttribute('href') ?? '',
            creation: !!li.querySelector('.rech-etiquette'),
          }))
          .filter((r) => r.titre && r.chemin);
        const criteres = [
          secteur && `${T.groupes?.univers ?? 'Univers'} : ${lib(secteur)}`,
          besoins.size && `${T.groupes?.criteres ?? 'Critères'} : ${[...besoins].map(lib).join(', ')}`,
          formats.size && `${T.groupes?.format ?? 'Format/Durée'} : ${[...formats].map(lib).join(', ')}`,
          tons.size && `${T.groupes?.ton ?? 'Ton'} : ${[...tons].map(lib).join(', ')}`,
        ].filter(Boolean).join(' · ');
        if (references.length) sessionStorage.setItem('references-booking', JSON.stringify({ references, criteres }));
        else sessionStorage.removeItem('references-booking');
      } catch {
        /* stockage indisponible : le formulaire s'affichera simplement sans références */
      }
    };

    document.querySelectorAll('[data-recherche-ouvrir]').forEach((b) =>
      b.addEventListener('click', () => dialogue.showModal())
    );
    dialogue.querySelector('[data-rech-fermer]')?.addEventListener('click', () => dialogue.close());
    dialogue.addEventListener('click', (e) => { if (e.target === dialogue) dialogue.close(); });
    pastilles.forEach((b) =>
      b.addEventListener('click', () => {
        const valeur = b.dataset.pastille ?? '';
        if (b.dataset.groupe === 'secteur') secteur = secteur === valeur ? '' : valeur;
        else {
          const ensemble = b.dataset.groupe === 'besoin' ? besoins : b.dataset.groupe === 'format' ? formats : tons;
          if (ensemble.has(valeur)) ensemble.delete(valeur);
          else ensemble.add(valeur);
        }
        lancer();
        memoriser();
      })
    );
  }

  function setupDemo() {
    const popup = document.getElementById('demo-popup') as HTMLDialogElement | null;
    if (!popup) return;
    const cadre = popup.querySelector<HTMLElement>('.demo-cadre')!;
    const ouvrir = () => {
      const url = new URL(popup.dataset.src!);
      url.searchParams.set('autoplay', '1');
      // Vidéas : le preset du lecteur peut être « muet » et sans contrôles ; on force le son.
      if (url.hostname.endsWith('videas.fr')) {
        url.searchParams.set('mute', '0');
        url.searchParams.set('controls', '1');
      }
      const iframe = document.createElement('iframe');
      iframe.src = url.toString();
      iframe.title = 'Demoreel';
      iframe.allow = 'autoplay; fullscreen; picture-in-picture; encrypted-media';
      iframe.allowFullscreen = true;
      iframe.addEventListener('load', () => iframe.classList.add('pret'), { once: true });
      cadre.replaceChildren(iframe);
      popup.showModal();
    };
    document.querySelectorAll('[data-demo-ouvrir]').forEach((b) => b.addEventListener('click', ouvrir));
    popup.querySelector('[data-demo-fermer]')?.addEventListener('click', () => popup.close());
    // Clic sur le fond sombre = fermeture.
    popup.addEventListener('click', (e) => { if (e.target === popup) popup.close(); });
    // Vide l'iframe à la fermeture pour couper le son.
    popup.addEventListener('close', () => cadre.replaceChildren());
  }

  document.addEventListener('astro:page-load', setupFiltres);
  document.addEventListener('astro:page-load', setupApercu);
  document.addEventListener('astro:page-load', setupDemo);
  document.addEventListener('astro:page-load', () => {
    const brut = document.getElementById('rech-data')?.textContent;
    if (brut) setupRecherche(JSON.parse(brut) as FicheRecherche[]);
  });
</script>
