---
export const prerender = true;
import Layout from "../../layouts/Layout.astro";
import FormContact from "../../components/FormContact.astro";
import { cheminsLangues, langDe, t } from "../../i18n";

export function getStaticPaths() {
  return cheminsLangues();
}
const lang = langDe(Astro.params);

const titre = t(lang, "booking.titre.page");
const description = t(lang, "booking.description");
---

{/* Page Contact (adresse /booking conservée) : le formulaire simple du pied de page (qui, lui, est masqué sur cette page),
   complété ici d'un message libre et de pièces jointes facultatifs. */}
<Layout title={titre} description={description} currentPath="/booking" lang={lang}>
  <h1 class="titre-page">{t(lang, "booking.titre")}</h1>
  <div class="contact-page">
    <FormContact lang={lang} complet />
  </div>
</Layout>

<style>
  .contact-page { width:100%; display:flex; justify-content:center; text-align:left; }
</style>
