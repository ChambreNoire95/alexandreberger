---
export const prerender = true;
import Layout from "../../layouts/Layout.astro";
import { cheminsLangues, langDe, t, libellesRecherche } from "../../i18n";
import { heuresRappel } from "../../lib/creneau";

export function getStaticPaths() {
  return cheminsLangues();
}
const lang = langDe(Astro.params);
const heures = heuresRappel(); // liste déroulante du rappel, par pas de 15 min
const libelleHeure = (h: string) => (lang === "fr" ? h.replace(":", "h") : h);

const titre = t(lang, "booking.titre.page");
const description = t(lang, "booking.description");

// Textes nécessaires au script (messages d'envoi, étiquettes de références) : passés en JSON au formulaire.
const textesScript = {
  lang,
  creation: t(lang, "booking.creation"),
  retirer: t(lang, "booking.references.retirer"),
  envoyer: t(lang, "booking.envoyer"),
  envoi: t(lang, "booking.envoi"),
  ok: t(lang, "booking.ok"),
  erreur: t(lang, "booking.erreur"),
  erreurReseau: t(lang, "booking.erreur.reseau"),
  // Pour reconstruire la ligne de critères (venue de la recherche d'accueil) dans la langue de CETTE page.
  groupes: {
    univers: t(lang, "recherche.univers"),
    criteres: t(lang, "recherche.criteres"),
    format: t(lang, "recherche.format"),
    ton: t(lang, "recherche.ton"),
  },
  libelles: libellesRecherche(lang),
};

const textesRappel = {
  lang,
  envoyer: t(lang, "rappel.envoyer"),
  envoi: t(lang, "booking.envoi"),
  ok: t(lang, "rappel.ok"),
  erreur: t(lang, "booking.erreur"),
  erreurReseau: t(lang, "booking.erreur.reseau"),
};
---

<Layout title={titre} description={description} currentPath="/booking" lang={lang}>
  <h1 class="titre-page">{t(lang, "booking.titre")}</h1>

  <div class="booking">
    {/* Mobile / petites fenêtres : étape de choix avant d'afficher un des deux formulaires (sur desktop, les deux sont côte à côte). */}
    <div class="choix">
      <button type="button" class="choix-bouton" data-choix="complet"><span>{t(lang, "booking.choix.complet")}</span><span class="fleche" aria-hidden="true">→</span></button>
      <p class="choix-ou">{t(lang, "booking.choix.ou")}</p>
      <button type="button" class="choix-bouton" data-choix="rappel"><span>{t(lang, "booking.choix.rappel")}</span><span class="fleche" aria-hidden="true">→</span></button>
    </div>
    <button type="button" class="changer"><span class="fleche" aria-hidden="true">←</span> {t(lang, "booking.choix.changer")}</button>
    <noscript><style is:inline>@media (max-width:900px){.booking .choix,.booking .changer{display:none!important}.booking .principal,.booking .rappel{display:block!important}}</style></noscript>

   <div class="principal">
    <p class="intro">{t(lang, "booking.intro")}</p>

    <form id="form-booking" data-textes={JSON.stringify(textesScript)}>
      <input
        type="text"
        name="site"
        class="piege"
        tabindex="-1"
        autocomplete="off"
        aria-hidden="true"
      />

      <label class="champ">
        <span>{t(lang, "booking.entreprise")}</span>
        <input type="text" name="entreprise" required />
      </label>

      <div class="ligne">
        <label class="champ">
          <span>{t(lang, "booking.nom")}</span>
          <input type="text" name="nom" required />
        </label>
        <label class="champ">
          <span>{t(lang, "booking.prenom")}</span>
          <input type="text" name="prenom" required />
        </label>
      </div>

      <label class="champ">
        <span>{t(lang, "booking.fonction")}</span>
        <input type="text" name="fonction" required />
      </label>

      <div class="ligne">
        <label class="champ">
          <span>{t(lang, "booking.email")}</span>
          <input type="email" name="email" required />
        </label>
        <label class="champ">
          <span>{t(lang, "booking.telephone")}</span>
          <input type="tel" name="telephone" required />
        </label>
      </div>

      <div class="ligne">
        <label class="champ">
          <span>{t(lang, "booking.type")}</span>
          <select name="type">
            <option value="Documentaire">{t(lang, "booking.type.documentaire")}</option>
            <option value="Fiction">{t(lang, "booking.type.fiction")}</option>
            <option value="Film de marque">{t(lang, "booking.type.marque")}</option>
            <option value="Autre">{t(lang, "booking.type.autre")}</option>
          </select>
        </label>
        <label class="champ">
          <span>{t(lang, "booking.duree")}</span>
          <input type="text" name="duree" />
        </label>
      </div>

      <div class="ligne">
        <label class="champ">
          <span>{t(lang, "booking.date")}</span>
          <input type="date" name="date" />
        </label>
        <label class="champ">
          <span>{t(lang, "booking.lieu")}</span>
          <input type="text" name="lieu" />
        </label>
      </div>

      <label class="champ">
        <span>{t(lang, "booking.budget")}</span>
        <input type="text" name="budget" />
      </label>

      <section class="champ references" id="references-booking" hidden>
        <span>{t(lang, "booking.references")}</span>
        <p class="references-intro">{t(lang, "booking.references.intro")}</p>
        <p class="references-criteres"></p>
        <ul class="references-liste"></ul>
      </section>

      <label class="champ">
        <span>{t(lang, "booking.description")}</span>
        <textarea name="description" rows="6" placeholder={t(lang, "booking.description.placeholder")} required></textarea>
      </label>

      <button type="submit">{t(lang, "booking.envoyer")}</button>
      <p class="statut" role="status" hidden></p>
    </form>
   </div>

    <section class="rappel" aria-labelledby="titre-rappel">
      <h2 class="titre-rappel" id="titre-rappel"><span class="fleche" aria-hidden="true">→</span> {t(lang, "rappel.titre")}</h2>

      <form id="form-rappel" data-textes={JSON.stringify(textesRappel)}>
        <input type="text" name="site" class="piege" tabindex="-1" autocomplete="off" aria-hidden="true" />

        <label class="champ">
          <span>{t(lang, "rappel.nom")}</span>
          <input type="text" name="nom" autocomplete="name" required />
        </label>

        <label class="champ">
          <span>{t(lang, "rappel.fonction")}</span>
          <input type="text" name="fonction" autocomplete="organization-title" required />
        </label>

        <label class="champ">
          <span>{t(lang, "rappel.telephone")}</span>
          <input type="tel" name="telephone" autocomplete="tel" required />
        </label>

        <label class="champ">
          <span>{t(lang, "booking.email")}</span>
          <input type="email" name="email" autocomplete="email" required />
        </label>

        <div class="champ">
          <span>{t(lang, "rappel.quand")}</span>
          <div class="ligne">
            <input type="date" name="date" aria-label={t(lang, "booking.date")} required />
            <select name="heure" aria-label={t(lang, "rappel.heure")} required>
              <option value="" disabled selected>{t(lang, "rappel.heure")}</option>
              {heures.map((h) => <option value={h}>{libelleHeure(h)}</option>)}
            </select>
          </div>
          <small class="note">{t(lang, "rappel.quand.note")}</small>
        </div>

        <button type="submit">{t(lang, "rappel.envoyer")}</button>
        <p class="statut" role="status" hidden></p>
      </form>
    </section>
  </div>
</Layout>

<script>
  function initFormBooking() {
    const form = document.getElementById("form-booking") as HTMLFormElement | null;
    if (!form) return;

    // Textes de la langue de la page (messages, étiquettes), posés par le serveur sur le formulaire.
    const T = JSON.parse(form.dataset.textes ?? "{}") as Record<string, any>;
    const bloc = document.getElementById("references-booking");
    const liste = bloc?.querySelector<HTMLUListElement>(".references-liste");
    const criteresEl = bloc?.querySelector<HTMLElement>(".references-criteres");
    let references: { titre: string; chemin: string; creation: boolean }[] = [];
    let criteres = "";

    function afficherReferences() {
      if (!bloc || !liste || !criteresEl) return;
      liste.replaceChildren();
      references.forEach((ref, index) => {
        const li = document.createElement("li");
        const lien = document.createElement("a");
        lien.href = ref.chemin;
        lien.target = "_blank";
        lien.rel = "noopener";
        lien.textContent = ref.titre;
        li.append(lien);
        if (ref.creation) {
          const etiquette = document.createElement("em");
          etiquette.textContent = T.creation ?? "Création";
          li.append(etiquette);
        }
        const retirer = document.createElement("button");
        retirer.type = "button";
        retirer.className = "retirer";
        retirer.setAttribute("aria-label", `${T.retirer ?? "Retirer"} ${ref.titre}`);
        retirer.textContent = "×";
        retirer.addEventListener("click", () => {
          references.splice(index, 1);
          afficherReferences();
        });
        li.append(retirer);
        liste.append(li);
      });
      criteresEl.textContent = criteres;
      criteresEl.hidden = !criteres;
      bloc.hidden = references.length === 0;
    }

    // Sélection emportée depuis « Parlons de votre projet » (page d'accueil).
    try {
      const brut = sessionStorage.getItem("references-booking");
      if (brut) {
        const stocke = JSON.parse(brut);
        if (Array.isArray(stocke.references)) {
          references = stocke.references.filter((r: { titre?: unknown; chemin?: unknown }) => typeof r.titre === "string" && typeof r.chemin === "string");
          criteres = typeof stocke.criteres === "string" ? stocke.criteres : "";
          // La ligne de critères est reconstruite dans la langue de CETTE page (le visiteur a pu changer de langue
          // depuis sa recherche) ; à défaut de sélection brute, on garde le texte tel que mémorisé.
          const sel = stocke.selection;
          if (sel && typeof sel === "object") {
            const lib = (v: string) => (T.libelles as unknown as Record<string, string> | undefined)?.[v] ?? v;
            const g = (T.groupes ?? {}) as unknown as Record<string, string>;
            const liste = (a: unknown) => (Array.isArray(a) ? (a as string[]) : []);
            const morceaux = [
              typeof sel.univers === "string" && sel.univers && `${g.univers} : ${lib(sel.univers)}`,
              liste(sel.criteres).length && `${g.criteres} : ${liste(sel.criteres).map(lib).join(", ")}`,
              liste(sel.format).length && `${g.format} : ${liste(sel.format).map(lib).join(", ")}`,
              liste(sel.ton).length && `${g.ton} : ${liste(sel.ton).map(lib).join(", ")}`,
            ].filter(Boolean);
            if (morceaux.length) criteres = morceaux.join(" · ");
          }
        }
      }
    } catch {
      references = [];
    }
    afficherReferences();

    // Mobile : étape de choix. Qui arrive avec une sélection de références (recherche d'accueil) va directement au formulaire complet ;
    // #rappel dans l'adresse ouvre directement le rappel.
    const booking = document.querySelector<HTMLElement>(".booking");
    if (booking) {
      booking.dataset.mode = location.hash === "#rappel" ? "rappel" : references.length ? "complet" : "choix";
      booking.querySelectorAll<HTMLButtonElement>("[data-choix]").forEach((b) =>
        b.addEventListener("click", () => {
          booking.dataset.mode = b.dataset.choix ?? "choix";
          booking.scrollIntoView({ block: "start", behavior: "smooth" });
        })
      );
      booking.querySelector(".changer")?.addEventListener("click", () => {
        booking.dataset.mode = "choix";
        booking.scrollIntoView({ block: "start", behavior: "smooth" });
      });
    }

    const bouton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const statut = form.querySelector<HTMLElement>(".statut");

    function afficherStatut(message: string, succes: boolean) {
      if (!statut) return;
      statut.hidden = false;
      statut.textContent = message;
      statut.classList.toggle("statut-erreur", !succes);
    }

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (bouton) {
        bouton.disabled = true;
        bouton.textContent = T.envoi ?? "Envoi en cours…";
      }

      const donnees: Record<string, FormDataEntryValue> = Object.fromEntries(new FormData(form).entries());
      donnees.lang = T.lang ?? "fr"; // langue des e-mails envoyés (voir src/pages/api/booking.ts)
      if (references.length) {
        donnees.references = references
          .map((r) => `- ${r.titre}${r.creation ? ` (${(T.creation ?? "création").toLowerCase()})` : ""} : ${location.origin}${r.chemin}`)
          .join("\n");
        if (criteres) donnees.criteres = criteres;
      }

      try {
        const reponse = await fetch("/api/booking", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(donnees),
        });
        const resultat = await reponse.json();

        if (reponse.ok && resultat.ok) {
          afficherStatut(T.ok ?? "Votre demande a bien été envoyée.", true);
          form.reset();
          references = [];
          criteres = "";
          afficherReferences();
          try { sessionStorage.removeItem("references-booking"); } catch { /* sans effet */ }
        } else {
          afficherStatut(resultat.erreur || T.erreur || "Une erreur est survenue. Merci de réessayer.", false);
        }
      } catch {
        afficherStatut(T.erreurReseau ?? "Une erreur est survenue. Vérifiez votre connexion et réessayez.", false);
      } finally {
        if (bouton) {
          bouton.disabled = false;
          bouton.textContent = T.envoyer ?? "Envoyer la demande";
        }
      }
    });
  }

  // Second formulaire : « Vous préférez être rappelé ? » (nom, structure, téléphone, créneau).
  function initFormRappel() {
    const form = document.getElementById("form-rappel") as HTMLFormElement | null;
    if (!form) return;
    const T = JSON.parse(form.dataset.textes ?? "{}") as Record<string, string>;
    const bouton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const statut = form.querySelector<HTMLElement>(".statut");

    // Desktop (deux colonnes) : la première case de réponse du petit formulaire est alignée exactement sur celle du
    // grand formulaire (les rangées suivantes suivent, elles ont le même pas). On mesure puis on ajuste l'espace sous le titre.
    const titre = document.getElementById("titre-rappel");
    const alignerRappel = () => {
      const premier = document.querySelector<HTMLElement>('#form-booking .champ input:not(.piege), #form-booking .champ select');
      const mien = form.querySelector<HTMLElement>(".champ input");
      if (!titre || !premier || !mien) return;
      titre.style.setProperty("--decalage", "0px");
      if (!window.matchMedia("(min-width: 901px)").matches) return;
      const ecart = premier.getBoundingClientRect().top - mien.getBoundingClientRect().top;
      // borné : on ne peut pas réduire l'espace de base (1.25rem) en dessous de ~4 px
      titre.style.setProperty("--decalage", `${Math.max(ecart, -16)}px`);
    };
    alignerRappel();
    window.addEventListener("resize", alignerRappel);
    document.fonts?.ready.then(alignerRappel);

    // Pas de créneau dans le passé.
    const dateEl = form.querySelector<HTMLInputElement>('input[name="date"]');
    if (dateEl) {
      const auj = new Date();
      dateEl.min = `${auj.getFullYear()}-${String(auj.getMonth() + 1).padStart(2, "0")}-${String(auj.getDate()).padStart(2, "0")}`;
    }

    function afficherStatut(message: string, succes: boolean) {
      if (!statut) return;
      statut.hidden = false;
      statut.textContent = message;
      statut.classList.toggle("statut-erreur", !succes);
    }

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (bouton) {
        bouton.disabled = true;
        bouton.textContent = T.envoi ?? "Envoi en cours…";
      }
      const donnees: Record<string, FormDataEntryValue> = Object.fromEntries(new FormData(form).entries());
      donnees.lang = T.lang ?? "fr";
      try {
        const reponse = await fetch("/api/rappel", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(donnees),
        });
        const resultat = await reponse.json();
        if (reponse.ok && resultat.ok) {
          afficherStatut(T.ok ?? "Votre demande de rappel a bien été envoyée.", true);
          form.reset();
        } else {
          afficherStatut(resultat.erreur || T.erreur || "Une erreur est survenue. Merci de réessayer.", false);
        }
      } catch {
        afficherStatut(T.erreurReseau ?? "Une erreur est survenue. Vérifiez votre connexion et réessayez.", false);
      } finally {
        if (bouton) {
          bouton.disabled = false;
          bouton.textContent = T.envoyer ?? "Être rappelé";
        }
      }
    });
  }

  document.addEventListener("astro:page-load", initFormBooking);
  document.addEventListener("astro:page-load", initFormRappel);
</script>

<style>
  .booking { width:100%; max-width:640px; text-align:left; margin-top:0; }
  .principal { min-width:0; }
  .intro { font-family:var(--police-texte); font-weight:400; font-size:1rem; line-height:1.6; color:rgba(var(--blanc-rgb),.65); margin:0 0 3rem; }

  form { display:flex; flex-direction:column; gap:1.75rem; }
  .ligne { display:grid; grid-template-columns:1fr 1fr; gap:1.5rem; }
  .champ { display:flex; flex-direction:column; gap:.6rem; }
  .champ span {
    font-family:'Archivo', 'Inter', sans-serif; font-weight:200;
    font-size:.7rem; letter-spacing:.12em; text-transform:uppercase; color:rgba(var(--blanc-rgb),.5);
  }
  .champ input, .champ select, .champ textarea {
     font-size:.95rem; font-family:var(--police-texte); font-weight:400; color:var(--blanc);
    background:transparent; border:1px solid rgba(var(--blanc-rgb),.3); border-radius:2px;
    padding:.85rem 1rem; transition:border-color 140ms ease;
  }
  .champ input:focus, .champ select:focus, .champ textarea:focus {
    outline:none; border-color:rgba(var(--blanc-rgb),.8);
  }
  .champ textarea { resize:vertical; font-family:'Archivo', 'Inter', sans-serif; }
  .champ select { appearance:none; cursor:pointer; }
  .champ select option { background:#0b0b0b; color:var(--blanc); }
  /* Sélecteurs natifs de date et d'heure : pictogrammes et fenêtre en thème sombre. */
  .champ input[type="date"], .champ select[name="heure"] { color-scheme:dark; min-height:3.1rem; }
  .champ select[name="heure"] {
    padding-right:2.4rem;
    background-image:linear-gradient(45deg, transparent 50%, rgba(241,238,232,.7) 50%), linear-gradient(135deg, rgba(241,238,232,.7) 50%, transparent 50%);
    background-position:calc(100% - 1.15rem) 50%, calc(100% - .8rem) 50%; background-size:.4rem .4rem; background-repeat:no-repeat;
  }
  .note { font-family:var(--police-texte); font-size:.8rem; color:rgba(var(--blanc-rgb),.45); }

  /* Second formulaire (rappel) : encadré, fond noir à 90 %. Sous le premier sur mobile / petite fenêtre. */
  .rappel {
    margin-top:4rem; padding:2rem 2rem 2.5rem;
    background:rgba(0,0,0,.9); border:1px solid rgba(var(--blanc-rgb),.3); border-radius:2px;
  }
  /* Desktop : page en deux colonnes, 2/3 pour la demande détaillée, 1/3 pour le rappel, alignés en haut. */
  @media (min-width: 901px) {
    .booking { max-width:1120px; display:grid; grid-template-columns:minmax(0,2fr) minmax(0,1fr); gap:0 3.5rem; align-items:start; }
    .rappel { margin-top:0; }
    .rappel .ligne { grid-template-columns:1fr; gap:1rem; }
  }
  .titre-rappel {
    font-family:'Archivo', 'Inter', sans-serif; font-weight:700; font-size:1.35rem;
    letter-spacing:.02em; color:var(--blanc); text-align:center; text-wrap:balance;
    /* Espace sous le titre : base + --decalage (px), calculé par le script pour que les cases de réponse
       s'alignent exactement sur celles du grand formulaire (voir alignerRappel). */
    margin:0 0 calc(1.25rem + var(--decalage, 0px));
  }
  .titre-rappel :global(.fleche) { font-family:'Inter', sans-serif; font-weight:400; }

  /* Bouton d'envoi : toujours en gras ; au survol, rouge du site avec texte blanc. */
  button[type="submit"] {
    margin-top:.5rem; padding:1.1rem 2.4rem; align-self:flex-start;
    font-family:'Archivo', 'Inter', sans-serif; font-weight:700;
    font-size:.85rem; letter-spacing:.18em; text-transform:uppercase;
    color:#0b0b0b; background:var(--blanc); border:1px solid var(--blanc); border-radius:2px;
    cursor:pointer; transition:background 140ms ease, color 140ms ease, border-color 140ms ease;
  }
  button[type="submit"]:hover:not(:disabled) { background:var(--rouge); border-color:var(--rouge); color:var(--blanc); }

  .references { gap:.7rem; }
  .references-intro { margin:0; font-family:var(--police-texte); font-weight:400; font-size:.9rem; line-height:1.5; color:rgba(var(--blanc-rgb),.65); }
  .references-criteres {
    margin:0; font-family:'Archivo', 'Inter', sans-serif; font-weight:200; font-size:.68rem;
    letter-spacing:.1em; text-transform:uppercase; color:rgba(var(--blanc-rgb),.5);
  }
  .references-liste { list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:.5rem; }
  .references-liste :global(li) {
    display:flex; align-items:center; gap:.7rem; padding:.6rem .8rem;
    border:1px solid rgba(var(--blanc-rgb),.3); border-radius:2px;
  }
  .references-liste :global(a) { flex:1; color:var(--blanc); font-weight:700; font-size:.95rem; text-decoration:none; }
  .references-liste :global(a:hover) { text-decoration:underline; }
  .references-liste :global(em) {
    font-style:normal; padding:.1rem .4rem; border:1px solid rgba(var(--blanc-rgb),.6); border-radius:2px;
    font-family:'Archivo', 'Inter', sans-serif; font-weight:200; font-size:.62rem; letter-spacing:.14em;
    text-transform:uppercase; color:var(--blanc);
  }
  .references-liste :global(.retirer) {
    padding:0 .3rem; font-size:1.4rem; line-height:1; color:var(--blanc); background:transparent; border:0; cursor:pointer;
  }
  .references-liste :global(.retirer:hover) { color:rgba(var(--blanc-rgb),.6); }

  .statut { font-family:var(--police-texte); font-weight:400; font-size:.9rem; color:rgba(var(--blanc-rgb),.6); margin:0; }
  .statut-erreur { color:#e11d2e; }
  .piege {
    position:absolute; width:1px; height:1px; padding:0; margin:-1px;
