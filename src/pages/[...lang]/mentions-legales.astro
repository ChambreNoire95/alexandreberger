---
export const prerender = true;
import Layout from "../../layouts/Layout.astro";
import { cheminsLangues, langDe, t } from "../../i18n";

export function getStaticPaths() {
  return cheminsLangues();
}
const lang = langDe(Astro.params);

const titre = t(lang, "mentions.titre.page");
const description = t(lang, "mentions.description");
---

<Layout title={titre} description={description} currentPath="/mentions-legales" lang={lang}>
  {lang === "fr" ? (
    <div class="contenu">
      <h1>Mentions légales</h1>

      <h2 class="sous-titre">Éditeur du site</h2>
      <p>
        Le site alexandreberger.com est édité par Alexandre Berger, entreprise individuelle.<br />
        SIRET : 751 024 621 00060<br />
        Adresse : 4 Boulevard Vercingétorix, 95100 Argenteuil<br />
        Contact : <a href="mailto:contact@alexandreberger.com">contact@alexandreberger.com</a>
      </p>

      <h2 class="sous-titre">Directeur de la publication</h2>
      <p>Alexandre Berger.</p>

      <h2 class="sous-titre">Hébergement</h2>
      <p>
        Le site est hébergé par Vercel Inc.<br />
        340 S Lemon Ave #4133, Walnut, CA 91789, États-Unis
      </p>

      <h2 class="sous-titre">Propriété intellectuelle</h2>
      <p>
        L'ensemble des contenus présents sur ce site (textes, photographies, vidéos, identité visuelle) est
        la propriété d'Alexandre Berger, sauf mention contraire. Toute reproduction ou représentation, totale
        ou partielle, sans autorisation préalable est interdite.
      </p>

      <h2 class="sous-titre">Données personnelles</h2>
      <p>
        Les informations transmises via le formulaire Booking (nom, prénom, entreprise, email, téléphone et
        détails de la demande) sont utilisées uniquement pour traiter votre demande de prestation et vous
        répondre. Elles ne sont ni cédées ni utilisées à des fins commerciales par des tiers.
      </p>
      <p>
        Conformément au RGPD, vous disposez d'un droit d'accès, de rectification et de suppression de vos
        données, que vous pouvez exercer en écrivant à {" "}
        <a href="mailto:contact@alexandreberger.com">contact@alexandreberger.com</a>.
      </p>

      <h2 class="sous-titre">Cookies et navigation</h2>
      <p>
        Ce site ne dépose pas de cookie de mesure d'audience ni de traceur publicitaire. La page "Autour du
        monde" affiche une carte dont les fonds sont fournis par OpenStreetMap ; leur affichage peut entraîner
        des requêtes vers ce service tiers.
      </p>
    </div>
  ) : (
    <div class="contenu">
      <h1>Legal notice</h1>
      <p>
        This is an English translation provided for information. The French version of this notice is the
        reference, and the site is published under French law.
      </p>

      <h2 class="sous-titre">Publisher</h2>
      <p>
        The website alexandreberger.com is published by Alexandre Berger, sole proprietorship.<br />
        SIRET: 751 024 621 00060<br />
        Address: 4 Boulevard Vercingétorix, 95100 Argenteuil, France<br />
        Contact: <a href="mailto:contact@alexandreberger.com">contact@alexandreberger.com</a>
      </p>

      <h2 class="sous-titre">Publication director</h2>
      <p>Alexandre Berger.</p>

      <h2 class="sous-titre">Hosting</h2>
      <p>
        The website is hosted by Vercel Inc.<br />
        340 S Lemon Ave #4133, Walnut, CA 91789, United States
      </p>

      <h2 class="sous-titre">Intellectual property</h2>
      <p>
        All content on this website (texts, photographs, videos, visual identity) is the property of
        Alexandre Berger, unless otherwise stated. Any reproduction or representation, in whole or in part,
        without prior permission is prohibited.
      </p>

      <h2 class="sous-titre">Personal data</h2>
      <p>
        The information sent through the Booking form (last name, first name, company, email, phone number and
        details of the request) is used solely to process your request for services and to reply to you. It is
        neither transferred to nor used for commercial purposes by third parties.
      </p>
      <p>
        In accordance with the GDPR, you have the right to access, rectify and delete your data, which you can
        exercise by writing to {" "}
        <a href="mailto:contact@alexandreberger.com">contact@alexandreberger.com</a>.
      </p>

      <h2 class="sous-titre">Cookies and browsing</h2>
      <p>
        This website does not set any audience-measurement cookie or advertising tracker. The "Around the
        world" page displays a map whose backgrounds are provided by OpenStreetMap; displaying it may trigger
        requests to this third-party service.
      </p>
    </div>
  )}
</Layout>

<style>
  .contenu { text-align:left; width:100%; max-width:640px; margin-top:3.5rem; font-family:var(--police-texte); font-weight:400; font-size:1.1rem; color:rgba(var(--blanc-rgb),.72); }
  .contenu h1 { font-weight:300; font-size:clamp(1.6rem, 3vw, 2.4rem); margin:0 0 1.25rem; color:var(--blanc); }
  .contenu p { margin:0 0 1.5rem; font-size:1rem; line-height:1.7; }
  .contenu a { color:var(--blanc); }
  .sous-titre {
    font-family:'Archivo', 'Inter', sans-serif;
    font-size:.75rem; letter-spacing:.15em; text-transform:uppercase;
    color:rgba(var(--blanc-rgb),.45); font-weight:400;
    margin:2.5rem 0 1rem;
  }
  .sous-titre:first-of-type { margin-top:2.5rem; }
</style>
