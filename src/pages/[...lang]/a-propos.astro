---
export const prerender = true;
import Layout from "../../layouts/Layout.astro";
import { cheminsLangues, langDe, t } from "../../i18n";

export function getStaticPaths() {
  return cheminsLangues();
}
const lang = langDe(Astro.params);

const titre = t(lang, "apropos.titre.page");
const description = t(lang, "apropos.description");

// Récompenses : le nom du festival et du film restent tels quels, seul le palmarès est traduit.
const texte = {
  fr: {
    titre: "À propos",
    intro:
      "Réalisateur basé en Île-de-France, je navigue entre documentaire, film de marque et récit institutionnel, du brief à la livraison : écriture, production, réalisation, montage. Ce travail m'a amené à tourner en France, en Europe, en Afrique australe et au Japon, seul ou au sein d'équipes de production plus importantes.",
    prix: "Récompenses et Sélections",
  },
  en: {
    titre: "About",
    intro:
      "Director based in the Paris region, I move between documentary, branded film and institutional storytelling, from brief to delivery: writing, production, directing, editing. This work has taken me to shoot in France, Europe, southern Africa and Japan, alone or as part of larger production teams.",
    prix: "Awards and Selections",
  },
}[lang];

const prix = [
  {
    titre: "Grand Prix Stratégies de l'innovation Média 2023",
    detail: {
      fr: "Meilleur dispositif de Communication, Meilleur événement, Opération Spéciale, Influence — Or",
      en: "Best Communication Campaign, Best Event, Special Operation, Influence — Gold",
    },
    film: { fr: "StudyCase Parallèles pour Disney+", en: "Parallèles case study for Disney+" },
  },
  {
    titre: "Festival Caméras des Champs 2019",
    detail: { fr: "3ème Prix du Jury & Prix des Beaux Villages Lorrains", en: "3rd Jury Prize & Beaux Villages Lorrains Prize" },
    film: { fr: "Le Pays Aux Pieds d'Argile", en: "Le Pays Aux Pieds d'Argile" },
  },
  {
    titre: "48h Film Project Paris 2017",
    detail: { fr: "Prix du 2ème Meilleur Film", en: "2nd Best Film Award" },
    film: { fr: "Organe Anonyme", en: "Organe Anonyme" },
  },
  {
    titre: "Challenge Sony / Le Repaire 2013",
    detail: { fr: "Lauréat", en: "Winner" },
    film: { fr: "Club", en: "Club" },
  },
  {
    titre: "Mobile Film Festival 2013",
    detail: { fr: "Finaliste", en: "Finalist" },
    film: { fr: "Contre La Montre", en: "Contre La Montre" },
  },
  {
    titre: "Uppsala Short Film Festival 2013",
    detail: { fr: "Sélection Docurama", en: "Docurama selection" },
    film: { fr: "Hiroshima, The Next Days", en: "Hiroshima, The Next Days" },
  },
  {
    titre: "Nikon Film Festival 2011",
    detail: { fr: "Finaliste", en: "Finalist" },
    film: { fr: "Le Choix", en: "Le Choix" },
  },
];
---

<Layout title={titre} description={description} currentPath="/a-propos" lang={lang}>
  <h1 class="titre-page">{texte.titre}</h1>
  <div class="contenu">
    <p>{texte.intro}</p>

    <h2 class="sous-titre">{texte.prix}</h2>
    <ul class="prix">
      {prix.map((p) => (
        <li>
          <p class="prix-titre">{p.titre}</p>
          <p class="prix-detail">{p.detail[lang]}</p>
          <p class="prix-film">{p.film[lang]}</p>
        </li>
      ))}
    </ul>
  </div>
</Layout>

<style>
  .contenu { text-align:left; width:100%; max-width:640px; margin-top:0; font-family:var(--police-texte); font-weight:400; font-size:1.1rem; color:rgba(var(--blanc-rgb),.72); }
  .sous-titre {
    font-family:'Archivo', 'Inter', sans-serif;
    font-size:.75rem; letter-spacing:.15em; text-transform:uppercase;
    color:rgba(var(--blanc-rgb),.45); font-weight:400;
    margin:3rem 0 1.25rem;
  }
  .prix { list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:1.25rem; }
  .prix-titre { font-weight:700; font-size:1rem; color:var(--blanc); margin:0 0 .3rem; }
  .prix-detail { font-family:var(--police-texte); font-weight:400; font-size:.9rem; line-height:1.5; color:rgba(var(--blanc-rgb),.6); margin:0; }
  .prix-film { font-family:var(--police-texte); font-weight:400; font-style:italic; font-size:.85rem; color:rgba(var(--blanc-rgb),.45); margin:.3rem 0 0; }

  @media (min-width: 801px) {
    .sous-titre { margin-top:6rem; }
  }
</style>
