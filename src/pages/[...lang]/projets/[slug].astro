---
export const prerender = true;
import { render } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import OptimizedImage from "../../../components/OptimizedImage.astro";
import { descriptionDepuisTexte } from "../../../lib/meta";
import { urlEmbed } from "../../../lib/video";
import { getProjets, type Projet } from "../../../lib/contenu";
import { LANGUES, LANGUE_PAR_DEFAUT, langDe, t, url, libelle, roleAffiche, dateFormatee } from "../../../i18n";

export async function getStaticPaths() {
  const resultats = [];

  for (const lang of LANGUES) {
    const tousLesProjets = await getProjets(lang, ({ data }) => !data.brouillon);

    // Même ordre que sur les pages de liste (Commandes : date desc, Créations :
    // année desc), pour que "le projet suivant" corresponde à ce que le
    // visiteur aurait cliqué juste après sur la liste. Boucle au dernier.
    const commandes = tousLesProjets
      .filter((p) => p.data.categorie === "commandes")
      .sort((a, b) => (b.data.date?.valueOf() ?? -Infinity) - (a.data.date?.valueOf() ?? -Infinity));
    const creations = tousLesProjets
      .filter((p) => p.data.categorie === "creations")
      .sort((a, b) => (b.data.annee ?? -Infinity) - (a.data.annee ?? -Infinity));

    // Jusqu'à 3 suggestions après le projet courant (boucle sur la liste),
    // pour laisser le choix au visiteur plutôt qu'un seul "projet suivant" imposé.
    const suivantsDe = (liste: Projet[], index: number, count: number) => {
      const suivants: Projet[] = [];
      for (let i = 1; i <= Math.min(count, liste.length - 1); i++) {
        suivants.push(liste[(index + i) % liste.length]);
      }
      return suivants;
    };

    for (const p of tousLesProjets) {
      const liste = p.data.categorie === "commandes" ? commandes : creations;
      const index = liste.findIndex((x) => x.id === p.id);
      resultats.push({
        params: { lang: lang === LANGUE_PAR_DEFAUT ? undefined : lang, slug: p.id },
        props: { projet: p, suivants: suivantsDe(liste, index, 3) },
      });
    }
  }

  return resultats;
}

const lang = langDe(Astro.params);
const { projet, suivants } = Astro.props;
const { Content } = await render(projet.source);

const currentPath =
  projet.data.categorie === "commandes" ? "/" : `/${projet.data.categorie}`;
const labelRetour = projet.data.categorie === "commandes" ? t(lang, "commandes") : t(lang, "creations");

const titre = `${projet.data.titre} — ${t(lang, "fiche.titre.suffixe")}`;
const extrait = descriptionDepuisTexte(projet.data.description) ?? descriptionDepuisTexte(projet.body);
const description = extrait
  ?? `${projet.data.titre}. ${t(lang, "fiche.description.defaut")}`;
const imagePartage = projet.data.couverture || projet.data.image1;

const galerie = [
  { src: projet.data.image1, alt: projet.data.image1Alt },
  { src: projet.data.image2, alt: projet.data.image2Alt },
  { src: projet.data.image3, alt: projet.data.image3Alt },
].filter((img) => !!img.src);

const anneeAffichee = projet.data.annee
  ? (projet.data.anneeFin && projet.data.anneeFin !== projet.data.annee
      ? `${projet.data.annee}/${projet.data.anneeFin}`
      : String(projet.data.annee))
  : null;

const roleLabel = projet.data.role ? t(lang, "fiche.role") : t(lang, "fiche.client");
const roleTraduit = roleAffiche(lang, projet.data.role);
const roleValeur = roleTraduit && projet.data.client
  ? `${roleTraduit} ${t(lang, "pour")} ${projet.data.client}`
  : roleTraduit || projet.data.client || null;

const urlAbsolue = new URL(Astro.url.pathname, Astro.site).toString();
const imageAbsolue = projet.data.couverture ? new URL(projet.data.couverture, Astro.site).toString() : undefined;
const dateIso = projet.data.date ? projet.data.date.toISOString() : undefined;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": projet.data.video ? "VideoObject" : "CreativeWork",
  name: projet.data.titre,
  description: projet.data.description || description,
  url: urlAbsolue,
  ...(imageAbsolue && { image: imageAbsolue, thumbnailUrl: imageAbsolue }),
  ...(projet.data.video && { embedUrl: urlEmbed(projet.data.video) }),
  ...(dateIso && { datePublished: dateIso, uploadDate: dateIso }),
  ...(!dateIso && projet.data.annee && { datePublished: String(projet.data.annee) }),
  ...((projet.data.genre || projet.data.type) && { genre: libelle(lang, "genre", (projet.data.genre || projet.data.type) as string) }),
  creator: {
    "@type": "Person",
    name: "Alexandre Berger",
    ...(roleTraduit && { jobTitle: roleTraduit }),
  },
  ...(projet.data.client && { sponsor: { "@type": "Organization", name: projet.data.client } }),
};
---

<Layout title={titre} description={description} currentPath={currentPath} jsonLd={jsonLd} image={imagePartage} lang={lang}>
  <article class="projet">
    <a class="lien-retour" href={url(lang, currentPath)}><span class="fleche">←</span> {labelRetour}</a>
    {projet.data.couverture && (
      <OptimizedImage class="couverture" src={projet.data.couverture} alt={projet.data.couvertureAlt || projet.data.titre} loading="eager" fetchpriority="high" sizes="(min-width: 801px) 910px, 100vw" />
    )}
    <h1>{projet.data.titre}</h1>
    {projet.data.enChantier && (
      <p class="note-chantier">
        {t(lang, "fiche.chantier.avant")}<a href={url(lang, "/booking")}>{t(lang, "fiche.chantier.lien")}</a>{t(lang, "fiche.chantier.apres")}
      </p>
    )}
    {(roleValeur || projet.data.date || projet.data.annee || projet.data.genre || projet.data.duree) && (
      <dl class="meta">
        {roleValeur && (
          <div><dt>{roleLabel}</dt><dd>{roleValeur}</dd></div>
        )}
        {projet.data.date && (
          <div><dt>{t(lang, "fiche.date")}</dt><dd>{dateFormatee(lang, projet.data.date, { year: "numeric", month: "long" })}</dd></div>
        )}
        {!projet.data.date && anneeAffichee && (
          <div><dt>{t(lang, "fiche.annee")}</dt><dd>{anneeAffichee}</dd></div>
        )}
        {projet.data.genre && (
          <div><dt>{t(lang, "fiche.genre")}</dt><dd>{libelle(lang, "genre", projet.data.genre)}</dd></div>
        )}
        {projet.data.duree && (
          <div><dt>{t(lang, "fiche.duree")}</dt><dd>{projet.data.duree}</dd></div>
        )}
      </dl>
    )}
    {projet.data.video && (
      <div class="video-embed">
        <iframe
          src={urlEmbed(projet.data.video)}
          title={`${t(lang, "fiche.video")} — ${projet.data.titre}`}
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
        ></iframe>
      </div>
    )}
    <div class="corps">
      <Content />
    </div>
    {galerie.length > 0 && (
      <div class="galerie" data-count={galerie.length}>
        {galerie.map((img) => (
          <OptimizedImage src={img.src} alt={img.alt || projet.data.titre} sizes="(min-width: 801px) 300px, 33vw" />
        ))}
      </div>
    )}
    {suivants.length > 0 && (
      <div class="liens-suivants">
        <span class="lien-suivant-intro">{t(lang, "fiche.suivants")}</span>
        {suivants.map((s) => (
          <a class="lien-suivant-titre" href={url(lang, `/projets/${s.id}`)}>{s.data.titre} <span class="fleche">→</span></a>
        ))}
      </div>
    )}
  </article>
</Layout>

<script>
  // Les liens du texte qui commencent par « → » (ex. « → Voir toute la playlist ») :
  // la flèche passe en rouge, sans rien changer au texte saisi dans le CMS.
  function colorierFlechesDuTexte() {
    document.querySelectorAll<HTMLAnchorElement>('.corps a').forEach((lien) => {
      const debut = lien.firstChild;
      if (debut?.nodeType !== Node.TEXT_NODE || !debut.textContent?.startsWith('→')) return;
      const fleche = document.createElement('span');
      fleche.className = 'fleche';
      fleche.textContent = '→';
      debut.textContent = debut.textContent.slice(1);
      lien.insertBefore(fleche, debut);
    });
  }
  document.addEventListener('astro:page-load', colorierFlechesDuTexte);
</script>

<style>
  .projet { text-align:left; width:100%; max-width:910px; margin-top:3.5rem; }
  .lien-retour {
    display:inline-flex; align-items:center; gap:.4rem; margin-bottom:1.5rem;
    font-family:'Archivo', 'Inter', sans-serif; font-weight:200;
    font-size:.9rem; letter-spacing:.14em; text-transform:uppercase;
    color:rgba(var(--blanc-rgb),.7); text-decoration:none;
    transition:color 140ms ease;
  }
  .lien-retour:hover { color:var(--blanc); }
  :global(.couverture) { width:100%; height:auto; border-radius:2px; margin-bottom:2rem; }
  .projet h1 { font-weight:300; font-size:clamp(1.6rem, 3vw, 2.4rem); margin:0 0 1.25rem; color:var(--blanc); }
  .note-chantier { font-style:italic; color:#e04545; font-size:.9rem; margin:-.5rem 0 1.75rem; }
  .note-chantier a { color:inherit; text-decoration:underline; }
  .meta { display:flex; flex-wrap:wrap; gap:1.5rem; margin:0 0 2rem; }
  .meta > div { display:flex; flex-direction:column; gap:.2rem; }
  .meta dt { font-family:'Archivo', 'Inter', sans-serif; font-weight:200; font-size:.82rem; letter-spacing:.15em; text-transform:uppercase; color:rgba(var(--blanc-rgb),.65); }
  .meta dd { margin:0; font-size:1.05rem; color:rgba(var(--blanc-rgb),.85); font-family:var(--police-texte); font-weight:400; }
  .corps { font-family:var(--police-texte); font-weight:400; font-size:1rem; line-height:1.7; color:rgba(var(--blanc-rgb),.8); }
  .corps :global(p) { margin:0 0 1.25rem; }
  .corps :global(img) { max-width:100%; height:auto; border-radius:2px; margin:1.5rem 0; }
  .corps :global(a) { color:var(--blanc); font-weight:700; text-decoration:none; transition:color 140ms ease; }
  .corps :global(a:hover) { color:rgba(var(--blanc-rgb),.7); }
  .video-embed { position:relative; width:100%; aspect-ratio:16/9; margin:0 0 2rem; background:#000; border-radius:2px; overflow:hidden; }
  .video-embed iframe { position:absolute; inset:0; width:100%; height:100%; border:0; }
  .galerie { display:grid; grid-template-columns:repeat(3, 1fr); gap:.5rem; margin-top:2.5rem; }
  .galerie[data-count="1"] { grid-template-columns:1fr; max-width:28.6rem; }
  .galerie[data-count="2"] { grid-template-columns:repeat(2, 1fr); }
  .galerie :global(img) { width:100%; height:100%; aspect-ratio:4/3; object-fit:cover; display:block; border-radius:2px; }
  /* Grille 3 colonnes en 16:9, utilisée ponctuellement dans le corps d'un
     article via du HTML brut (voir fiche "Semaine de la Critique") — pas
     reliée aux champs image1/2/3 du CMS, donc sans effet sur les autres fiches. */
  .corps :global(.galerie-169) { display:grid; grid-template-columns:repeat(3, 1fr); gap:.5rem; margin:1.5rem 0; }
  .corps :global(.galerie-169 img) { width:100%; height:auto; aspect-ratio:16/9; object-fit:cover; display:block; border-radius:2px; margin:0; }
  /* Série de photographies (suite d'images en portrait dans le texte) : 3 colonnes, photos entières, sans recadrage.
     Les colonnes se remplissent de haut en bas ; des photos en paysage peuvent s'y mêler sans laisser de trou. */
  .corps :global(.galerie-photos) { column-count:3; column-gap:.5rem; margin:1.5rem 0; }
  .corps :global(.galerie-photos img) { display:block; width:100%; height:auto; margin:0 0 .5rem; border-radius:2px; break-inside:avoid; }
  @media (max-width: 800px) {
    .corps :global(.galerie-photos) { column-count:2; }
  }
  .liens-suivants {
    display:flex; flex-direction:column; gap:.75rem;
    margin-top:3.5rem; padding-top:2rem; border-top:1px solid rgba(var(--blanc-rgb),.14);
  }
  .lien-suivant-intro {
    font-family:'Archivo', 'Inter', sans-serif; font-weight:200;
    font-size:.7rem; letter-spacing:.14em; text-transform:uppercase;
    color:rgba(var(--blanc-rgb),.45); margin-bottom:.25rem;
  }
  .lien-suivant-titre {
    font-weight:700; font-size:clamp(1.3rem, 2.6vw, 1.7rem); line-height:1.2;
    color:rgba(var(--blanc-rgb),.7); text-decoration:none; transition:color 140ms ease;
  }
  .lien-suivant-titre:hover { color:var(--blanc); }
</style>
