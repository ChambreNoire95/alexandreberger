---
export const prerender = true;
import { getCarnet } from "../../../lib/contenu";
import Layout from "../../../layouts/Layout.astro";
import { cheminsLangues, langDe, t, url, dateFormatee } from "../../../i18n";

export function getStaticPaths() {
  return cheminsLangues();
}
const lang = langDe(Astro.params);

const entrees = (await getCarnet(lang, ({ data }) => !data.brouillon)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const titre = t(lang, "carnet.titre.page");
const description = t(lang, "carnet.description");
---

<Layout title={titre} description={description} currentPath="/carnet" lang={lang}>
  <h1 class="titre-page">{t(lang, "carnet.titre")}</h1>
  <ul class="entrees">
    {entrees.map((e) => (
      <li>
        <a href={url(lang, `/carnet/${e.id}`)}>
          <span class="entree-titre">{e.data.titre}</span>
          <span class="entree-date">{dateFormatee(lang, e.data.date, { year: "numeric", month: "long", day: "numeric" })}</span>
          {e.data.extrait && <span class="entree-extrait">{e.data.extrait}</span>}
        </a>
      </li>
    ))}
  </ul>
</Layout>

<style>
  .entrees { list-style:none; margin:0; padding:0; display:flex; flex-direction:column; align-items:center; gap:2.4rem; width:100%; max-width:640px; }
  .entrees a { text-decoration:none; display:flex; flex-direction:column; gap:.4rem; transition:opacity 140ms ease; }
  .entrees a:hover { opacity:.7; }
  .entree-titre { font-weight:300; font-size:clamp(1.3rem, 2.2vw, 1.7rem); color:var(--blanc); }
  .entree-date { font-family:'Archivo', 'Inter', sans-serif; font-weight:200; font-size:.7rem; letter-spacing:.12em; text-transform:uppercase; color:rgba(var(--blanc-rgb),.45); }
  .entree-extrait { font-family:var(--police-texte); font-weight:400; font-size:.95rem; color:rgba(var(--blanc-rgb),.65); }
</style>
