---
export const prerender = true;
import Layout from "../layouts/Layout.astro";
import Signature from "../components/Signature.astro";
import TitreSwitch from "../components/TitreSwitch.astro";
import CarrouselHome from "../components/CarrouselHome.astro";
import { getCollection } from "astro:content";

const projets = (await getCollection("projets", ({ data }) => data.categorie === "commandes")).sort(
  // Plus récente en premier, plus ancienne en bas (comme sur Créations).
  (a, b) => (b.data.date?.valueOf() ?? -Infinity) - (a.data.date?.valueOf() ?? -Infinity)
);

const projetsCarrousel = (await getCollection(
  "projets",
  ({ data }) => !!data.carrousel && !!(data.carrouselImage || data.couverture)
)).sort((a, b) => (a.data.ordreCarrousel ?? Infinity) - (b.data.ordreCarrousel ?? Infinity));
const itemsCarrousel = projetsCarrousel.map((p) => ({
  href: `/projets/${p.id}`,
  src: (p.data.carrouselImage || p.data.couverture) as string,
  alt: p.data.carrouselImageAlt || p.data.couvertureAlt || p.data.titre,
  titre: p.data.carrouselTitre || p.data.titre,
}));

const titre = "Alexandre Berger — Réalisateur documentaire, fiction & film de marque";
const description = "Alexandre Berger, réalisateur freelance en Île-de-France. Je fabrique des films — documentaire, fiction et film de marque, souvent dans des contextes hors du commun.";

// N'affiche dans le filtre que les types réellement utilisés par au moins un projet.
const ORDRE_TYPES = ["Making-of", "Documentaire", "Aftermovie", "Brand Content", "RSE", "Fiction"];
const typesPresents = ORDRE_TYPES.filter((t) => projets.some((p) => p.data.type === t));
---

<Layout title={titre} description={description} currentPath="/">
  <p class="sr-only">Alexandre Berger, réalisateur freelance en Île-de-France — documentaire, fiction, film de marque</p>

  <Signature />

  <CarrouselHome items={itemsCarrousel} />

  <TitreSwitch actif="commandes" />

  {typesPresents.length > 0 && (
    <nav class="filtres" id="filtres" aria-label="Filtrer par type de film">
      <button type="button" data-type="all" aria-pressed="true">Tous</button>
      {typesPresents.map((t) => (
        <button type="button" data-type={t} aria-pressed="false">{t}</button>
      ))}
    </nav>
  )}

  <ul id="accroches" class:list={["accroches", { "sans-filtres": typesPresents.length === 0 }]}>
    {projets.map((p) => {
      return (
        <li data-type={p.data.type || ""}>
          <a href={`/projets/${p.id}`}>
            <span class="accroche-titre">{p.data.titre}</span>
            {p.data.role && p.data.client ? (
              <span class="accroche-meta">{p.data.role} <br class="saut-mobile" />pour {p.data.client}</span>
            ) : (
              (p.data.role || p.data.client) && <span class="accroche-meta">{p.data.role || p.data.client}</span>
            )}
          </a>
        </li>
      );
    })}
  </ul>
</Layout>

<style>
  .filtres { display:flex; flex-wrap:wrap; justify-content:center; gap:.75rem; margin:0; }
  .filtres button {
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size:.7rem; letter-spacing:.14em; text-transform:uppercase;
    color:rgba(255,255,255,.5); background:transparent; cursor:pointer;
    border:1px solid rgba(255,255,255,.3); border-radius:2px; padding:.4rem .8rem;
    transition: background 140ms ease, color 140ms ease, border-color 140ms ease;
  }
  .filtres button:hover { color:#fff; border-color:rgba(255,255,255,.6); }
  .filtres button[aria-pressed="true"] { background:#fff; color:#0b0b0b; border-color:#fff; }
  .accroches { list-style:none; margin:4.5rem 0 0; padding:0; display:flex; flex-direction:column; align-items:center; gap:3.575rem; }
  .accroches.sans-filtres { margin-top:5.5rem; }
  .accroches li[hidden] { display:none; }
  .accroches a {
    display:flex; flex-direction:column; align-items:center; gap:.6rem;
    text-decoration:none;
  }
  .accroche-titre {
    font-weight:700; font-size:clamp(1.26rem, 2.88vw, 1.8rem); line-height:1.2;
    color:#fff; white-space:nowrap; transition:color 140ms ease;
  }
  .accroches a:hover .accroche-titre { color:rgba(255,255,255,.6); }
  @media (max-width: 700px) {
    .accroche-titre { white-space:normal; max-width:40ch; text-align:center; }
  }
  .accroche-meta {
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size:.77rem; letter-spacing:.12em; text-transform:uppercase; color:rgba(255,255,255,.45);
  }
  .saut-mobile { display:none; }
  @media (max-width: 800px) {
    .saut-mobile { display:inline; }
  }
</style>

<script>
  function setupFiltres() {
    const nav = document.getElementById('filtres');
    const items = document.querySelectorAll<HTMLLIElement>('#accroches li');
    if (!nav || !items.length) return;

    nav.addEventListener('click', (event) => {
      const bouton = (event.target as HTMLElement).closest<HTMLButtonElement>('button[data-type]');
      if (!bouton) return;
      const type = bouton.dataset.type;

      nav.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', String(b === bouton)));
      items.forEach((li) => {
        li.hidden = type !== 'all' && li.dataset.type !== type;
      });

      // Masquer/afficher des accroches déplace le contenu sous le point de
      // défilement actuel : le navigateur compense à sa façon (scroll
      // anchoring), de façon incohérente selon les éléments cachés. On fixe
      // systématiquement la barre de filtres en haut de l'écran pour un
      // comportement prévisible au lieu d'un saut aléatoire.
      nav.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  }

  document.addEventListener('astro:page-load', setupFiltres);
</script>
