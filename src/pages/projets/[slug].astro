---
export const prerender = true;
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
  const projets = await getCollection("projets");
  return projets.map((p) => ({
    params: { slug: p.id },
    props: { projet: p },
  }));
}

const { projet } = Astro.props;
const { Content } = await render(projet);

const currentPath =
  projet.data.categorie === "commandes" ? "/" : `/${projet.data.categorie}`;
const labelRetour = projet.data.categorie === "commandes" ? "Films de commande" : "Créations";

const titre = `${projet.data.titre} — Alexandre Berger, réalisateur`;
const description = projet.data.description
  ? `${projet.data.titre}. ${projet.data.description}`
  : `${projet.data.titre}. Un projet réalisé par Alexandre Berger, réalisateur freelance en Île-de-France : documentaire, fiction et film de marque.`;

const galerie = [
  { src: projet.data.image1, alt: projet.data.image1Alt },
  { src: projet.data.image2, alt: projet.data.image2Alt },
  { src: projet.data.image3, alt: projet.data.image3Alt },
].filter((img) => !!img.src);

const anneeAffichee = projet.data.annee
  ? (projet.data.anneeFin && projet.data.anneeFin !== projet.data.annee
      ? `${projet.data.annee}/${projet.data.anneeFin}`
      : String(projet.data.annee))
  : null;

const roleLabel = projet.data.role ? "Rôle" : "Client";
const roleValeur = projet.data.role && projet.data.client
  ? `${projet.data.role} pour ${projet.data.client}`
  : projet.data.role || projet.data.client || null;

/** Convertit une URL YouTube/Vimeo en URL d'embed ; renvoie l'URL telle quelle pour les autres plateformes (Vidéas...). */
function urlEmbed(url: string) {
  try {
    const u = new URL(url);
    const hote = u.hostname.replace(/^www\./, "");
    if (hote === "youtu.be") return `https://www.youtube.com/embed/${u.pathname.slice(1)}`;
    if (hote === "youtube.com" || hote === "m.youtube.com") {
      if (u.pathname === "/watch") {
        const id = u.searchParams.get("v");
        return id ? `https://www.youtube.com/embed/${id}` : url;
      }
      if (u.pathname.startsWith("/shorts/")) return `https://www.youtube.com/embed/${u.pathname.split("/")[2]}`;
      return url;
    }
    if (hote === "vimeo.com") {
      const id = u.pathname.split("/").filter(Boolean)[0];
      return id ? `https://player.vimeo.com/video/${id}` : url;
    }
    return url;
  } catch {
    return url;
  }
}
---

<Layout title={titre} description={description} currentPath={currentPath}>
  <article class="projet">
    <a class="lien-retour" href={currentPath}>← {labelRetour}</a>
    {projet.data.couverture && (
      <img class="couverture" src={projet.data.couverture} alt={projet.data.couvertureAlt || projet.data.titre} />
    )}
    <h1>{projet.data.titre}</h1>
    {(roleValeur || projet.data.date || projet.data.annee || projet.data.genre || projet.data.duree) && (
      <dl class="meta">
        {roleValeur && (
          <div><dt>{roleLabel}</dt><dd>{roleValeur}</dd></div>
        )}
        {projet.data.date && (
          <div><dt>Date</dt><dd>{projet.data.date.toLocaleDateString("fr-FR", { year: "numeric", month: "long" })}</dd></div>
        )}
        {!projet.data.date && anneeAffichee && (
          <div><dt>Année</dt><dd>{anneeAffichee}</dd></div>
        )}
        {projet.data.genre && (
          <div><dt>Genre</dt><dd>{projet.data.genre}</dd></div>
        )}
        {projet.data.duree && (
          <div><dt>Durée</dt><dd>{projet.data.duree}</dd></div>
        )}
      </dl>
    )}
    {projet.data.video && (
      <div class="video-embed">
        <iframe
          src={urlEmbed(projet.data.video)}
          title={`Vidéo — ${projet.data.titre}`}
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
        ></iframe>
      </div>
    )}
    <div class="corps">
      <Content />
    </div>
    {galerie.length > 0 && (
      <div class="galerie" data-count={galerie.length}>
        {galerie.map((img) => <img src={img.src} alt={img.alt || projet.data.titre} />)}
      </div>
    )}
  </article>
</Layout>

<style>
  .projet { text-align:left; width:100%; max-width:910px; margin-top:3.5rem; }
  .lien-retour {
    display:inline-flex; align-items:center; gap:.4rem; margin-bottom:1.5rem;
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size:.7rem; letter-spacing:.14em; text-transform:uppercase;
    color:rgba(255,255,255,.5); text-decoration:none;
    transition:color 140ms ease;
  }
  .lien-retour:hover { color:#fff; }
  .couverture { width:100%; height:auto; border-radius:2px; margin-bottom:2rem; }
  .projet h1 { font-weight:300; font-size:clamp(1.6rem, 3vw, 2.4rem); margin:0 0 1.25rem; color:#fff; }
  .meta { display:flex; flex-wrap:wrap; gap:1.5rem; margin:0 0 2rem; }
  .meta > div { display:flex; flex-direction:column; gap:.2rem; }
  .meta dt { font-family: ui-monospace, "SF Mono", Menlo, monospace; font-size:.65rem; letter-spacing:.15em; text-transform:uppercase; color:rgba(255,255,255,.45); }
  .meta dd { margin:0; font-size:.85rem; color:rgba(255,255,255,.85); font-weight:300; }
  .corps { font-weight:300; font-size:1rem; line-height:1.7; color:rgba(255,255,255,.8); }
  .corps :global(p) { margin:0 0 1.25rem; }
  .corps :global(img) { max-width:100%; height:auto; border-radius:2px; margin:1.5rem 0; }
  .video-embed { position:relative; width:100%; aspect-ratio:16/9; margin:0 0 2rem; background:#000; border-radius:2px; overflow:hidden; }
  .video-embed iframe { position:absolute; inset:0; width:100%; height:100%; border:0; }
  .galerie { display:grid; grid-template-columns:repeat(3, 1fr); gap:.5rem; margin-top:2.5rem; }
  .galerie[data-count="1"] { grid-template-columns:1fr; max-width:28.6rem; }
  .galerie[data-count="2"] { grid-template-columns:repeat(2, 1fr); }
  .galerie img { width:100%; height:100%; aspect-ratio:4/3; object-fit:cover; display:block; border-radius:2px; }
</style>
