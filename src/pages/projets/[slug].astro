---
export const prerender = true;
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import OptimizedImage from "../../components/OptimizedImage.astro";
import { descriptionDepuisTexte } from "../../lib/meta";
import { urlEmbed } from "../../lib/video";

export async function getStaticPaths() {
  const tousLesProjets = await getCollection("projets", ({ data }) => !data.brouillon);

  // Même ordre que sur les pages de liste (Commandes : date desc, Créations :
  // année desc), pour que "le projet suivant" corresponde à ce que le
  // visiteur aurait cliqué juste après sur la liste. Boucle au dernier.
  const commandes = tousLesProjets
    .filter((p) => p.data.categorie === "commandes")
    .sort((a, b) => (b.data.date?.valueOf() ?? -Infinity) - (a.data.date?.valueOf() ?? -Infinity));
  const creations = tousLesProjets
    .filter((p) => p.data.categorie === "creations")
    .sort((a, b) => (b.data.annee ?? -Infinity) - (a.data.annee ?? -Infinity));

  // Jusqu'à 3 suggestions après le projet courant (boucle sur la liste),
  // pour laisser le choix au visiteur plutôt qu'un seul "projet suivant" imposé.
  function suivantsDe(liste: typeof tousLesProjets, index: number, count: number) {
    const resultats: typeof tousLesProjets = [];
    for (let i = 1; i <= Math.min(count, liste.length - 1); i++) {
      resultats.push(liste[(index + i) % liste.length]);
    }
    return resultats;
  }

  return tousLesProjets.map((p) => {
    const liste = p.data.categorie === "commandes" ? commandes : creations;
    const index = liste.findIndex((x) => x.id === p.id);
    return {
      params: { slug: p.id },
      props: { projet: p, suivants: suivantsDe(liste, index, 3) },
    };
  });
}

const { projet, suivants } = Astro.props;
const { Content } = await render(projet);

const currentPath =
  projet.data.categorie === "commandes" ? "/" : `/${projet.data.categorie}`;
const labelRetour = projet.data.categorie === "commandes" ? "Films de commande" : "Créations";

const titre = `${projet.data.titre} — Alexandre Berger, réalisateur`;
const extrait = descriptionDepuisTexte(projet.data.description) ?? descriptionDepuisTexte(projet.body);
const description = extrait
  ?? `${projet.data.titre}. Un projet réalisé par Alexandre Berger, réalisateur freelance en Île-de-France : documentaire, fiction et film de marque.`;
const imagePartage = projet.data.couverture || projet.data.image1;

const galerie = [
  { src: projet.data.image1, alt: projet.data.image1Alt },
  { src: projet.data.image2, alt: projet.data.image2Alt },
  { src: projet.data.image3, alt: projet.data.image3Alt },
].filter((img) => !!img.src);

const anneeAffichee = projet.data.annee
  ? (projet.data.anneeFin && projet.data.anneeFin !== projet.data.annee
      ? `${projet.data.annee}/${projet.data.anneeFin}`
      : String(projet.data.annee))
  : null;

const roleLabel = projet.data.role ? "Rôle" : "Client";
const roleValeur = projet.data.role && projet.data.client
  ? `${projet.data.role} pour ${projet.data.client}`
  : projet.data.role || projet.data.client || null;

const urlAbsolue = new URL(Astro.url.pathname, Astro.site).toString();
const imageAbsolue = projet.data.couverture ? new URL(projet.data.couverture, Astro.site).toString() : undefined;
const dateIso = projet.data.date ? projet.data.date.toISOString() : undefined;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": projet.data.video ? "VideoObject" : "CreativeWork",
  name: projet.data.titre,
  description: projet.data.description || description,
  url: urlAbsolue,
  ...(imageAbsolue && { image: imageAbsolue, thumbnailUrl: imageAbsolue }),
  ...(projet.data.video && { embedUrl: urlEmbed(projet.data.video) }),
  ...(dateIso && { datePublished: dateIso, uploadDate: dateIso }),
  ...(!dateIso && projet.data.annee && { datePublished: String(projet.data.annee) }),
  ...((projet.data.genre || projet.data.type) && { genre: projet.data.genre || projet.data.type }),
  creator: {
    "@type": "Person",
    name: "Alexandre Berger",
    ...(projet.data.role && { jobTitle: projet.data.role }),
  },
  ...(projet.data.client && { sponsor: { "@type": "Organization", name: projet.data.client } }),
};
---

<Layout title={titre} description={description} currentPath={currentPath} jsonLd={jsonLd} image={imagePartage}>
  <article class="projet">
    <a class="lien-retour" href={currentPath}>← {labelRetour}</a>
    {projet.data.couverture && (
      <OptimizedImage class="couverture" src={projet.data.couverture} alt={projet.data.couvertureAlt || projet.data.titre} loading="eager" fetchpriority="high" sizes="(min-width: 801px) 910px, 100vw" />
    )}
    <h1>{projet.data.titre}</h1>
    {projet.data.enChantier && (
      <p class="note-chantier">
        Cette page est en cours de refonte, n'hésitez pas à <a href="/booking">me contacter</a> si vous avez des questions.
      </p>
    )}
    {(roleValeur || projet.data.date || projet.data.annee || projet.data.genre || projet.data.duree) && (
      <dl class="meta">
        {roleValeur && (
          <div><dt>{roleLabel}</dt><dd>{roleValeur}</dd></div>
        )}
        {projet.data.date && (
          <div><dt>Date</dt><dd>{projet.data.date.toLocaleDateString("fr-FR", { year: "numeric", month: "long" })}</dd></div>
        )}
        {!projet.data.date && anneeAffichee && (
          <div><dt>Année</dt><dd>{anneeAffichee}</dd></div>
        )}
        {projet.data.genre && (
          <div><dt>Genre</dt><dd>{projet.data.genre}</dd></div>
        )}
        {projet.data.duree && (
          <div><dt>Durée</dt><dd>{projet.data.duree}</dd></div>
        )}
      </dl>
    )}
    {projet.data.video && (
      <div class="video-embed">
        <iframe
          src={urlEmbed(projet.data.video)}
          title={`Vidéo — ${projet.data.titre}`}
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
        ></iframe>
      </div>
    )}
    <div class="corps">
      <Content />
    </div>
    {galerie.length > 0 && (
      <div class="galerie" data-count={galerie.length}>
        {galerie.map((img) => (
          <OptimizedImage src={img.src} alt={img.alt || projet.data.titre} sizes="(min-width: 801px) 300px, 33vw" />
        ))}
      </div>
    )}
    {suivants.length > 0 && (
      <div class="liens-suivants">
        <span class="lien-suivant-intro">Découvrez d'autres réalisations</span>
        {suivants.map((s) => (
          <a class="lien-suivant-titre" href={`/projets/${s.id}`}>{s.data.titre} →</a>
        ))}
      </div>
    )}
  </article>
</Layout>

<style>
  .projet { text-align:left; width:100%; max-width:910px; margin-top:3.5rem; }
  .lien-retour {
    display:inline-flex; align-items:center; gap:.4rem; margin-bottom:1.5rem;
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size:.7rem; letter-spacing:.14em; text-transform:uppercase;
    color:rgba(255,255,255,.5); text-decoration:none;
    transition:color 140ms ease;
  }
  .lien-retour:hover { color:#fff; }
  :global(.couverture) { width:100%; height:auto; border-radius:2px; margin-bottom:2rem; }
  .projet h1 { font-weight:300; font-size:clamp(1.6rem, 3vw, 2.4rem); margin:0 0 1.25rem; color:#fff; }
  .note-chantier { font-style:italic; color:#e04545; font-size:.9rem; margin:-.5rem 0 1.75rem; }
  .note-chantier a { color:inherit; text-decoration:underline; }
  .meta { display:flex; flex-wrap:wrap; gap:1.5rem; margin:0 0 2rem; }
  .meta > div { display:flex; flex-direction:column; gap:.2rem; }
  .meta dt { font-family: ui-monospace, "SF Mono", Menlo, monospace; font-size:.65rem; letter-spacing:.15em; text-transform:uppercase; color:rgba(255,255,255,.45); }
  .meta dd { margin:0; font-size:.85rem; color:rgba(255,255,255,.85); font-weight:300; }
  .corps { font-weight:300; font-size:1rem; line-height:1.7; color:rgba(255,255,255,.8); }
  .corps :global(p) { margin:0 0 1.25rem; }
  .corps :global(img) { max-width:100%; height:auto; border-radius:2px; margin:1.5rem 0; }
  .corps :global(a) { color:#fff; font-weight:700; text-decoration:none; transition:color 140ms ease; }
  .corps :global(a:hover) { color:rgba(255,255,255,.7); }
  .video-embed { position:relative; width:100%; aspect-ratio:16/9; margin:0 0 2rem; background:#000; border-radius:2px; overflow:hidden; }
  .video-embed iframe { position:absolute; inset:0; width:100%; height:100%; border:0; }
  .galerie { display:grid; grid-template-columns:repeat(3, 1fr); gap:.5rem; margin-top:2.5rem; }
  .galerie[data-count="1"] { grid-template-columns:1fr; max-width:28.6rem; }
  .galerie[data-count="2"] { grid-template-columns:repeat(2, 1fr); }
  .galerie :global(img) { width:100%; height:100%; aspect-ratio:4/3; object-fit:cover; display:block; border-radius:2px; }
  /* Grille 3 colonnes en 16:9, utilisée ponctuellement dans le corps d'un
     article via du HTML brut (voir fiche "Semaine de la Critique") — pas
     reliée aux champs image1/2/3 du CMS, donc sans effet sur les autres fiches. */
  .corps :global(.galerie-169) { display:grid; grid-template-columns:repeat(3, 1fr); gap:.5rem; margin:1.5rem 0; }
  .corps :global(.galerie-169 img) { width:100%; aspect-ratio:16/9; object-fit:cover; display:block; border-radius:2px; margin:0; }
  .liens-suivants {
    display:flex; flex-direction:column; gap:.75rem;
    margin-top:3.5rem; padding-top:2rem; border-top:1px solid rgba(255,255,255,.14);
  }
  .lien-suivant-intro {
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size:.7rem; letter-spacing:.14em; text-transform:uppercase;
    color:rgba(255,255,255,.45); margin-bottom:.25rem;
  }
  .lien-suivant-titre {
    font-weight:700; font-size:clamp(1.3rem, 2.6vw, 1.7rem); line-height:1.2;
    color:rgba(255,255,255,.7); text-decoration:none; transition:color 140ms ease;
  }
  .lien-suivant-titre:hover { color:#fff; }
</style>
