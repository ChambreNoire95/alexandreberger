---
export const prerender = true;
import Layout from "../../layouts/Layout.astro";
import OptimizedImage from "../../components/OptimizedImage.astro";
import { getCollection } from "astro:content";

const blocs = (await getCollection("projetsSatellites")).sort(
  (a, b) => (a.data.ordre ?? Infinity) - (b.data.ordre ?? Infinity)
);

const titre = "Projets Satellites — Alexandre Berger, réalisateur";
const description = "Projets satellites d'Alexandre Berger, réalisateur freelance en Île-de-France : documentaire, fiction et film de marque.";
---

<Layout title={titre} description={description} currentPath="/projets-satellites">
  <h1 class="titre-page">Projets Satellites</h1>

  <ul class="blocs">
    {blocs.map((b) => (
      <li>
        <a href={`/projets-satellites/${b.id}`} class="bloc">
          {b.data.couverture && (
            <OptimizedImage src={b.data.couverture} alt={b.data.couvertureAlt || b.data.titre} sizes="(min-width: 801px) 300px, 100vw" />
          )}
          <span class="bloc-titre">{b.data.titre}</span>
          {b.data.accroche && <span class="bloc-accroche">{b.data.accroche}</span>}
        </a>
      </li>
    ))}
  </ul>
</Layout>

<style>
  .blocs {
    list-style:none; margin:4.5rem 0 0; padding:0;
    display:grid; grid-template-columns:1fr; gap:1.5rem;
    width:100%; max-width:910px;
  }
  .bloc {
    display:flex; flex-direction:column; text-decoration:none;
    border:1px solid rgba(255,255,255,.14); border-radius:2px; overflow:hidden;
    transition:border-color 140ms ease;
  }
  .bloc:hover { border-color:rgba(255,255,255,.4); }
  .bloc :global(img) { width:100%; aspect-ratio:3/4; object-fit:cover; display:block; }
  .bloc-titre { font-weight:700; font-size:1.1rem; color:#fff; padding:1.25rem 1.25rem .5rem; text-align:left; }
  .bloc-accroche { font-weight:300; font-size:.85rem; line-height:1.5; color:rgba(255,255,255,.6); padding:0 1.25rem 1.25rem; text-align:left; }

  @media (min-width: 801px) {
    .blocs { grid-template-columns:repeat(3, 1fr); }
  }
</style>
