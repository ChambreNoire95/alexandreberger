---
export const prerender = true;
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import OptimizedImage from "../../components/OptimizedImage.astro";

export async function getStaticPaths() {
  const blocs = await getCollection("projetsSatellites");
  return blocs.map((b) => ({
    params: { slug: b.id },
    props: { bloc: b },
  }));
}

const { bloc } = Astro.props;
const { Content } = await render(bloc);

const titre = `${bloc.data.titre} — Alexandre Berger, réalisateur`;
const description = bloc.data.accroche ?? `${bloc.data.titre}. Un projet d'Alexandre Berger, réalisateur freelance en Île-de-France.`;

// Si le lien renseigné dans le CMS n'a pas de protocole (ex. "bigstills.com"
// au lieu de "https://bigstills.com"), le navigateur le traite comme un
// chemin relatif à la page courante plutôt que comme une URL externe.
const lienDecouvrir = bloc.data.lien && !/^[a-z][a-z0-9+.-]*:/i.test(bloc.data.lien)
  ? `https://${bloc.data.lien}`
  : bloc.data.lien;

const urlAbsolue = new URL(Astro.url.pathname, Astro.site).toString();
const imageAbsolue = bloc.data.couverture ? new URL(bloc.data.couverture, Astro.site).toString() : undefined;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  name: bloc.data.titre,
  description,
  url: urlAbsolue,
  ...(imageAbsolue && { image: imageAbsolue }),
  creator: { "@type": "Person", name: "Alexandre Berger" },
};
---

<Layout title={titre} description={description} currentPath="/projets-satellites" jsonLd={jsonLd}>
  <h1 class="titre-page">{bloc.data.titre}</h1>

  {lienDecouvrir && (
    <a class="bouton-decouvrir" href={lienDecouvrir} target="_blank" rel="noopener">Découvrir</a>
  )}

  <article class="bloc-page">
    {bloc.data.couverture && (
      <OptimizedImage class="couverture" src={bloc.data.couverture} alt={bloc.data.couvertureAlt || bloc.data.titre} loading="eager" fetchpriority="high" sizes="(min-width: 801px) 700px, 100vw" />
    )}
    <div class="corps">
      <Content />
    </div>
  </article>
</Layout>

<style>
  .bouton-decouvrir {
    display:inline-flex; align-items:center; justify-content:center;
    height:2.5rem; padding:0 1.5rem; margin:0 0 3.5rem;
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size:.75rem; letter-spacing:.18em; text-transform:uppercase;
    color:#fff; text-decoration:none; white-space:nowrap;
    border:1px solid rgba(255,255,255,.5); border-radius:2px;
    transition: background 140ms ease, color 140ms ease, border-color 140ms ease;
  }
  .bouton-decouvrir:hover { background:#fff; color:#0b0b0b; border-color:#fff; }
  .bloc-page { text-align:left; width:100%; max-width:700px; }
  :global(.couverture) { width:100%; height:auto; border-radius:2px; margin-bottom:2rem; }
  .corps { font-weight:300; font-size:1rem; line-height:1.7; color:rgba(255,255,255,.8); }
  .corps :global(p) { margin:0 0 1.25rem; }
  .corps :global(img) { max-width:100%; height:auto; border-radius:2px; margin:1.5rem 0; }
</style>
