---
export const prerender = true;
import Layout from "../layouts/Layout.astro";
import Signature from "../components/Signature.astro";
import TitreSwitch from "../components/TitreSwitch.astro";
import CarrouselHome from "../components/CarrouselHome.astro";
import OptimizedImage from "../components/OptimizedImage.astro";
import { getCollection } from "astro:content";

const projets = (await getCollection("projets", ({ data }) => data.categorie === "creations")).sort(
  // Plus récente en premier, plus ancienne en bas. Les créations sans année
  // renseignée passent en dernier plutôt que de perturber le classement.
  (a, b) => (b.data.annee ?? -Infinity) - (a.data.annee ?? -Infinity)
);

// Même carrousel que la home (tous projets confondus) : il reste identique
// d'une page à l'autre pour préserver l'effet "one page" au switch
// Commandes/Créations.
const projetsCarrousel = (await getCollection(
  "projets",
  ({ data }) => !!data.carrousel && !!(data.carrouselImage || data.couverture)
)).sort((a, b) => (a.data.ordreCarrousel ?? Infinity) - (b.data.ordreCarrousel ?? Infinity));
const itemsCarrousel = projetsCarrousel.map((p) => ({
  href: `/projets/${p.id}`,
  src: (p.data.carrouselImage || p.data.couverture) as string,
  alt: p.data.carrouselImageAlt || p.data.couvertureAlt || p.data.titre,
  titre: p.data.carrouselTitre || p.data.titre,
  label: p.data.type || p.data.genre || null,
}));

const titre = "Créations — Alexandre Berger, réalisateur";
const description = "Créations personnelles d'Alexandre Berger, réalisateur freelance en Île-de-France : documentaire, fiction et film de marque.";

// N'affiche dans le filtre que les genres réellement utilisés par au moins un projet.
const ORDRE_TYPES = ["Fiction", "Documentaire", "Clip", "Expérimental"];
const typesPresents = ORDRE_TYPES.filter((t) => projets.some((p) => p.data.genre === t));

// Second filtre, indépendant du genre : le rôle tenu sur le projet.
// Pas de "Tous" ici : par défaut on ne montre que les projets Réalisateur,
// les projets Producteur n'apparaissent qu'au clic sur ce bouton.
const ORDRE_ROLES = ["Réalisateur", "Producteur"];
const rolesPresents = ORDRE_ROLES.filter((r) => projets.some((p) => p.data.role === r));
const roleParDefaut = rolesPresents.includes("Réalisateur") ? "Réalisateur" : null;

// Un genre reste cliquable seulement s'il existe au moins un projet de ce
// genre pour le rôle actuellement sélectionné (par défaut : Réalisateur).
function genreDisponible(genre: string) {
  return projets.some((p) => p.data.genre === genre && (roleParDefaut === null || p.data.role === roleParDefaut));
}
---

<Layout title={titre} description={description} currentPath="/creations">
  <Signature />

  <CarrouselHome items={itemsCarrousel} />

  <TitreSwitch actif="creations" />

  {(typesPresents.length > 0 || rolesPresents.length > 0) && (
    <div class="filtres-ligne">
      {typesPresents.length > 0 && (
        <nav class="filtres" id="filtres" aria-label="Filtrer par genre">
          <button type="button" data-type="all" aria-pressed="true">Tous</button>
          {typesPresents.map((t) => (
            <button type="button" data-type={t} aria-pressed="false" disabled={genreDisponible(t) ? undefined : true}>{t}</button>
          ))}
        </nav>
      )}

      {rolesPresents.length > 0 && (
        <nav class="filtres filtres-role" id="filtres-role" aria-label="Filtrer par rôle">
          {rolesPresents.map((r) => (
            <button type="button" data-role={r} aria-pressed={r === roleParDefaut ? "true" : "false"}>{r}</button>
          ))}
        </nav>
      )}
    </div>
  )}

  <ul id="creations" class:list={["creations", { "sans-filtres": typesPresents.length === 0 && rolesPresents.length === 0 }]}>
    {projets.map((p) => {
      const images = [
        { src: p.data.image1, alt: p.data.image1Alt },
        { src: p.data.image2, alt: p.data.image2Alt },
        { src: p.data.image3, alt: p.data.image3Alt },
      ].filter((img) => !!img.src);
      const annee = p.data.annee
        ? (p.data.anneeFin && p.data.anneeFin !== p.data.annee ? `${p.data.annee}/${p.data.anneeFin}` : String(p.data.annee))
        : null;
      const meta = [annee, p.data.genre, p.data.duree].filter((v) => !!v).join(" · ");
      const cachePardefaut = roleParDefaut !== null && p.data.role !== roleParDefaut;
      return (
        <li class="creation" data-count={images.length} data-type={p.data.genre || ""} data-role={p.data.role || ""} hidden={cachePardefaut || undefined}>
          {images.length > 0 && (
            <div class="creation-images">
              {images.map((img) => (
                <OptimizedImage src={img.src} alt={img.alt || p.data.titre} sizes="(max-width: 800px) 33vw, 300px" />
              ))}
            </div>
          )}
          <div class="creation-texte">
            {meta && <p class="creation-meta">{meta}</p>}
            <h2 class="creation-titre">{p.data.titre}</h2>
            {p.data.description && <p class="creation-description">{p.data.description}</p>}
          </div>
        </li>
      );
    })}
  </ul>
</Layout>

<style>
  .filtres-ligne {
    display:flex; flex-direction:column; align-items:center; gap:1rem;
    width:100%;
  }
  .filtres { display:flex; flex-wrap:wrap; justify-content:center; gap:.75rem; margin:0; }
  .filtres button {
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size:.7rem; letter-spacing:.14em; text-transform:uppercase;
    color:rgba(255,255,255,.5); background:transparent; cursor:pointer;
    border:1px solid rgba(255,255,255,.3); border-radius:2px; padding:.4rem .8rem;
    transition: background 140ms ease, color 140ms ease, border-color 140ms ease;
  }
  .filtres button:not(:disabled):hover { color:#fff; border-color:rgba(255,255,255,.6); }
  .filtres button[aria-pressed="true"] { background:#fff; color:#0b0b0b; border-color:#fff; }
  .filtres button:disabled {
    color:rgba(255,255,255,.2); border-color:rgba(255,255,255,.12);
    cursor:not-allowed;
  }
  @media (min-width: 801px) {
    /* Genre à gauche (aligné avec le contenu des projets), rôle à droite,
       sur la même ligne. En dessous de ce seuil, les deux restent
       empilées et centrées (cf. le mémo sur le périmètre desktop). */
    .filtres-ligne { flex-direction:row; justify-content:space-between; max-width:910px; }
    .filtres, .filtres-role { justify-content:flex-start; }
    .filtres-role { justify-content:flex-end; }
  }
  .creations {
    list-style:none; margin:4.5rem 0 0; padding:0;
    display:flex; flex-direction:column; align-items:center;
    width:100%; max-width:910px;
  }
  .creations.sans-filtres { margin-top:5.5rem; }
  .creations li[hidden] { display:none; }
  .creation {
    width:100%; display:flex; flex-direction:column; gap:1.1rem; text-align:left;
    padding:3rem 0;
  }
  .creation[data-count="1"] { max-width:28.6rem; }
  .creation + .creation { border-top:1px solid rgba(255,255,255,.14); }
  .creation:first-child { padding-top:0; }
  #creations .creation.premier-visible { border-top:none; padding-top:0; }
  .creation-images { display:grid; grid-template-columns:repeat(3, 1fr); gap:.5rem; width:100%; }
  .creation[data-count="1"] .creation-images { grid-template-columns:1fr; }
  .creation[data-count="2"] .creation-images { grid-template-columns:repeat(2, 1fr); }
  .creation-images img {
    width:100%; height:100%; aspect-ratio:16/9; object-fit:cover; display:block; border-radius:2px;
  }
  .creation-texte { display:flex; flex-direction:column; gap:1.1rem; width:100%; }
  .creation-meta {
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size:.7rem; letter-spacing:.12em; color:rgba(255,255,255,.45);
    margin:0;
  }
  .creation-titre {
    font-weight:700; font-size:clamp(1.4rem, 2.4vw, 1.9rem); line-height:1.2;
    color:#fff; margin:0;
  }
  .creation-description {
    font-weight:300; font-size:.95rem; line-height:1.6; color:rgba(255,255,255,.65); margin:0;
  }
</style>

<script>
  function setupFiltres() {
    const navGenre = document.getElementById('filtres');
    const navRole = document.getElementById('filtres-role');
    const items = document.querySelectorAll<HTMLLIElement>('#creations li');
    if ((!navGenre && !navRole) || !items.length) return;

    // L'état initial (genre "Tous", rôle par défaut) est déjà posé côté
    // serveur via aria-pressed/hidden : on le relit ici plutôt que de le
    // redéfinir en dur, pour rester cohérent au premier chargement.
    let genre = navGenre?.querySelector('[aria-pressed="true"]')?.getAttribute('data-type') ?? 'all';
    let role = navRole?.querySelector('[aria-pressed="true"]')?.getAttribute('data-role') ?? null;

    function majPremierVisible() {
      items.forEach((li) => li.classList.remove('premier-visible'));
      const premier = [...items].find((li) => !li.hidden);
      if (premier) premier.classList.add('premier-visible');
    }

    function appliquerFiltres() {
      items.forEach((li) => {
        const okGenre = genre === 'all' || li.dataset.type === genre;
        const okRole = role === null || li.dataset.role === role;
        li.hidden = !(okGenre && okRole);
      });
      majPremierVisible();
    }

    // Grise les boutons de genre sans aucun projet pour le rôle actuel. Si
    // le genre sélectionné devient indisponible, on retombe sur "Tous"
    // plutôt que de laisser un filtre actif qui ne matcherait plus rien.
    function majDisponibiliteGenres() {
      if (!navGenre) return;
      let genreDevenuIndisponible = false;

      navGenre.querySelectorAll<HTMLButtonElement>('button[data-type]').forEach((b) => {
        if (b.dataset.type === 'all') return;
        const disponible = [...items].some(
          (li) => li.dataset.type === b.dataset.type && (role === null || li.dataset.role === role)
        );
        b.disabled = !disponible;
        if (!disponible && b.dataset.type === genre) genreDevenuIndisponible = true;
      });

      if (genreDevenuIndisponible) {
        genre = 'all';
        navGenre.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.type === 'all')));
      }
    }

    navGenre?.addEventListener('click', (event) => {
      const bouton = (event.target as HTMLElement).closest<HTMLButtonElement>('button[data-type]');
      if (!bouton || bouton.disabled) return;
      genre = bouton.dataset.type ?? 'all';
      navGenre.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', String(b === bouton)));
      appliquerFiltres();
    });

    navRole?.addEventListener('click', (event) => {
      const bouton = (event.target as HTMLElement).closest<HTMLButtonElement>('button[data-role]');
      if (!bouton) return;
      role = bouton.dataset.role ?? null;
      navRole.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', String(b === bouton)));
      majDisponibiliteGenres();
      appliquerFiltres();
    });

    majPremierVisible();
  }

  document.addEventListener('astro:page-load', setupFiltres);
</script>
