---
import Layout from "../layouts/Layout.astro";

const titre = "À propos — Alexandre Berger, réalisateur freelance";
const description = "Alexandre Berger, réalisateur freelance en Île-de-France : parcours, démarche et champs d'expertise en documentaire, fiction et film de marque.";
---

<Layout title={titre} description={description} currentPath="/a-propos">
  <div class="contenu">
    <h1>À propos</h1>
    <p>À rédiger.</p>
  </div>
</Layout>

<style>
  .contenu { text-align:left; width:100%; max-width:640px; margin-top:3.5rem; font-weight:300; font-size:1.1rem; color:rgba(255,255,255,.72); }
  .contenu h1 { font-weight:300; font-size:clamp(1.6rem, 3vw, 2.4rem); margin:0 0 1.25rem; color:#fff; }
</style>
