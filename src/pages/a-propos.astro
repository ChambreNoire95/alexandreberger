---
export const prerender = true;
import Layout from "../layouts/Layout.astro";

const titre = "À propos — Alexandre Berger, réalisateur freelance";
const description = "Alexandre Berger, réalisateur freelance en Île-de-France : parcours, démarche et champs d'expertise en documentaire, fiction et film de marque.";
---

<Layout title={titre} description={description} currentPath="/a-propos">
  <h1 class="titre-page">À propos</h1>
  <div class="contenu">
    <p>Réalisateur basé en Île-de-France, je navigue entre documentaire, film de marque et récit institutionnel, du brief à la livraison : écriture, production, réalisation, montage. Ce travail m'a amené à tourner en France, en Europe, en Afrique australe et au Japon, seul ou au sein d'équipes de production plus importantes.</p>
  </div>
</Layout>

<style>
  .contenu { text-align:left; width:100%; max-width:640px; margin-top:0; font-weight:300; font-size:1.1rem; color:rgba(255,255,255,.72); }
</style>
