---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { geocoder } from "../lib/geocode";

const candidats = await getCollection(
  "projets",
  ({ data }) => !!data.lieu || (data.latitude != null && data.longitude != null)
);

const lieux = new Map();
for (const p of candidats) {
  const coords =
    p.data.latitude != null && p.data.longitude != null
      ? { lat: p.data.latitude, lng: p.data.longitude }
      : p.data.lieu
        ? await geocoder(p.data.lieu)
        : null;

  if (!coords) continue;

  const cle = `${coords.lat},${coords.lng}`;
  if (!lieux.has(cle)) {
    lieux.set(cle, { lat: coords.lat, lng: coords.lng, nom: p.data.lieu, projets: [] });
  }
  lieux.get(cle).projets.push({ id: p.id, titre: p.data.titre });
}
const points = Array.from(lieux.values());

const titre = "Autour du monde — Alexandre Berger, réalisateur";
const description = "La carte des tournages d'Alexandre Berger, réalisateur freelance en Île-de-France : documentaire, fiction et film de marque, en France et à l'étranger.";
---

<Layout title={titre} description={description} currentPath="/autour-du-monde">
  <p class="carte-intro">Les points rouges marquent les lieux de tournage. Cliquez dessus pour découvrir le(s) projet(s).</p>
  {points.length > 0 ? (
    <div id="carte-monde" class="carte" data-points={JSON.stringify(points)}></div>
  ) : (
    <p class="carte-vide">Aucun lieu de tournage n'est encore renseigné.</p>
  )}
</Layout>

<script>
  import L from "leaflet";
  import "leaflet/dist/leaflet.css";

  let carteActuelle: L.Map | null = null;

  function initCarte() {
    if (carteActuelle) {
      carteActuelle.remove();
      carteActuelle = null;
    }

    const el = document.getElementById("carte-monde");
    if (!el) return;

    const points = JSON.parse(el.dataset.points ?? "[]");

    const map = L.map(el, {
      worldCopyJump: true,
      minZoom: 1,
      maxZoom: 6,
      zoomControl: true,
      attributionControl: true,
    }).setView([20, 10], 2);
    carteActuelle = map;

    map.attributionControl.setPrefix('<a href="https://leafletjs.com">Leaflet</a>');
    map.attributionControl.addAttribution('Géocodage <a href="https://www.openstreetmap.org/copyright">© OpenStreetMap</a>');

    const markers = points.map((point) => {
      const marker = L.circleMarker([point.lat, point.lng], {
        radius: 8,
        color: "#e11d2e",
        fillColor: "#e11d2e",
        fillOpacity: 0.9,
        weight: 0,
      }).addTo(map);

      const items = point.projets
        .map((p) => `<li><a href="/projets/${p.id}">${p.titre}</a></li>`)
        .join("");
      const nomLieu = point.nom ? `<p class="popup-lieu">${point.nom}</p>` : "";
      marker.bindPopup(`<div class="popup-carte">${nomLieu}<ul class="popup-liste">${items}</ul></div>`, {
        maxHeight: 260,
      });
      return marker;
    });

    fetch("/world.geo.json")
      .then((r) => r.json())
      .then((geo) => {
        L.geoJSON(geo, {
          style: { color: "#ffffff", weight: 1, fillOpacity: 0 },
        }).addTo(map);
        markers.forEach((marker) => marker.bringToFront());
      });
  }

  // astro:page-load se déclenche au chargement initial ET après chaque
  // navigation par transition — contrairement au corps du script, qui ne
  // s'exécute qu'une fois par session puisque la page ne recharge pas.
  document.addEventListener("astro:page-load", initCarte);

  // Le conteneur n'est pas persisté entre les pages : sans ça, la carte
  // et ses écouteurs (resize, etc.) resteraient accrochés à un <div>
  // déjà retiré du DOM après avoir quitté la page.
  document.addEventListener("astro:before-swap", () => {
    if (carteActuelle) {
      carteActuelle.remove();
      carteActuelle = null;
    }
  });
</script>

<style>
  .carte-intro {
    margin:3.5rem 0 2rem;
    font-weight:300; font-size:.85rem; color:rgba(255,255,255,.65); text-align:center;
    white-space:nowrap;
  }
  @media (max-width: 700px) {
    .carte-intro { white-space:normal; max-width:32rem; margin-left:auto; margin-right:auto; }
  }
  .carte {
    width:100%; max-width:1100px; height:min(60vh, 560px);
    border:1px solid rgba(255,255,255,.14); background:#0b0b0b;
  }
  .carte-vide {
    margin-top:1rem; font-weight:300; font-size:.95rem; color:rgba(255,255,255,.5);
  }
</style>

<style is:global>
  .leaflet-container { background:#0b0b0b; font-family:'Inter', sans-serif; }
  .leaflet-control-zoom a {
    background:#0b0b0b !important; color:#fff !important; border-color:rgba(255,255,255,.3) !important;
  }
  .leaflet-control-zoom a:hover { background:#1a1a1a !important; }
  .leaflet-control-attribution {
    background:rgba(11,11,11,.75) !important; color:rgba(255,255,255,.5) !important;
  }
  .leaflet-control-attribution a { color:rgba(255,255,255,.7) !important; }
  .leaflet-container .leaflet-popup-content-wrapper,
  .leaflet-container .leaflet-popup-tip {
    background:#0b0b0b !important; color:#fff !important; border:1px solid rgba(255,255,255,.2);
    border-radius:2px; box-shadow:none;
  }
  .leaflet-container .leaflet-popup-content { margin:.9rem 1rem; }
  .leaflet-container .leaflet-popup-close-button { color:rgba(255,255,255,.5) !important; }
  .leaflet-container .popup-carte { font-family:'Inter', sans-serif; }
  .leaflet-container .popup-lieu {
    margin:0 0 .5rem; font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size:.65rem; letter-spacing:.12em; text-transform:uppercase; color:rgba(255,255,255,.5);
  }
  .leaflet-container .popup-liste { list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:.5rem; }
  .leaflet-container .popup-liste li + li { padding-top:.5rem; border-top:1px solid rgba(255,255,255,.14); }
  .leaflet-container .popup-carte a {
    font-weight:300; font-size:.95rem; color:#fff !important; text-decoration:none; transition:opacity 140ms ease;
  }
  .leaflet-container .popup-carte a:hover { opacity:.7; }
</style>
